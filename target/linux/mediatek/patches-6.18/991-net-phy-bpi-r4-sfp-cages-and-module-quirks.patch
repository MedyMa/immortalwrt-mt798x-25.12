+static inline const char *mdio_i2c_proto_type(int type)
+{
+	switch (type) {
+	case MDIO_I2C_NONE:
+		return "MDIO_I2C_NONE";
+	case MDIO_I2C_MARVELL_C22:
+		return "MDIO_I2C_MARVELL_C22";
+	case MDIO_I2C_C45:
+		return "MDIO_I2C_C45";
+	case MDIO_I2C_ROLLBALL:
+		return "MDIO_I2C_ROLLBALL";
+	default:
+		return "UNKNOWN";
+	}
+}
