+/* SPDX-License-Identifier: GPL-2.0
+ *
+ * Copyright (c) 2022 MediaTek Inc.
+ * Author: Henry Yen <henry.yen@mediatek.com>
+ */
+
+#include <linux/regmap.h>
+#include "mtk_eth_soc.h"
+#include "mtk_eth_reset.h"
+
+extern struct mtk_eth *g_eth;
+
+static int mtk_rest_cnt;
+int mtk_wifi_num;
+u32 mtk_reset_flag = MTK_FE_START_RESET;
+bool mtk_stop_fail;
+
+DECLARE_COMPLETION(wait_ack_done);
+DECLARE_COMPLETION(wait_ser_done);
+DECLARE_COMPLETION(wait_tops_done);
+
+bool (*mtk_check_wifi_busy)(u32 wdma_idx) = NULL;
+EXPORT_SYMBOL(mtk_check_wifi_busy);
+
+void mtk_set_pse_drop(u32 config)
+{
+	struct mtk_eth *eth = g_eth;
+
+	if (!eth || mtk_is_netsys_v1(eth))
+		return;
+
+	mtk_w32(eth, config, PSE_PPE_DROP(0));
+	if (MTK_HAS_CAPS(eth->soc->caps, MTK_RSTCTRL_PPE1))
+		mtk_w32(eth, config, PSE_PPE_DROP(1));
+	if (MTK_HAS_CAPS(eth->soc->caps, MTK_RSTCTRL_PPE2))
+		mtk_w32(eth, config, PSE_PPE_DROP(2));
+}
+EXPORT_SYMBOL(mtk_set_pse_drop);
+
+/* Serialize the final queue operation with teardown, including atomic TX
+ * timeout producers that cannot be drained through the notifier chain.
+ */
+void mtk_eth_queue_reset(struct mtk_eth *eth)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&eth->reset.lock, flags);
+	if (!test_bit(MTK_STOPPING, &eth->state) &&
+	    !test_bit(MTK_RESETTING, &eth->state))
+		schedule_work(&eth->pending_work);
+	spin_unlock_irqrestore(&eth->reset.lock, flags);
+}
+
+bool mtk_eth_reset_stop(struct mtk_eth *eth)
+{
+	unsigned long flags;
+	bool stopping;
+
+	spin_lock_irqsave(&eth->reset.lock, flags);
+	stopping = test_and_set_bit(MTK_STOPPING, &eth->state);
+	spin_unlock_irqrestore(&eth->reset.lock, flags);
+	return stopping;
+}
+
+/* The notifier and its callers serialize reset phase changes with RTNL. */
+void mtk_eth_reset_prepare(struct mtk_eth *eth, u8 phase)
+{
+	ASSERT_RTNL();
+	eth->reset.wait_phase = phase;
+	mtk_rest_cnt = mtk_wifi_num;
+	if (phase == MTK_WIFI_WAIT_FINISH)
+		reinit_completion(&wait_ack_done);
+	else {
+		reinit_completion(&wait_ser_done);
+		mtk_stop_fail = false;
+	}
+}
+
+int mtk_eth_netdevice_event(struct notifier_block *n, unsigned long event, void *ptr)
+{
+	struct mtk_eth *eth = container_of(n, struct mtk_eth, reset.netdevice_notifier);
+
+	switch (event) {
+	case MTK_TOPS_ONLINE:
+		WRITE_ONCE(eth->reset.npu_present, true);
+		break;
+	case MTK_TOPS_OFFLINE:
+		WRITE_ONCE(eth->reset.npu_present, false);
+		break;
+	case MTK_TOPS_RESET_FAILED:
+		if (eth->reset.npu_waiting)
+			WRITE_ONCE(eth->reset.npu_failed, true);
+		break;
+	case MTK_TOPS_DUMP_DONE:
+		if (eth->reset.npu_waiting)
+			complete(&wait_tops_done);
+		break;
+	case MTK_WIFI_RESET_DONE:
+	case MTK_FE_STOP_TRAFFIC_DONE:
+		if ((event == MTK_WIFI_RESET_DONE &&
+		     eth->reset.wait_phase != MTK_WIFI_WAIT_RESET) ||
+		    (event == MTK_FE_STOP_TRAFFIC_DONE &&
+		     eth->reset.wait_phase != MTK_WIFI_WAIT_STOP) ||
+		    mtk_rest_cnt <= 0)
+			break;
+		pr_info("%s rcv done event:%lx\n", __func__, event);
+		if (!--mtk_rest_cnt)
+			complete(&wait_ser_done);
+		break;
+	case MTK_WIFI_CHIP_ONLINE:
+		mtk_wifi_num++;
+		break;
+	case MTK_WIFI_CHIP_OFFLINE:
+		if (mtk_wifi_num > 0)
+			mtk_wifi_num--;
+		/* Do not mistake unregistering a client for a DMA-stop ACK. */
+		break;
+	case MTK_FE_STOP_TRAFFIC_DONE_FAIL:
+		if (eth->reset.wait_phase != MTK_WIFI_WAIT_STOP)
+			break;
+		mtk_stop_fail = true;
+		mtk_reset_flag = MTK_FE_START_RESET;
+		pr_info("%s rcv done event:%lx\n", __func__, event);
+		complete(&wait_ser_done);
+		break;
+	case MTK_FE_START_RESET_INIT:
+		pr_info("%s rcv fe start reset init event:%lx\n", __func__, event);
+		if (!test_bit(MTK_RESETTING, &eth->state) &&
+		    !test_bit(MTK_STOPPING, &eth->state)) {
+			mtk_reset_flag = MTK_FE_START_RESET;
+			mtk_eth_queue_reset(eth);
+		}
+		break;
+	case MTK_WIFI_L1SER_DONE:
+		if (eth->reset.wait_phase != MTK_WIFI_WAIT_FINISH ||
+		    mtk_rest_cnt <= 0)
+			break;
+		pr_info("%s rcv wifi done ack :%lx\n", __func__, event);
+		if (!--mtk_rest_cnt)
+			complete(&wait_ack_done);
+		break;
+	default:
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+int mtk_eth_netdevice_event_init(struct mtk_eth *eth)
+{
+	int ret;
+
+	eth->reset.netdevice_notifier.notifier_call = mtk_eth_netdevice_event;
+	ret = register_netdevice_notifier(&eth->reset.netdevice_notifier);
+	if (ret)
+		return ret;
+
+	eth->reset.notifier_registered = true;
+	return 0;
+}
+
+void mtk_eth_netdevice_event_deinit(struct mtk_eth *eth)
+{
+	if (eth->reset.notifier_registered) {
+		unregister_netdevice_notifier(&eth->reset.netdevice_notifier);
+		eth->reset.notifier_registered = false;
+	}
+}
