+	if (buf[0] == '0') {
+		pr_info("Keep DSCP mode is going to be disabled !\n");
+		eth->dscp_toggle = 0;
+	} else if (buf[0] == '1') {
+		pr_info("Keep DSCP mode is going to be enabled !\n");
+		eth->dscp_toggle = 1;
+	}
+
+	return len;
