+
+	if (!hnat_get_count(h, ppe_index, hash_index, &diff))
+		return HNAT_FAIL;
+
+	*pkt_cnt = diff.packets;
+	*byte_cnt = diff.bytes;
+
+	return HNAT_SUCCESS;
