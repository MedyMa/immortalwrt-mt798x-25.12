+static int mtk_get_wdma_tx_port(u32 wdma_idx)
+{
+	if (wdma_idx == 0 || wdma_idx == 1 || wdma_idx == 2)
+		return NR_PPE0_PORT;
+
+	return -EINVAL;
+}
+
+static int mtk_get_wdma_rx_port(u32 wdma_idx)
+{
+	if (wdma_idx == 2)
+		return NR_WDMA2_PORT;
+	else if (wdma_idx == 1)
+		return NR_WDMA1_PORT;
+	else if (wdma_idx == 0)
+		return NR_WDMA0_PORT;
+
+	return -EINVAL;
+}
+
+static int mtk_set_wdma_pse_port_state_body(u32 wdma_idx, bool up)
+{
+        int port;
+        port = mtk_get_wdma_rx_port(wdma_idx);
+        if (port < 0)
+                return -EINVAL;
+        cr_set_field(hnat_priv->fe_base + MTK_FE_GLO_CFG(port),
+                     MTK_FE_LINK_DOWN1((u32)port), !up);
+        return 0;
+}
+
+static int mtk_set_wdma_pse_port_state(u32 wdma_idx, bool up)
+{
+	int ret;
+
+	if (!hnat_external_callback_enter())
+		return -ENODEV;
+	ret = hnat_priv->data->whnat ?
+		mtk_set_wdma_pse_port_state_body(wdma_idx, up) : -ENODEV;
+	hnat_external_callback_exit();
+	return ret;
+}
+
+void set_gmac_ppe_fwd(int id, int enable)
+{
+	void __iomem *reg;
+	u32 val;
+
+	reg = hnat_priv->fe_base +
+		((id == NR_GMAC1_PORT) ? GDMA1_FWD_CFG :
+		 (id == NR_GMAC2_PORT) ? GDMA2_FWD_CFG : GDMA3_FWD_CFG);
+
+	if (enable) {
+#if defined(CONFIG_MEDIATEK_NETSYS_V2) || defined(CONFIG_MEDIATEK_NETSYS_V3)
+		if (CFG_PPE_NUM >= 3 && id == NR_GMAC3_PORT)
+			cr_set_bits(reg, BITS_GDM_ALL_FRC_P_PPE2);
+		else if (CFG_PPE_NUM >= 2 && id == NR_GMAC2_PORT)
+			cr_set_bits(reg, BITS_GDM_ALL_FRC_P_PPE1);
+		else
+			cr_set_bits(reg, BITS_GDM_ALL_FRC_P_PPE);
+#else
+		cr_set_bits(reg, BITS_GDM_ALL_FRC_P_PPE);
+#endif
+		return;
+	}
+
+	/*disabled */
+	val = readl(reg);
+#if defined(CONFIG_MEDIATEK_NETSYS_V2) || defined(CONFIG_MEDIATEK_NETSYS_V3)
+	if ((CFG_PPE_NUM >= 2 &&
+	    ((val & GDM_ALL_FRC_MASK) == BITS_GDM_ALL_FRC_P_PPE1 ||
+	     (val & GDM_ALL_FRC_MASK) == BITS_GDM_ALL_FRC_P_PPE2)))
+		cr_set_field(reg, GDM_ALL_FRC_MASK,
+			     BITS_GDM_ALL_FRC_P_CPU_PDMA);
+#endif
+
+	if ((val & GDM_ALL_FRC_MASK) == BITS_GDM_ALL_FRC_P_PPE)
+		cr_set_field(reg, GDM_ALL_FRC_MASK,
+				 BITS_GDM_ALL_FRC_P_CPU_PDMA);
+
+}
+
+static int entry_mac_cmp(struct foe_entry *entry, u8 *mac)
+{
+	int ret = 0;
+
+	if(IS_IPV4_GRP(entry)) {
+		if(((swab32(entry->ipv4_hnapt.dmac_hi) == *(u32 *)mac) &&
+			(swab16(entry->ipv4_hnapt.dmac_lo) == *(u16 *)&mac[4])) ||
+			((swab32(entry->ipv4_hnapt.smac_hi) == *(u32 *)mac) &&
+			(swab16(entry->ipv4_hnapt.smac_lo) == *(u16 *)&mac[4])))
+			ret = 1;
+	} else {
+		if(((swab32(entry->ipv6_5t_route.dmac_hi) == *(u32 *)mac) &&
+			(swab16(entry->ipv6_5t_route.dmac_lo) == *(u16 *)&mac[4])) ||
+			((swab32(entry->ipv6_5t_route.smac_hi) == *(u32 *)mac) &&
+			(swab16(entry->ipv6_5t_route.smac_lo) == *(u16 *)&mac[4])))
+			ret = 1;
+	}
+
+	if (ret && debug_level >= 2)
+		pr_info("mac=%pM\n", mac);
+
+	return ret;
+}
+
+static int entry_delete_by_mac_body(u8 *mac)
+{
+	struct foe_entry *entry = NULL, *match, snapshot;
+	u64 account_generation = 0;
+	int index, i, ret = 0;
+
+	for (i = 0; i < CFG_PPE_NUM; i++) {
+		entry = hnat_priv->foe_table_cpu[i];
+		for (index = 0; index < hnat_priv->foe_etry_num; entry++, index++) {
+			if (hnat_account_enabled(hnat_priv)) {
+				if (!hnat_account_clear_snapshot(hnat_priv, i, index,
+							 &snapshot, &account_generation))
+					continue;
+				match = &snapshot;
+			} else
+				match = entry;
+			if (match->bfib1.state == BIND && entry_mac_cmp(match, mac)) {
+				if (!hnat_account_clear_if_generation(hnat_priv, i, index,
+							      true, account_generation))
+					memset(entry, 0, sizeof(*entry));
+				hnat_cache_ebl(1);
+				if (debug_level >= 2)
+					pr_info("matched entry idx = %d\n", index);
+				ret++;
+			}
+		}
+	}
+
+	if(!ret && debug_level >= 2)
+		pr_info("entry not found\n");
+
+	return ret;
+}
+
+int entry_delete_by_mac(u8 *mac)
+{
+	int ret;
+
+	if (!hnat_external_callback_enter())
+		return 0;
+	ret = entry_delete_by_mac_body(mac);
+	hnat_external_callback_exit();
+	return ret;
+}
+
+static void hnat_roam_recovery_handler(struct work_struct *work)
+{
+	/* This existing path retires accounting owners and tunnel shadows before
+	 * invalidating cached bindings. Its timer restores hardware learning.
+	 */
+	foe_clear_all_bind_entries();
+	atomic64_inc(&hnat_roam_recovery_runs);
+}
+
+static void hnat_roam_recover(void)
+{
+	/* A fixed work item coalesces lost events without another allocation. */
+	atomic64_inc(&hnat_roam_recovery_requests);
+	queue_work(hnat_roam_wq, &hnat_roam_recovery_work);
+}
+
+static void hnat_roam_work_handler(struct work_struct *work)
+{
+	struct hnat_roam_work *roam = container_of(work, struct hnat_roam_work, work);
+	int matched;
+
+	/* Generation fencing may skip a matching slot that has been relearned. */
+	matched = entry_delete_by_mac(roam->mac);
+	if (matched > 0)
+		atomic64_add(matched, &hnat_roam_matches);
+	atomic64_inc(&hnat_roam_completed);
+	atomic_dec(&hnat_roam_pending);
+	kfree(roam);
+}
+
+/* The bridge notifies the old port before changing a learned FDB entry. */
+static int hnat_roam_switchdev_event(struct notifier_block *nb,
+				     unsigned long event, void *ptr)
+{
+	struct switchdev_notifier_fdb_info *fdb_info = ptr;
+	struct hnat_roam_work *roam;
+	struct net_device *dev;
+
+	if (event != SWITCHDEV_FDB_DEL_TO_DEVICE || !fdb_info || !fdb_info->addr)
+		return NOTIFY_DONE;
+
+	dev = switchdev_notifier_info_to_dev(ptr);
+	if (!dev || !net_eq(dev_net(dev), &init_net) ||
+	    netif_is_bridge_master(dev) || fdb_info->is_local ||
+	    !is_valid_ether_addr(fdb_info->addr))
+		return NOTIFY_DONE;
+
+	atomic64_inc(&hnat_roam_events);
+	if (debug_level >= 2)
+		pr_info("hnat: FDB delete mac=%pM port=%s\n", fdb_info->addr, dev->name);
+
+	if (!atomic_add_unless(&hnat_roam_pending, 1, HNAT_ROAM_MAX_PENDING)) {
+		atomic64_inc(&hnat_roam_overflows);
+		hnat_roam_recover();
+		return NOTIFY_DONE;
+	}
+
+	/* The notifier is atomic; own the MAC instead of retaining FDB/dev pointers. */
+	roam = kmalloc(sizeof(*roam), GFP_ATOMIC);
+	if (!roam) {
+		atomic_dec(&hnat_roam_pending);
+		atomic64_inc(&hnat_roam_alloc_failed);
+		hnat_roam_recover();
+		pr_warn_ratelimited("hnat: FDB roaming allocation failed; requesting recovery\n");
+		return NOTIFY_DONE;
+	}
+
+	ether_addr_copy(roam->mac, fdb_info->addr);
+	INIT_WORK(&roam->work, hnat_roam_work_handler);
+	atomic64_inc(&hnat_roam_queued);
+	if (!queue_work(hnat_roam_wq, &roam->work)) {
+		atomic64_dec(&hnat_roam_queued);
+		atomic_dec(&hnat_roam_pending);
+		atomic64_inc(&hnat_roam_queue_failed);
+		kfree(roam);
+		hnat_roam_recover();
+		pr_warn_ratelimited("hnat: FDB roaming work could not be queued; requesting recovery\n");
+	}
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block hnat_roam_switchdev_nb = {
+	.notifier_call = hnat_roam_switchdev_event,
+};
+
+static int hnat_roaming_enable(void)
+{
+	int ret;
+
+	if (hnat_roam_wq)
+		return -EBUSY;
+
+	WRITE_ONCE(hnat_roam_enabled, false);
+	if (!IS_ENABLED(CONFIG_NET_SWITCHDEV)) {
+		ret = -EOPNOTSUPP;
+		goto fail;
+	}
+
+	/* Different work items still serialize their FOE table walks. */
+	hnat_roam_wq = alloc_ordered_workqueue("hnat_roam", 0);
+	if (!hnat_roam_wq) {
+		ret = -ENOMEM;
+		goto fail;
+	}
+
+	INIT_WORK(&hnat_roam_recovery_work, hnat_roam_recovery_handler);
+	ret = register_switchdev_notifier(&hnat_roam_switchdev_nb);
+	if (ret) {
+		destroy_workqueue(hnat_roam_wq);
+		hnat_roam_wq = NULL;
+		goto fail;
+	}
+
+	WRITE_ONCE(hnat_roam_error, 0);
+	WRITE_ONCE(hnat_roam_enabled, true);
+	pr_info("hnat roaming work enable (switchdev FDB)\n");
+
+	return 0;
+fail:
+	WRITE_ONCE(hnat_roam_error, ret);
+	return ret;
+}
+
+static void hnat_roaming_disable(void)
+{
+	if (!hnat_roam_wq)
+		return;
+
+	WRITE_ONCE(hnat_roam_enabled, false);
+	/* Unregister waits for notifier callbacks before the queue is drained. */
+	unregister_switchdev_notifier(&hnat_roam_switchdev_nb);
+	destroy_workqueue(hnat_roam_wq);
+	hnat_roam_wq = NULL;
+	pr_info("hnat roaming work disable\n");
+}
+
+void hnat_roaming_stats(struct seq_file *s)
+{
+	seq_printf(s, "enabled %u\n", READ_ONCE(hnat_roam_enabled));
+	seq_printf(s, "last_error %d\n", READ_ONCE(hnat_roam_error));
+	seq_printf(s, "fdb_events %lld\n", atomic64_read(&hnat_roam_events));
+	seq_printf(s, "queued %lld\n", atomic64_read(&hnat_roam_queued));
+	seq_printf(s, "completed %lld\n", atomic64_read(&hnat_roam_completed));
+	seq_printf(s, "pending %d\n", atomic_read(&hnat_roam_pending));
+	seq_printf(s, "pending_limit %u\n", HNAT_ROAM_MAX_PENDING);
+	seq_printf(s, "overflow_events %lld\n", atomic64_read(&hnat_roam_overflows));
+	seq_printf(s, "recovery_requests %lld\n", atomic64_read(&hnat_roam_recovery_requests));
+	seq_printf(s, "recovery_work_runs %lld\n", atomic64_read(&hnat_roam_recovery_runs));
+	seq_printf(s, "allocation_failures %lld\n", atomic64_read(&hnat_roam_alloc_failed));
+	seq_printf(s, "queue_failures %lld\n", atomic64_read(&hnat_roam_queue_failed));
+	seq_printf(s, "matched_entries %lld\n", atomic64_read(&hnat_roam_matches));
+}
