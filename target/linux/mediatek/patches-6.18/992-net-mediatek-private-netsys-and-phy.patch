--- /dev/null
+++ b/drivers/net/phy/aquantia/aquantia_mib.c
@@ -0,0 +1,216 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Packet counter driver for Aquantia PHY
+ */
+
+#include <linux/phy.h>
+#include <linux/kernel.h>
+#include <linux/debugfs.h>
+#include <linux/kthread.h>
+
+#include "aquantia.h"
+
+#define MDIO_PCS_LS_TX_GOOD_COUNTER		0xc820
+#define MDIO_PCS_LS_TX_BAD_COUNTER		0xc822
+#define MDIO_PCS_SS_TX_GOOD_COUNTER		0xc860
+#define MDIO_PCS_SS_TX_BAD_COUNTER		0xc862
+#define MDIO_PCS_CRC8_ERROR_COUNTER		0xe810
+#define MDIO_PCS_LS_RX_GOOD_COUNTER		0xe812
+#define MDIO_PCS_LS_RX_BAD_COUNTER		0xe814
+#define MDIO_PCS_LDPC_ERROR_COUNTER		0xe820
+#define MDIO_PCS_SS_RX_GOOD_COUNTER		0xe860
+#define MDIO_PCS_SS_RX_BAD_COUNTER		0xe862
+
+static int aqr107_mib_read_word(struct phy_device *phydev, u32 reg, u16 *lsw, u16 *msw)
+{
+	int val;
+
+	val = phy_read_mmd(phydev, MDIO_MMD_PCS, reg + 1);
+	if (val < 0)
+		return val;
+
+	*msw = val;
+
+	val = phy_read_mmd(phydev, MDIO_MMD_PCS, reg);
+	if (val < 0)
+		return val;
+
+	*lsw = val;
+
+	return 0;
+}
+
+static void aqr107_mib_read(struct phy_device *phydev)
+{
+	struct aqr107_priv *priv = phydev->priv;
+	u16 lsw, msw;
+
+	if (!aqr107_mib_read_word(phydev, MDIO_PCS_CRC8_ERROR_COUNTER, &lsw, &msw))
+		priv->mib.crc8_error_packets += (((u32)msw << 16) | lsw);
+
+	if (!aqr107_mib_read_word(phydev, MDIO_PCS_LDPC_ERROR_COUNTER, &lsw, &msw))
+		priv->mib.ldpc_error_packets += (((u32)msw << 16) | lsw);
+
+	if (!aqr107_mib_read_word(phydev, MDIO_PCS_LS_TX_GOOD_COUNTER, &lsw, &msw))
+		priv->mib.ls_tx_good_packets += (((u32)msw << 16) | lsw);
+
+	if (!aqr107_mib_read_word(phydev, MDIO_PCS_LS_TX_BAD_COUNTER, &lsw, &msw))
+		priv->mib.ls_tx_bad_packets += (((u32)msw << 16) | lsw);
+
+	if (!aqr107_mib_read_word(phydev, MDIO_PCS_LS_RX_GOOD_COUNTER, &lsw, &msw))
+		priv->mib.ls_rx_good_packets += (((u32)msw << 16) | lsw);
+
+	if (!aqr107_mib_read_word(phydev, MDIO_PCS_LS_RX_BAD_COUNTER, &lsw, &msw))
+		priv->mib.ls_rx_bad_packets += (((u32)msw << 16) | lsw);
+
+	if (!aqr107_mib_read_word(phydev, MDIO_PCS_SS_TX_GOOD_COUNTER, &lsw, &msw))
+		priv->mib.ss_tx_good_packets += (((u32)msw << 16) | lsw);
+
+	if (!aqr107_mib_read_word(phydev, MDIO_PCS_SS_TX_BAD_COUNTER, &lsw, &msw))
+		priv->mib.ss_tx_bad_packets += (((u32)msw << 16) | lsw);
+
+	if (!aqr107_mib_read_word(phydev, MDIO_PCS_SS_RX_GOOD_COUNTER, &lsw, &msw))
+		priv->mib.ss_rx_good_packets += (((u32)msw << 16) | lsw);
+
+	if (!aqr107_mib_read_word(phydev, MDIO_PCS_SS_RX_BAD_COUNTER, &lsw, &msw))
+		priv->mib.ss_rx_bad_packets += (((u32)msw << 16) | lsw);
+}
+
+static int aqr107_mib_thread(void *data)
+{
+	struct phy_device *phydev = data;
+	struct aqr107_priv *priv = phydev->priv;
+
+	for (;;) {
+		if (kthread_should_stop())
+			break;
+
+		mutex_lock(&priv->mib_lock);
+		aqr107_mib_read(phydev);
+		mutex_unlock(&priv->mib_lock);
+
+		set_current_state(TASK_INTERRUPTIBLE);
+		schedule_timeout(HZ);
+	}
+
+	return 0;
+}
+
+static int aqr107_mib_show(struct seq_file *m, void *private)
+{
+	struct phy_device *phydev = m->private;
+	struct aqr107_priv *priv = phydev->priv;
+	struct aqr107_mib_stat mib;
+
+	mutex_lock(&priv->mib_lock);
+	aqr107_mib_read(phydev);
+	mib = priv->mib;
+	memset(&priv->mib, 0, sizeof(priv->mib));
+	mutex_unlock(&priv->mib_lock);
+
+	seq_printf(m, "+---------------------------------+\n");
+	seq_printf(m, "|         <<AQUANTIA MIB>>        |\n");
+	seq_printf(m, "| CRC8 Error Packets=%012llu |\n", mib.crc8_error_packets);
+	seq_printf(m, "| LDPC Error Packets=%012llu |\n", mib.ldpc_error_packets);
+	seq_printf(m, "|           [Line Side]\n");
+	seq_printf(m, "| TX   Good  Packets=%012llu |\n", mib.ls_tx_good_packets);
+	seq_printf(m, "| TX   Bad   Packets=%012llu |\n", mib.ls_tx_bad_packets);
+	seq_printf(m, "| RX   Good  Packets=%012llu |\n", mib.ls_rx_good_packets);
+	seq_printf(m, "| RX   Bad   Packets=%012llu |\n", mib.ls_rx_bad_packets);
+	seq_printf(m, "|          [System Side]\n");
+	seq_printf(m, "| TX   Good  Packets=%012llu |\n", mib.ss_tx_good_packets);
+	seq_printf(m, "| TX   Bad   Packets=%012llu |\n", mib.ss_tx_bad_packets);
+	seq_printf(m, "| RX   Good  Packets=%012llu |\n", mib.ss_rx_good_packets);
+	seq_printf(m, "| RX   Bad   Packets=%012llu |\n", mib.ss_rx_bad_packets);
+	seq_printf(m, "+---------------------------------+\n");
+
+	return 0;
+}
+
+static int aqr107_mib_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, aqr107_mib_show, inode->i_private);
+}
+
+static const struct file_operations fops_mib = {
+	.owner = THIS_MODULE,
+	.open = aqr107_mib_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release
+};
+
+int aqr_mib_probe(struct phy_device *phydev)
+{
+	struct aqr107_priv *priv = phydev->priv;
+	struct dentry *root;
+	const char *dirname = dev_name(&phydev->mdio.dev);
+	bool dput_needed = false;
+	int ret = 0;
+
+	mutex_init(&priv->mib_lock);
+
+
+	root = debugfs_lookup("aquantia", NULL);
+	if (!IS_ERR_OR_NULL(root)) {
+		/* a dentry from lookup() needs dput() after we don't use it */
+		dput_needed = true;
+	} else {
+		root = debugfs_create_dir("aquantia", NULL);
+		if (IS_ERR_OR_NULL(root))
+			return 0; /* Optional statistics must not reject a PHY. */
+	}
+
+	priv->mib_file = debugfs_create_file(dirname, 0444, root, phydev,
+					     &fops_mib);
+	if (IS_ERR(priv->mib_file)) {
+		ret = PTR_ERR(priv->mib_file);
+		phydev_warn(phydev, "statistics file %s unavailable (%d)\n",
+			   dirname, ret);
+		priv->mib_file = NULL;
+		goto out;
+	}
+
+	/* create a thread for recording packet counts */
+	priv->mib_thread = kthread_create(aqr107_mib_thread,
+					  phydev,
+					  "aqr107_mib_thread");
+	if (IS_ERR(priv->mib_thread)) {
+		ret = PTR_ERR(priv->mib_thread);
+		phydev_warn(phydev,
+			   "statistics thread unavailable (%d)\n",
+			   ret);
+		priv->mib_thread = NULL;
+		debugfs_remove(priv->mib_file);
+		priv->mib_file = NULL;
+		goto out;
+	}
+	wake_up_process(priv->mib_thread);
+
+out:
+	if (dput_needed)
+		dput(root);
+
+	return 0; /* MIB diagnostics do not control PHY availability. */
+}
+
+void aqr_mib_remove(struct phy_device *phydev)
+{
+	struct aqr107_priv *priv = phydev->priv;
+
+	if (!priv)
+		return;
+
+	/* Remove the debugfs file first: debugfs_remove() waits for readers
+	 * already inside aqr107_mib_show() to leave, so nothing can touch
+	 * priv->mib or priv->mib_lock afterwards.
+	 */
+	debugfs_remove(priv->mib_file);
+	priv->mib_file = NULL;
+
+	if (priv->mib_thread) {
+		kthread_stop(priv->mib_thread);
+		priv->mib_thread = NULL;
+	}
+
+	mutex_destroy(&priv->mib_lock);
+}
