+
+struct hnat_accounting *hnat_get_count(struct mtk_hnat *h, u32 ppe_id,
+				       u32 index, struct hnat_accounting *diff)
+
+{
+	u64 bytes, packets;
+
+	if (hnat_account_enabled(h)) {
+		if (hnat_account_drain(h, ppe_id, index, NULL, diff))
+			return NULL;
+		return &h->acct[ppe_id][index]; /* legacy pointer ABI, not a snapshot */
+	}
+	if (!h || !h->data || ppe_id >= MAX_PPE_NUM ||
+	    ppe_id >= h->ppe_num || index >= h->foe_etry_num ||
+	    !h->acct[ppe_id] || !h->ppe_base[ppe_id])
+		return NULL;
+
+	if (ppe_id >= CFG_PPE_NUM)
+		return NULL;
+
+	if (index >= hnat_priv->foe_etry_num)
+		return NULL;
+
+	if (!hnat_priv->data->per_flow_accounting)
+		return NULL;
+
+	spin_lock_bh(&hnat_mib_lock[ppe_id]);
+	if (read_mib(h, ppe_id, index, &bytes, &packets)) {
+		spin_unlock_bh(&hnat_mib_lock[ppe_id]);
+		return NULL;
+	}
+
+	h->acct[ppe_id][index].bytes += bytes;
+	h->acct[ppe_id][index].packets += packets;
+	spin_unlock_bh(&hnat_mib_lock[ppe_id]);
+
+	if (diff) {
+		diff->bytes = bytes;
+		diff->packets = packets;
+	}
+
+	return &h->acct[ppe_id][index];
+}
+EXPORT_SYMBOL(hnat_get_count);
+
+#define PRINT_COUNT(m, acct) {if (acct) \
+		seq_printf(m, "bytes=%llu|packets=%llu|", \
+			   acct->bytes, acct->packets); }
