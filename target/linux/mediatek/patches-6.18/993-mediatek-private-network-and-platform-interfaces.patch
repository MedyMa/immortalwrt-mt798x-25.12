+#if IS_ENABLED(CONFIG_NET_MEDIATEK_NPU_FLOW)
+static int pppol2tp_2410_fill_forward_path(struct net_device_path_ctx *ctx,
+				     struct net_device_path *path,
+				     const struct ppp_channel *chan)
+{
+	struct sock *sk = chan->private;
+	struct ppp_tunnel_info info;
+	struct l2tp_session *session;
+	struct inet_sock *inet;
+	struct sock *transport;
+	struct flowi4 fl4;
+	struct rtable *rt;
+	int ret;
+
+	if (!mtk_npu_flow_supported(DEV_PATH_L2TP))
+		return -EOPNOTSUPP;
+	ret = pppol2tp_get_tunnel_info((struct ppp_channel *)chan, &info);
+	if (ret)
+		return ret;
+	/* Generic PPP holds its unit/downl locks over this callback. */
+	session = READ_ONCE(sk->sk_user_data);
+	transport = session->tunnel->sock;
+	if (!transport || transport->sk_family != AF_INET)
+		return -EOPNOTSUPP;
+	inet = inet_sk(transport);
+	flowi4_init_output(&fl4, transport->sk_bound_dev_if, transport->sk_mark,
+			   RT_TOS(inet->tos), RT_SCOPE_UNIVERSE, IPPROTO_UDP, 0,
+			   inet->inet_daddr, inet->inet_saddr, inet->inet_dport,
+			   inet->inet_sport, sock_net_uid(sock_net(transport), transport));
+	security_sk_classify_flow(transport, flowi4_to_flowi_common(&fl4));
+	rt = ip_route_output_flow(sock_net(transport), &fl4, transport);
+	if (IS_ERR(rt))
+		return PTR_ERR(rt);
+	ret = mtk_npu_flow_neigh(&rt->dst, fl4.daddr, path);
+	if (!ret) {
+		path->type = DEV_PATH_L2TP;
+		path->dev = ctx->dev;
+		path->tunnel_2410.sip.ip = fl4.saddr;
+		path->tunnel_2410.dip.ip = fl4.daddr;
+		path->tunnel_2410.sport = inet->inet_sport;
+		path->tunnel_2410.dport = inet->inet_dport;
+		path->tunnel_2410.ttl = inet->uc_ttl < 0 ?
+			ip4_dst_hoplimit(&rt->dst) : inet->uc_ttl;
+		path->tunnel_2410.tos = inet->tos;
+		path->tunnel_2410.l2tp.dl_tid = htons(info.tunnel_id);
+		path->tunnel_2410.l2tp.ul_tid = htons(info.peer_tunnel_id);
+		path->tunnel_2410.l2tp.dl_sid = htons(info.session_id);
+		path->tunnel_2410.l2tp.ul_sid = htons(info.peer_session_id);
+		ctx->dev = rt->dst.dev;
+	}
+	ip_rt_put(rt);
+	return ret;
+}
+#endif
 
