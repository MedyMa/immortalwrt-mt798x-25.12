+		       opt->src_addr.sin_addr.s_addr == key->local_addr &&
+		       opt->dst_addr.sin_addr.s_addr == key->peer_addr &&
+		       opt->src_addr.call_id == key->local_id &&
+		       opt->dst_addr.call_id == key->peer_id;
+	}
+	spin_unlock_irqrestore(&chan_lock, flags);
+	return live;
+}
+EXPORT_SYMBOL_GPL(pptp_offload_session_live);
+
+static void pptp_offload_key(struct pppox_sock *po, struct pptp_offload_key *key)
+{
+	struct pptp_opt *opt = &po->proto.pptp;
+
+	memset(key, 0, sizeof(*key));
+	key->cookie = opt->offload_cookie;
+	key->netns = sock_net(sk_pppox(po))->ns.inum;
+	key->local_addr = opt->src_addr.sin_addr.s_addr;
+	key->peer_addr = opt->dst_addr.sin_addr.s_addr;
+	key->local_id = opt->src_addr.call_id;
+	key->peer_id = opt->dst_addr.call_id;
+}
+
+int pptp_offload_ops_register(const struct pptp_offload_ops *ops)
+{
+	int ret = 0;
+
+	if (!ops || !ops->next || !ops->snapshot || !ops->close)
+		return -EINVAL;
+	mutex_lock(&pptp_offload_admin);
+	if (rcu_access_pointer(pptp_offload_ops))
+		ret = -EBUSY;
+	else
+		rcu_assign_pointer(pptp_offload_ops, ops);
+	mutex_unlock(&pptp_offload_admin);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(pptp_offload_ops_register);
+
+/* The provider must stop hardware sequence consumers before unregistering.
+ * Keep dispatch published through handover: a software transmitter admitted
+ * after its socket was visited still updates seq_sent from the provider.
+ */
+int pptp_offload_ops_unregister(const struct pptp_offload_ops *ops)
+{
+	struct pptp_offload_key key;
+	struct pppox_sock *po;
+	unsigned long flags;
+	u32 seq;
+	unsigned int id;
+	int ret = 0;
+
+	if (!ops)
+		return -EINVAL;
+	mutex_lock(&pptp_offload_admin);
+	if (rcu_access_pointer(pptp_offload_ops) != ops) {
+		ret = -ENOENT;
+		goto out;
+	}
+	for (id = 0; id <= MAX_CALLID; id++) {
+		rcu_read_lock();
+		po = rcu_dereference(callid_sock[id]);
+		if (po) {
+			spin_lock_irqsave(&po->proto.pptp.offload_lock, flags);
+			pptp_offload_key(po, &key);
+			if (!ops->snapshot(&key, &seq))
+				po->proto.pptp.seq_sent = seq;
+			spin_unlock_irqrestore(&po->proto.pptp.offload_lock, flags);
+		}
+		rcu_read_unlock();
+		if (!(id & 127))
+			cond_resched();
+	}
+	rcu_assign_pointer(pptp_offload_ops, NULL);
+	synchronize_srcu(&pptp_offload_srcu);
+out:
+	mutex_unlock(&pptp_offload_admin);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(pptp_offload_ops_unregister);
+
+static int pptp_next_seq(struct pppox_sock *po, u32 *seq)
+{
+	const struct pptp_offload_ops *ops;
+	struct pptp_offload_key key;
+	struct pptp_opt *opt = &po->proto.pptp;
+	unsigned long flags;
+	int idx, ret = -EOPNOTSUPP;
+
+	spin_lock_irqsave(&opt->offload_lock, flags);
+	pptp_offload_key(po, &key);
+	idx = srcu_read_lock(&pptp_offload_srcu);
+	ops = srcu_dereference(pptp_offload_ops, &pptp_offload_srcu);
+	if (ops)
+		ret = ops->next(&key, opt->seq_sent, seq);
+	srcu_read_unlock(&pptp_offload_srcu, idx);
+	if (ret == -EOPNOTSUPP) {
+		*seq = opt->seq_sent + 1;
+		ret = 0;
+	}
+	/* An active hardware counter error must not reuse stale software state. */
+	if (!ret)
+		opt->seq_sent = *seq;
+	spin_unlock_irqrestore(&opt->offload_lock, flags);
+	return ret;
+}
+
+static int pptp_offload_close(struct pppox_sock *po)
+{
+	const struct pptp_offload_ops *ops;
+	struct pptp_offload_key key;
+	int idx, ret = 0;
+
+	pptp_offload_key(po, &key);
+	spin_lock_bh(&chan_lock);
+	if (callid_cookie[key.local_id] == key.cookie)
+		set_bit(key.local_id, callid_closing);
+	spin_unlock_bh(&chan_lock);
+	/* Channel unbind has drained transmitters. Close is sleepable so the
+	 * provider can invalidate PPE entries before the call ID is reused.
+	 */
+	idx = srcu_read_lock(&pptp_offload_srcu);
+	ops = srcu_dereference(pptp_offload_ops, &pptp_offload_srcu);
+	if (ops)
+		ret = ops->close(&key);
+	srcu_read_unlock(&pptp_offload_srcu, idx);
+	return ret;
+}
+
+static int pptp_get_tunnel_info(struct ppp_channel *chan,
+				struct ppp_tunnel_info *info)
+{
+	struct sock *sk = chan->private;
+	struct pppox_sock *po = pppox_sk(sk);
+	struct pptp_opt *opt = &po->proto.pptp;
+	unsigned long flags;
+
+	if (!(sk->sk_state & PPPOX_CONNECTED))
+		return -ENOTCONN;
+	if (READ_ONCE(opt->ppp_flags) & (SC_COMP_AC | SC_COMP_PROT))
+		return -EOPNOTSUPP;
+	spin_lock_irqsave(&opt->offload_lock, flags);
+	info->kind = PPP_TUNNEL_PPTP;
+	info->version = 1;
+	info->tunnel_id = opt->src_addr.call_id;
+	info->peer_tunnel_id = opt->dst_addr.call_id;
+	info->cookie = opt->offload_cookie;
+	info->local_addr = opt->src_addr.sin_addr.s_addr;
+	info->peer_addr = opt->dst_addr.sin_addr.s_addr;
+	info->sequence = opt->seq_sent;
+	info->ppp_flags = opt->ppp_flags;
+	spin_unlock_irqrestore(&opt->offload_lock, flags);
+	return 0;
+}
+#else
+static int pptp_next_seq(struct pppox_sock *po, u32 *seq)
+{
+	*seq = ++po->proto.pptp.seq_sent;
+	return 0;
+}
+static int pptp_offload_close(struct pppox_sock *po) { return 0; }
+#endif
+
