 /*---------------------------- Module parameters ----------------------------*/
 
 /* monitor all links that often (in milliseconds). <=0 disables monitoring */
@@ -5929,6 +5932,44 @@
 	return ret;
 }
 
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+static int bond_dev_flow_offload_check(struct flow_offload_hw_path *path)
+{
+	struct bonding *bond = netdev_priv(path->dev);
+	struct bond_up_slave *slaves;
+	struct slave *slave;
+	unsigned int count;
+	int ret = -ENETDOWN;
+
+	rcu_read_lock();
+	switch (BOND_MODE(bond)) {
+	case BOND_MODE_ACTIVEBACKUP:
+		slave = rcu_dereference(bond->curr_active_slave);
+		break;
+	case BOND_MODE_XOR:
+	case BOND_MODE_8023AD:
+		slaves = rcu_dereference(bond->usable_slaves);
+		count = slaves ? READ_ONCE(slaves->count) : 0;
+		if (!count)
+			goto out;
+		slave = slaves->arr[(path->skb_hash >> 1) % count];
+		break;
+	default:
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	if (!slave || !bond_slave_can_tx(slave))
+		goto out;
+
+	path->dev = slave->dev;
+	ret = path->dev->netdev_ops->ndo_flow_offload_check ?
+		path->dev->netdev_ops->ndo_flow_offload_check(path) : 0;
+out:
+	rcu_read_unlock();
+	return ret;
+}
+#endif /* CONFIG_NF_FLOW_TABLE */
