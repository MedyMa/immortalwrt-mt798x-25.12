+	rt = pptp_route_output(po, &fl4);
+	if (IS_ERR(rt))
+		return PTR_ERR(rt);
+	ret = mtk_npu_flow_neigh(&rt->dst, info.peer_addr, path);
+	if (!ret) {
+		path->type = DEV_PATH_PPTP;
+		path->dev = ctx->dev;
+		path->tunnel_2410.sip.ip = info.local_addr;
+		path->tunnel_2410.dip.ip = info.peer_addr;
+		path->tunnel_2410.ttl = ip4_dst_hoplimit(&rt->dst);
+		path->tunnel_2410.tos = 0;
