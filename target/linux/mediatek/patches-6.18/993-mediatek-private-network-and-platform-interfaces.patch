+/* Resolve egress path for (DMAC, vid) on a bridge.
+ *
+ * Returns 0 on FDB hit; -ENOENT on miss (unknown unicast / would flood).
+ * On a forwarding hit, path->dev is updated to the egress slave; on a
+ * BR_FDB_LOCAL hit, path->dev is left unchanged so callers can tell
+ * host-bound from forwarded.
+ */
+static int br_flow_offload_check(struct flow_offload_hw_path *path)
+{
+	struct net_device *dev = path->dev;
+	struct net_bridge *br = netdev_priv(dev);
+	struct net_bridge_fdb_entry *f;
+	struct net_bridge_port *dst;
+
+	if (!(path->flags & BIT(DEV_PATH_ETHERNET)))
+		return -EINVAL;
+
+	f = br_fdb_find_rcu(br, path->eth_dest, path->vlan_id);
+	if (!f)
+		return -ENOENT;
+
+	/* Host-bound: bridge/port self or user-added permanent entry. */
+	if (test_bit(BR_FDB_LOCAL, &f->flags))
+		return 0;
+
+	dst = READ_ONCE(f->dst);
+	if (!dst)
+		return -ENOENT;
+
+	path->dev = dst->dev;
+	if (path->dev->netdev_ops->ndo_flow_offload_check)
+		return path->dev->netdev_ops->ndo_flow_offload_check(path);
+
+	return 0;
+}
+#endif /* CONFIG_NF_FLOW_TABLE */
 
