+static void mtk_pcie_shutdown(struct platform_device *pdev)
+{
+	struct mtk_gen3_pcie *pcie = platform_get_drvdata(pdev);
+	u32 val;
+
+	/* Reset the BE14 endpoints on warm reboot even when slot power stays on. */
+	if (!device_property_present(&pdev->dev, "vpcie12v-supply") ||
+	    (pcie->soc->flags & SKIP_PCIE_RSTB) || READ_ONCE(pcie->soft_off))
+		return;
+
+	val = readl(pcie->base + PCIE_RST_CTRL_REG);
+	writel(val | PCIE_PE_RSTB, pcie->base + PCIE_RST_CTRL_REG);
+	msleep(100);
