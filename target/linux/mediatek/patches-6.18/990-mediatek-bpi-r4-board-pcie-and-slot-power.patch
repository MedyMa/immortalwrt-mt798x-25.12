+/* The BE14 recovery path powers down only the host of its PCI function. */
+static int mtk_pcie_set_link_power(struct pci_bus *bus, bool on)
+{
+	struct pci_host_bridge *host;
+	struct mtk_gen3_pcie *pcie;
+	struct pci_dev *port;
+	int ret = 0;
+
+	if (!bus)
+		return -ENODEV;
+	host = pci_find_host_bridge(bus);
+	if (!host || host->ops != &mtk_pcie_ops)
+		return -ENODEV;
+	pcie = pci_host_bridge_priv(host);
+	mutex_lock(&pcie->link_lock);
+	if (pcie->soft_off != on)
+		goto out_unlock;
+	port = pci_get_slot(host->bus, PCI_DEVFN(0, 0));
+	if (!port) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+
+	if (!on) {
+		ret = pci_save_state(port);
+		if (ret)
+			goto out_put;
+		ret = mtk_pcie_turn_off_link(pcie);
+		if (ret)
+			goto out_put;
+		mtk_pcie_irq_save(pcie);
+		WRITE_ONCE(pcie->soft_off, true);
+		mtk_pcie_power_down(pcie);
+	} else {
+		ret = pcie->soc->power_up(pcie);
+		if (ret)
+			goto out_put;
+		ret = mtk_pcie_startup_port(pcie);
+		if (ret) {
+			mtk_pcie_power_down(pcie);
+			goto out_put;
+		}
+		WRITE_ONCE(pcie->soft_off, false);
+		mtk_pcie_irq_restore(pcie);
+		pci_restore_state(port);
+	}
+out_put:
+	pci_dev_put(port);
+out_unlock:
+	mutex_unlock(&pcie->link_lock);
+	return ret;
+}
+
+int mtk_pcie_soft_off(struct pci_bus *bus)
+{
+	return mtk_pcie_set_link_power(bus, false);
+}
+EXPORT_SYMBOL(mtk_pcie_soft_off);
+
+int mtk_pcie_soft_on(struct pci_bus *bus)
+{
+	return mtk_pcie_set_link_power(bus, true);
+}
+EXPORT_SYMBOL(mtk_pcie_soft_on);
 
