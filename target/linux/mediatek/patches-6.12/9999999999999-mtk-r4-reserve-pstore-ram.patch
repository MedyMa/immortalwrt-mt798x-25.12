Subject: [PATCH] arm64: dts: mediatek: reserve BPI-R4 crash log memory

BPI-R4 U-Boot reads ramoops records at 0x42ff0000 before selecting the boot
image. Reserve the same 64 KiB in Linux so ordinary allocations cannot reuse
the area. Match U-Boot's default record, console, ftrace and pmsg sizes so
normal console data is not scanned as crash records. Restrict crash records
to panic/oops; normal shutdown must not trigger crash recovery selection.

--- a/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4.dtsi
@@ -37,6 +37,23 @@
 		reg = <0x00 0x40000000 0x00 0x10000000>;
 	};
 
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		ramoops@42ff0000 {
+			compatible = "ramoops";
+			reg = <0 0x42ff0000 0 0x10000>;
+			record-size = <0x1000>;
+			console-size = <0x1000>;
+			ftrace-size = <0x1000>;
+			pmsg-size = <0x1000>;
+			max-reason = <2>;
+			no-map;
+		};
+	};
+
 	reg_1p8v: regulator-1p8v {
 		compatible = "regulator-fixed";
 		regulator-name = "fixed-1.8V";
