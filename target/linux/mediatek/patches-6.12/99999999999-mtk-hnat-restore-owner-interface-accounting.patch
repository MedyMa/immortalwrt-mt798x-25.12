+/* Initial publication/prefill preserves the routed virtual output device. */
+bool hnat_account_commit_vif(struct mtk_hnat *h, u32 ppe, u32 slot,
+			     struct sk_buff *skb, const struct foe_entry *entry,
+			     bool prefill, bool *accepted,
+			     const struct net_device *out);
