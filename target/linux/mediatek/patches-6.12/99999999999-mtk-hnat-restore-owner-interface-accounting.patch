 		hnat_diag_note(skb, HNAT_DIAG_ACCOUNT_UNAVAILABLE, 0, 0, -1, 0, -1);
 		if (!hnat_priv->data->per_flow_accounting &&
@@ -4602,7 +4601,7 @@
