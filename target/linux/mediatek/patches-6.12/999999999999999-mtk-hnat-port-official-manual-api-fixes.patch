+/* Legacy fallback only; owner-accounted reads use the ledger's per-PPE lock. */
+static spinlock_t hnat_mib_lock[MAX_PPE_NUM] = {
+	[0 ... MAX_PPE_NUM - 1] = __SPIN_LOCK_UNLOCKED(hnat_mib_lock),
