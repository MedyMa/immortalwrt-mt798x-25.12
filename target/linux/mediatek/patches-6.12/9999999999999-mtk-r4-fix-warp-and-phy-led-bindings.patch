Subject: arm64: dts: mediatek: use one WARP resource set on BPI-R4

Reuse the Logan WARP nodes already included by the SoC. Board duplicates
produce colliding platform names and ambiguous resource lookups. Preserve
the dynamic RX buffer setting and reset-controller parent bus, and bind
the 2.5G PHY LED pin state under the name requested by its driver.

--- a/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4.dtsi
@@ -8,7 +8,6 @@
 #include "mt7988a.dtsi"
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
-#include <dt-bindings/reset/ti-syscon.h>
 #include <dt-bindings/leds/common.h>
 #include <dt-bindings/regulator/richtek,rt5190a-regulator.h>
 
@@ -53,96 +52,6 @@
 		regulator-max-microvolt = <3300000>;
 		regulator-boot-on;
 		regulator-always-on;
-	};
