+/* A hardware-decrypted CPU return needs a live inbound XFRM state. */
+static bool mtk_crypto_rx_secpath_valid(struct sk_buff *skb, u16 cdrt)
+{
+#if IS_ENABLED(CONFIG_XFRM_OFFLOAD)
+	void (*setup_secpath)(struct sk_buff *skb, u16 cdrt);
+	struct xfrm_offload *xo;
+	struct sec_path *sp;
+	bool valid = false;
+
+	rcu_read_lock();
+	setup_secpath = rcu_dereference(mtk_crypto_set_dec_secpath);
+	if (setup_secpath) {
+		setup_secpath(skb, cdrt);
+		sp = skb_sec_path(skb);
+		xo = xfrm_offload(skb);
+		valid = sp && sp->len && xo &&
+			(xo->flags & CRYPTO_DONE) && xo->status == CRYPTO_SUCCESS;
+	}
+	rcu_read_unlock();
+
+	return valid;
+#else
+	return false;
+#endif
+}
