From: MedyMa <MedyMa@users.noreply.github.com>
Subject: [PATCH] xfrm: give inline packet TX explicit ownership and protect HNAT hook

Keep offload eligibility side-effect free. An optional packet-xmit callback
consumes skb on every return, including fragmentation failures. Preserve the
standard output path for other drivers. Check inbound policies against the
RX secpath instead of accepting every packet based on policy offload alone.
Read the HNAT provider once under RCU and synchronize before module unload.

--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat.c
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat.c
@@ -67,7 +67,7 @@
 EXPORT_SYMBOL(mtk_tnl_decap_offload);
 bool (*mtk_tnl_decap_offloadable)(struct sk_buff *skb) = NULL;
 EXPORT_SYMBOL(mtk_tnl_decap_offloadable);
-bool (*mtk_crypto_offloadable)(struct sk_buff *skb) = NULL;
+bool (* __rcu mtk_crypto_offloadable)(struct sk_buff *skb) = NULL;
 EXPORT_SYMBOL(mtk_crypto_offloadable);
 int (*eth_hook_tx)(struct sk_buff *skb, struct net_device *dev) = NULL;
 EXPORT_SYMBOL(eth_hook_tx);
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat.h
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat.h
@@ -1546,7 +1546,7 @@
 extern int (*mtk_tnl_encap_offload)(struct sk_buff *skb, struct ethhdr *eth);
 extern int (*mtk_tnl_decap_offload)(struct sk_buff *skb);
 extern bool (*mtk_tnl_decap_offloadable)(struct sk_buff *skb);
-extern bool (*mtk_crypto_offloadable)(struct sk_buff *skb);
+extern bool (* __rcu mtk_crypto_offloadable)(struct sk_buff *skb);
 extern int hnat_bind_crypto_entry(struct sk_buff *skb,
 				  const struct net_device *dev,
 				  int fill_inner_info);
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
@@ -4281,9 +4281,18 @@
 	 * is from local_out which is also filtered in sanity check.
 	 */
 	dst = skb_dst(skb);
-	if (dst && dst_xfrm(dst) &&
-	    (!mtk_crypto_offloadable || !mtk_crypto_offloadable(skb)))
-		return 0;
+	if (dst && dst_xfrm(dst)) {
+		bool (*offloadable)(struct sk_buff *skb);
+		bool ok;
+
+		/* Pair with the provider's synchronize_net() on module exit. */
+		rcu_read_lock();
+		offloadable = rcu_dereference(mtk_crypto_offloadable);
+		ok = offloadable && offloadable(skb);
+		rcu_read_unlock();
+		if (!ok)
+			return 0;
+	}
 
 	ct = nf_ct_get(skb, &ctinfo);
 	if (!ct)
--- a/include/linux/netdevice.h
+++ b/include/linux/netdevice.h
@@ -1026,6 +1026,10 @@
 	int	(*xdo_dev_policy_add) (struct xfrm_policy *x, struct netlink_ext_ack *extack);
 	void	(*xdo_dev_policy_delete) (struct xfrm_policy *x);
 	void	(*xdo_dev_policy_free) (struct xfrm_policy *x);
+	/* Optional packet-mode transmit. Consumes skb on EVERY return path;
+	 * xdo_dev_offload_ok remains a read-only eligibility predicate.
+	 */
+	int	(*xdo_dev_packet_xmit) (struct sk_buff *skb, struct xfrm_state *x);
 };
 #endif
 
--- a/net/xfrm/xfrm_device.c
+++ b/net/xfrm/xfrm_device.c
@@ -435,12 +435,6 @@
 			goto ok;
 	}
 
-	if (x->props.family == AF_INET && x->xso.type == XFRM_DEV_OFFLOAD_PACKET) {
-		skb_gso_reset(skb);
-		IPCB(skb)->frag_max_size = mtu;
-		if (!ip_do_fragment(dev_net(skb_dst(skb)->dev), skb->sk, skb, xfrm4_output))
-			return true;
-	}
 	return false;
 
 ok:
--- a/net/xfrm/xfrm_output.c
+++ b/net/xfrm/xfrm_output.c
@@ -584,16 +584,12 @@
 int xfrm_output_resume(struct sock *sk, struct sk_buff *skb, int err)
 {
 	struct dst_entry *dst = skb_dst(skb);
-	struct net *net = NULL;
-
-	/* If a IPSec tunnel is HW offloaded, all packets should send to eip.
-	 * However, eip cannot fragment packets, so we perform ip_do_fragment()
-	 * in xfrm_dev_offload_ok(). If ip_do_fragment() failed, the original skb
-	 * will reach here and need to be returned.
-	 */
-	if (unlikely(!dst || !(dst->xfrm)))
+	struct net *net;
+
+	if (unlikely(!dst || !dst->xfrm)) {
+		kfree_skb(skb);
 		return -EINVAL;
-
+	}
 	net = xs_net(dst->xfrm);
 
 	while (likely((err = xfrm_output_one(skb, err)) == 0)) {
@@ -620,6 +616,39 @@
 	return err;
 }
 EXPORT_SYMBOL_GPL(xfrm_output_resume);
+
+static int xfrm_dev_direct_output(struct sock *sk, struct xfrm_state *x,
+				  struct sk_buff *skb)
+{
+	struct dst_entry *dst = skb_dst(skb);
+	struct net *net = xs_net(x);
+	int err;
+
+	dst = skb_dst_pop(skb);
+	if (!dst) {
+		XFRM_INC_STATS(net, LINUX_MIB_XFRMOUTERROR);
+		kfree_skb(skb);
+		return -EHOSTUNREACH;
+	}
+	skb_dst_set(skb, dst);
+	nf_reset_ct(skb);
+
+	err = skb_dst(skb)->ops->local_out(net, sk, skb);
+	if (unlikely(err != 1))
+		return err;
+
+	/* In transport mode, network destination is
+	 * directly reachable, while in tunnel mode,
+	 * inner packet network may not be. In packet
+	 * offload type, HW is responsible for hard
+	 * header packet mangling so directly xmit skb
+	 * to netdevice.
+	 */
+	skb->dev = x->xso.dev;
+	__skb_push(skb, skb->dev->hard_header_len);
+	return dev_queue_xmit(skb);
+}
+
 
 static int xfrm_output2(struct net *net, struct sock *sk, struct sk_buff *skb)
 {
@@ -734,22 +763,24 @@
 	}
 
 	if (x->xso.type == XFRM_DEV_OFFLOAD_PACKET) {
+#ifdef CONFIG_XFRM_OFFLOAD
+		struct net_device *dev = x->xso.dev;
+
+		/* The consuming transmit callback owns errors and fragmentation.
+		 * Never inspect or free skb after calling it.
+		 */
+		if (dev && dev->xfrmdev_ops && dev->xfrmdev_ops->xdo_dev_packet_xmit)
+			return dev->xfrmdev_ops->xdo_dev_packet_xmit(skb, x);
+#endif
+
 		if (!xfrm_dev_offload_ok(skb, x)) {
 			XFRM_INC_STATS(net, LINUX_MIB_XFRMOUTERROR);
 			kfree_skb(skb);
 			return -EHOSTUNREACH;
 		}
-
-		/* This is just a workaround to mark the packet
-		 * which needs to be free with packet offload
-		 */
-		if (skb->inner_protocol == IPPROTO_RSVP) {
-			XFRM_INC_STATS(net, LINUX_MIB_XFRMOUTERROR);
-			kfree_skb(skb);
-			return -EHOSTUNREACH;
-		}
-
-		return 0;
+		if (x->props.mode == XFRM_MODE_TUNNEL && !skb->sk)
+			return xfrm_dev_direct_output(sk, x, skb);
+		return xfrm_output_resume(sk, skb, 0);
 	}
 
 	secpath_reset(skb);
--- a/net/xfrm/xfrm_policy.c
+++ b/net/xfrm/xfrm_policy.c
@@ -3784,13 +3784,6 @@
 	}
 #endif
 
-	/* Inbound HW offload packets, pass the check directly */
-	if (pol->xdo.type == XFRM_DEV_OFFLOAD_PACKET &&
-	    (pol->xdo.dir == XFRM_DEV_OFFLOAD_IN || pol->xdo.dir == XFRM_DEV_OFFLOAD_FWD)) {
-		xfrm_pols_put(pols, npols);
-		return 1;
-	}
-
 	if (pol->action == XFRM_POLICY_ALLOW) {
 		static struct sec_path dummy;
 		struct xfrm_tmpl *tp[XFRM_MAX_DEPTH];
