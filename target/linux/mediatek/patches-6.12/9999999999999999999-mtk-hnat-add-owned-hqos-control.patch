From: MedyMa <75345465+MedyMa@users.noreply.github.com>
Subject: [PATCH] net: mediatek: add owned HQoS control and software bypass ABI

Let a serialized userspace owner restore only the QDMA settings it changed.
Expose a root-only CAP_NET_ADMIN control that changes mode and retires FOE
bindings without resetting all queues, flushing conntrack or restarting hooks.
Gate writes on completed probe and serialize with administrative reset.
Recognize the software shaping bit only while the new owner is active.

Signed-off-by: MedyMa <75345465+MedyMa@users.noreply.github.com>

---
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat.h
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat.h
@@ -903,6 +903,11 @@
  * for the packet flow.
  */
 #define HNAT_EXCEPTION_TAG	0x99
+/* Shared with userspace HQoS: preserve routing bits while excluding software
+ * shaped flows from HNAT. This bit is active only in owned HQoS mode.
+ */
+#define HNAT_QOS_SOFTWARE_MARK	0x80
+#define HNAT_QOS_PACKET_MARK	0x4000
 
 struct mib_entry {
 	u32 byt_cnt_l;
@@ -1390,6 +1395,21 @@
 extern int hook_toggle;
 extern int mape_toggle;
 extern int qos_toggle;
+extern bool qos_user_owned;
+
+/* Only the explicit userspace packet namespace may select a managed QID.
+ * Unrelated proxy/PBR marks retain their routing meaning and use Q0.
+ */
+static inline u32 hnat_qos_queue_mark(const struct sk_buff *skb)
+{
+	u32 mark = skb->mark;
+
+	if (READ_ONCE(qos_user_owned) &&
+	    (mark & (0xffffU & ~MTK_QDMA_TX_MASK)) != HNAT_QOS_PACKET_MARK)
+		return 0;
+	return mark;
+}
+
 
 int ext_if_add(struct extdev_entry *ext_entry);
 int ext_if_del(struct extdev_entry *ext_entry);
