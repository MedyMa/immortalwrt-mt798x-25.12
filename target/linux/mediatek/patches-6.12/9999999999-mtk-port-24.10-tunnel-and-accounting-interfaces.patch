+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _NET_MTK_NPU_FLOW_H
+#define _NET_MTK_NPU_FLOW_H
+
+#include <linux/errno.h>
+#include <linux/netdevice.h>
+
+#define MTK_NPU_FLOW_F_ENCAP BIT(0)
+#define MTK_NPU_FLOW_FIRST 32
+#define MTK_NPU_FLOW_LAST 63
+
+/* Scalar identity only: tokens may outlive a provider registration or slot. */
+struct mtk_npu_flow_token {
+	u64 provider;
+	u64 generation;
+	u64 allocation;
+	u32 entry;
+	u32 tunnel_ifindex;
+	u32 egress_ifindex;
+	u32 flags;
+};
+
+struct mtk_npu_flow_ops {
+	bool (*supported)(enum net_device_path_type type);
+	int (*prepare)(const struct net_device_path *path,
+		       struct mtk_npu_flow_token *token);
+	/* Called under the PPE bind spinlock. Never acquire the PPE or flow
+	 * table locks here. The successful guard pins tunnel state until unlock.
+	 */
+	bool (*bind)(const struct mtk_npu_flow_token *token, void **owner);
+	void (*unbind)(void *owner);
+};
+
+struct mtk_npu_flow_guard {
+	const struct mtk_npu_flow_ops *ops;
+	void *owner;
+};
+struct dst_entry;
+
+#if IS_ENABLED(CONFIG_NET_MEDIATEK_NPU_FLOW)
+int mtk_npu_flow_register(const struct mtk_npu_flow_ops *ops);
+int mtk_npu_flow_unregister(const struct mtk_npu_flow_ops *ops);
+bool mtk_npu_flow_supported(enum net_device_path_type type);
+int mtk_npu_flow_prepare(const struct net_device_path *path,
+			 struct mtk_npu_flow_token *token);
+bool mtk_npu_flow_lock(const struct mtk_npu_flow_token *token,
