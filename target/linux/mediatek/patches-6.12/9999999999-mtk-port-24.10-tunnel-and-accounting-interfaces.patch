+static void pptp_offload_key(struct pppox_sock *po, struct pptp_offload_key *key)
+{
+	struct pptp_opt *opt = &po->proto.pptp;
+
+	memset(key, 0, sizeof(*key));
+	key->cookie = opt->offload_cookie;
+	key->netns = sock_net(sk_pppox(po))->ns.inum;
+	key->local_addr = opt->src_addr.sin_addr.s_addr;
+	key->peer_addr = opt->dst_addr.sin_addr.s_addr;
+	key->local_id = opt->src_addr.call_id;
+	key->peer_id = opt->dst_addr.call_id;
+}
