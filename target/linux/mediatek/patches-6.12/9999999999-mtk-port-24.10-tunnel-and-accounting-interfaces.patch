+void pptp_offload_callid_release(const struct pptp_offload_key *key)
+{
+	unsigned long flags;
+
+	if (!key || !key->cookie)
+		return;
+	spin_lock_irqsave(&chan_lock, flags);
+	if (callid_cookie[key->local_id] == key->cookie &&
+	    test_bit(key->local_id, callid_closing) &&
+	    !rcu_access_pointer(callid_sock[key->local_id])) {
+		callid_cookie[key->local_id] = 0;
+		clear_bit(key->local_id, callid_closing);
+		clear_bit(key->local_id, callid_bitmap);
+	}
+	spin_unlock_irqrestore(&chan_lock, flags);
+}
+EXPORT_SYMBOL_GPL(pptp_offload_callid_release);
