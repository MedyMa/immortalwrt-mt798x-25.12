+static int pptp_next_seq(struct pppox_sock *po, u32 *seq)
+{
+	const struct pptp_offload_ops *ops;
+	struct pptp_offload_key key;
+	struct pptp_opt *opt = &po->proto.pptp;
+	unsigned long flags;
+	int idx, ret = -EOPNOTSUPP;
+
+	spin_lock_irqsave(&opt->offload_lock, flags);
+	pptp_offload_key(po, &key);
+	idx = srcu_read_lock(&pptp_offload_srcu);
+	ops = srcu_dereference(pptp_offload_ops, &pptp_offload_srcu);
+	if (ops)
+		ret = ops->next(&key, opt->seq_sent, seq);
+	srcu_read_unlock(&pptp_offload_srcu, idx);
+	if (ret == -EOPNOTSUPP) {
+		*seq = opt->seq_sent + 1;
+		ret = 0;
+	}
+	/* An active hardware counter error must not reuse stale software state. */
+	if (!ret)
+		opt->seq_sent = *seq;
+	spin_unlock_irqrestore(&opt->offload_lock, flags);
+	return ret;
+}
+
+static int pptp_offload_close(struct pppox_sock *po)
+{
+	const struct pptp_offload_ops *ops;
+	struct pptp_offload_key key;
+	int idx, ret = 0;
+
+	pptp_offload_key(po, &key);
+	spin_lock_bh(&chan_lock);
+	if (callid_cookie[key.local_id] == key.cookie)
+		set_bit(key.local_id, callid_closing);
+	spin_unlock_bh(&chan_lock);
+	/* Channel unbind has drained transmitters. Close is sleepable so the
+	 * provider can invalidate PPE entries before the call ID is reused.
+	 */
+	idx = srcu_read_lock(&pptp_offload_srcu);
+	ops = srcu_dereference(pptp_offload_ops, &pptp_offload_srcu);
+	if (ops)
+		ret = ops->close(&key);
+	srcu_read_unlock(&pptp_offload_srcu, idx);
+	return ret;
+}
