+/* The provider must stop hardware sequence consumers before unregistering.
+ * Keep dispatch published through handover: a software transmitter admitted
+ * after its socket was visited still updates seq_sent from the provider.
+ */
+int pptp_offload_ops_unregister(const struct pptp_offload_ops *ops)
+{
+	struct pptp_offload_key key;
+	struct pppox_sock *po;
+	unsigned long flags;
+	u32 seq;
+	unsigned int id;
+	int ret = 0;
+
+	if (!ops)
+		return -EINVAL;
+	mutex_lock(&pptp_offload_admin);
+	if (rcu_access_pointer(pptp_offload_ops) != ops) {
+		ret = -ENOENT;
+		goto out;
+	}
+	for (id = 0; id <= MAX_CALLID; id++) {
+		rcu_read_lock();
+		po = rcu_dereference(callid_sock[id]);
+		if (po) {
+			spin_lock_irqsave(&po->proto.pptp.offload_lock, flags);
+			pptp_offload_key(po, &key);
+			if (!ops->snapshot(&key, &seq))
+				po->proto.pptp.seq_sent = seq;
+			spin_unlock_irqrestore(&po->proto.pptp.offload_lock, flags);
+		}
+		rcu_read_unlock();
+		if (!(id & 127))
+			cond_resched();
+	}
+	rcu_assign_pointer(pptp_offload_ops, NULL);
+	synchronize_srcu(&pptp_offload_srcu);
+out:
+	mutex_unlock(&pptp_offload_admin);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(pptp_offload_ops_unregister);
