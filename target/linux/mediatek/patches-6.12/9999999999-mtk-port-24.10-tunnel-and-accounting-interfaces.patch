+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _NF_HNAT_PACKET_ACCOUNTING_H
+#define _NF_HNAT_PACKET_ACCOUNTING_H
+#include <linux/skbuff.h>
+
+struct nf_hnat_packet_accounting {
+	u64 bytes;
+	u64 packets;
+	unsigned long nfct;
+};
+
+#ifdef CONFIG_NF_HNAT_PACKET_ACCOUNTING
+/* Module lifetime references: native ordinary counters while any producer is
+ * enabled. Synthetic skb state remains authoritative after producer shutdown.
+ */
+void nf_hnat_packet_accounting_enable(void);
+void nf_hnat_packet_accounting_disable(void);
+bool nf_hnat_packet_accounting_active(void);
+
+/* First visit only. Copies and terminal zero never become producers again. */
+static inline bool nf_hnat_packet_accounting_mark(struct sk_buff *skb)
+{
+	if (skb->hnat_accounting_state)
+		return false;
+	skb->hnat_accounting_state = 1;
+	return true;
+}
+
+static inline bool nf_hnat_packet_accounting_is_synthetic(const struct sk_buff *skb)
+{
+	return skb->hnat_accounting_state != 0;
+}
+
+static inline void nf_hnat_packet_accounting_finish_zero(struct sk_buff *skb)
+{
+	if (skb->hnat_accounting_state == 1)
+		skb->hnat_accounting_state = 3;
+}
+
+/* Reserve before consuming ledger. Only this helper may obtain writable COW
+ * storage. Failure leaves pending data in the producer's ledger.
+ */
+static inline bool nf_hnat_packet_accounting_prepare(struct sk_buff *skb)
+{
+	struct nf_hnat_packet_accounting *acct;
+
+	if (skb->hnat_accounting_state != 1 || !skb_get_nfct(skb))
+		return false;
+	acct = skb_ext_add(skb, SKB_EXT_HNAT_ACCOUNTING);
+	if (!acct) {
+		nf_hnat_packet_accounting_finish_zero(skb);
+		return false;
+	}
+	acct->bytes = 0;
+	acct->packets = 0;
+	acct->nfct = skb_get_nfct(skb);
+	return true;
+}
+
+/* Caller serializes this skb, calls prepare before taking its ledger and
+ * changes neither extensions nor CT identity between prepare and publish.
+ * Identity holds via skb's existing CT reference; reset/copy/set revoke.
+ */
+static inline bool nf_hnat_packet_accounting_publish(struct sk_buff *skb,
+						   u64 bytes, u64 packets)
+{
+	struct nf_hnat_packet_accounting *acct;
+
+	if (skb->hnat_accounting_state != 1 || !skb_get_nfct(skb))
+		return false;
+	acct = skb_ext_find(skb, SKB_EXT_HNAT_ACCOUNTING);
+	if (!acct || acct->nfct != skb_get_nfct(skb))
+		return false;
+	/* prepare reserved exclusive storage; never publish to a shared ext. */
+	if (refcount_read(&skb->extensions->refcnt) != 1)
+		return false;
+	acct->bytes = bytes;
+	acct->packets = packets;
+	acct->nfct = skb_get_nfct(skb);
+	skb->hnat_accounting_state = 2;
+	return true;
+}
+
+/* false: execute unchanged vendor legacy path. true: replace len/1 with
+ * complete immutable pair, including zero. Reading never consumes totals.
+ */
+static inline bool nf_hnat_packet_accounting_get(const struct sk_buff *skb,
+					       u64 *bytes, u64 *packets)
+{
+	const struct nf_hnat_packet_accounting *acct;
+
+	if (!nf_hnat_packet_accounting_is_synthetic(skb)) {
+		if (!nf_hnat_packet_accounting_active())
+			return false;
+		*bytes = skb->len;
+		*packets = 1;
+		return true;
+	}
+	*bytes = 0;
+	*packets = 0;
+	if (skb->hnat_accounting_state != 2)
+		return true;
+	acct = skb_ext_find(skb, SKB_EXT_HNAT_ACCOUNTING);
+	if (acct && acct->nfct == skb_get_nfct(skb)) {
+		*bytes = acct->bytes;
+		*packets = acct->packets;
+	}
+	return true;
+}
+#endif
+#endif
