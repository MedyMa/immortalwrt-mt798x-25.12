From: MedyMa <aneylovemzy@gmail.com>
Subject: [PATCH] net: sfp: retry blank and transiently corrupt EEPROM reads

Adapt the bounded EEPROM retry change from 24.10 to the 6.12 probe path.
Keep byte-at-a-time recovery and the existing vendor checksum exceptions.

--- a/drivers/net/phy/sfp.c
+++ b/drivers/net/phy/sfp.c
@@ -2293,6 +2293,13 @@
 	return true;
 }
 
+/* A blank base has a valid zero checksum but is not a module identity. */
+static bool sfp_id_is_unready(const struct sfp_eeprom_base *id)
+{
+	return !memchr_inv(id, 0, sizeof(*id)) ||
+	       !memchr_inv(id, 0xff, sizeof(*id));
+}
+
 static int sfp_cotsworks_fixup_check(struct sfp *sfp, struct sfp_eeprom_id *id)
 {
 	u8 check;
@@ -2344,7 +2351,7 @@
 static int sfp_sm_mod_probe(struct sfp *sfp, bool report)
 {
 	/* SFP module inserted - read I2C data */
-	struct sfp_eeprom_id id;
+	struct sfp_eeprom_id id = {};
 	bool cotsworks_sfbg;
 	unsigned int mask;
 	bool cotsworks, jesslink, sklink;
@@ -2373,10 +2380,6 @@
 	 * is really required and we have no other option.
 	 */
 	if (sfp_id_needs_byte_io(sfp, &id.base, sizeof(id.base))) {
-		dev_info(sfp->dev,
-			 "Detected broken RTL8672/RTL9601C emulated EEPROM\n");
-		dev_info(sfp->dev,
-			 "Switching to reading EEPROM to one byte at a time\n");
 		sfp->i2c_block_size = 1;
 
 		ret = sfp_read(sfp, false, 0, &id.base, sizeof(id.base));
@@ -2393,7 +2396,16 @@
 				ERR_PTR(ret));
 			return -EAGAIN;
 		}
-	}
+		if (sfp_id_is_unready(&id.base))
+			goto unready;
+		dev_info(sfp->dev,
+			 "Detected broken RTL8672/RTL9601C emulated EEPROM\n");
+		dev_info(sfp->dev,
+			 "Switching to reading EEPROM to one byte at a time\n");
+	}
+
+	if (sfp_id_is_unready(&id.base))
+		goto unready;
 
 	/* Cotsworks do not seem to update the checksums when they
 	 * do the final programming with the final module part number,
@@ -2432,12 +2444,14 @@
 				 "EEPROM base structure checksum failure (0x%02x != 0x%02x)\n",
 				 check, id.base.cc_base);
 		} else {
-			dev_err(sfp->dev,
-				"EEPROM base structure checksum failure: 0x%02x != 0x%02x\n",
-				check, id.base.cc_base);
-			print_hex_dump(KERN_ERR, "sfp EE: ", DUMP_PREFIX_OFFSET,
-				       16, 1, &id, sizeof(id), true);
-			return -EINVAL;
+			if (report) {
+				dev_err(sfp->dev,
+					"EEPROM base structure checksum failure: 0x%02x != 0x%02x\n",
+					check, id.base.cc_base);
+				print_hex_dump(KERN_ERR, "sfp EE: ", DUMP_PREFIX_OFFSET,
+					       16, 1, &id.base, sizeof(id.base), true);
+			}
+			return -EAGAIN;
 		}
 	}
 
@@ -2544,6 +2558,11 @@
 	mutex_unlock(&sfp->st_mutex);
 
 	return 0;
+
+unready:
+	if (report)
+		dev_err(sfp->dev, "EEPROM base is blank or erased; module identity unavailable\n");
+	return -EAGAIN;
 }
 
 static void sfp_sm_mod_remove(struct sfp *sfp)
