Subject: [PATCH] arm64: dts: mediatek: enable HNAT on BPI-R4

Enable the MT7988 HNAT node for BPI-R4 and match its copper DSA WAN,
SFP WAN, LAN bridge ports, and SFP LAN netdev names.

--- a/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4.dts
+++ b/arch/arm64/boot/dts/mediatek/mt7988a-bananapi-bpi-r4.dts
@@ -43,3 +43,12 @@
 	openwrt,netdev-name = "sfp-lan";
 	status = "okay";
 };
+&hnat {
+	mtketh-wan = "sfp-wan";
+	mtketh-lan = "lan";
+	mtketh-lan2 = "sfp-lan";
+	mtkdsa-wan-port = <0>;
+	mtketh-max-gmac = <3>;
+	mtketh-ppe-num = <3>;
+	status = "okay";
+};
