+static struct hnat_flow_entry *
+hnat_flow_entry_reserve(const struct foe_entry *entry, u32 ppe, u32 slot,
+			struct net_device *dev, struct nf_conn *ct)
+{
+	struct hnat_flow_entry *flow;
+	bool reuse;
+
+	if (ppe >= MAX_PPE_NUM || ppe >= CFG_PPE_NUM ||
+	    slot >= hnat_priv->foe_etry_num || !hnat_priv->foe_flow[ppe])
+		return ERR_PTR(-EINVAL);
+	spin_lock_bh(&hnat_priv->flow_entry_lock);
+	flow = hnat_flow_entry_search(entry, ppe, slot, false);
+	reuse = flow && flow->tunnel_dev == dev &&
+		flow->tunnel_ct == (dev ? ct : NULL);
+	spin_unlock_bh(&hnat_priv->flow_entry_lock);
+	if (reuse)
+		return NULL;
+	flow = kzalloc(sizeof(*flow), GFP_ATOMIC);
+	return flow ? flow : ERR_PTR(-ENOMEM);
