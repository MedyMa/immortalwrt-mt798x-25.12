+			found->tunnel_dev = new_flow->tunnel_dev;
+			found->tunnel_ct = new_flow->tunnel_ct;
+			found->tunnel_ctinfo = new_flow->tunnel_ctinfo;
+			new_flow->tunnel_dev = old_dev;
