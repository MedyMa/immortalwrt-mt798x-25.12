-		if (IS_WHNAT(dev))
-			pse_bmp |= (1 << MCAST_TO_TDMA);
-		else if (IS_LAN_GRP(dev) || IS_WAN(dev))
-			hnat_mcast_set_gmac_bit(dev, &pse_bmp);
