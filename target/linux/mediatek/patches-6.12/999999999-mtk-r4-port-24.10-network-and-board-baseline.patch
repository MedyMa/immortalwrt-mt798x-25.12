+#if IS_ENABLED(CONFIG_NET_MEDIATEK_NPU_FLOW)
+/* Keep retired software records for the normal flowtable stats/destroy cycle.
+ * No table mutex is taken: this also serves protocol changes in softirq.
+ */
+void mtk_npu_flow_flush_ppe(struct mtk_eth *eth, u32 tunnel_entry)
+{
+	struct mtk_flow_entry *entry;
+	struct hlist_node *next;
+	unsigned int p, first, bucket, end;
+
+	if (!eth || !mtk_is_netsys_v3_or_greater(eth))
+		return;
+	for (p = 0; p < ARRAY_SIZE(eth->ppe); p++) {
+		struct mtk_ppe *ppe = eth->ppe[p];
+		unsigned int buckets;
+
+		if (!ppe || !ppe->foe_table || !ppe->foe_flow)
+			continue;
+		buckets = MTK_PPE_ENTRIES / eth->soc->hash_offset;
+		for (first = 0; first < buckets; first += 64) {
+			end = min(first + 64, buckets);
+			spin_lock_bh(&ppe_lock);
+			for (bucket = first; bucket < end; bucket++) {
+				hlist_for_each_entry_safe(entry, next, &ppe->foe_flow[bucket], list) {
+					if (!entry->npu.entry || entry->npu_retired ||
+					    (tunnel_entry && entry->npu.entry != tunnel_entry))
+						continue;
+					__mtk_foe_entry_clear(ppe, entry, true);
+					hlist_del_init(&entry->list);
+				}
+			}
+			spin_unlock_bh(&ppe_lock);
+		}
+	}
+}
+EXPORT_SYMBOL_GPL(mtk_npu_flow_flush_ppe);
+
+void mtk_npu_flow_retire_entry(struct mtk_ppe *ppe, struct mtk_flow_entry *entry,
+			       u64 *packets, u64 *bytes)
+{
+	spin_lock_bh(&ppe_lock);
+	__mtk_foe_entry_clear(ppe, entry, true);
+	hlist_del_init(&entry->list);
+	*packets = entry->prev_packets - entry->packets;
+	*bytes = entry->prev_bytes - entry->bytes;
+	entry->packets = entry->prev_packets;
+	entry->bytes = entry->prev_bytes;
+	spin_unlock_bh(&ppe_lock);
+}
