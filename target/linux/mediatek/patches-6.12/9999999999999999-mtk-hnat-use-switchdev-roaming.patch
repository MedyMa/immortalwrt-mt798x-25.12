-static void hnat_roam_handler(struct work_struct *work)
-{
-	struct kvec iov;
-	struct msghdr msg;
-	struct nlmsghdr *nlh;
-	struct ndmsg *ndm;
-	struct nlattr *nla;
-	u8 rcv_buf[512];
