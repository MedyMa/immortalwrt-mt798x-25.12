-	return ret;
-}
-
-static void hnat_roaming_disable(void)
-{
-	WRITE_ONCE(_hnat_roam_stopping, true);
-	cancel_delayed_work_sync(&_hnat_roam_work);
-	if (_hnat_roam_sock)
