#include <arpa/inet.h>
#include <assert.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <linux/ip.h>

struct sk_buff {
	unsigned char data[96];
	unsigned int len, linear;
	int offset;
};

static int skb_network_offset(const struct sk_buff *skb) { return skb->offset; }
static bool ip_is_fragment(const struct iphdr *ip)
{
	return ntohs(ip->frag_off) & 0x3fff;
}
static const void *skb_header_pointer(const struct sk_buff *skb, int offset,
				    int len, void *copy)
{
	if (offset < 0 || (unsigned int)offset > skb->len ||
	    (unsigned int)len > skb->len - (unsigned int)offset)
		return NULL;
	if ((unsigned int)(offset + len) <= skb->linear)
		return skb->data + offset;
	memcpy(copy, skb->data + offset, len);
	return copy;
}

@CANDIDATE@

static void packet(struct sk_buff *skb, unsigned char protocol, int offset,
		   unsigned int linear, unsigned short source, unsigned short dest)
{
	struct iphdr ip = { .version = 4, .ihl = 5, .protocol = protocol };
	unsigned short ports[] = { htons(source), htons(dest) };

	memset(skb, 0, sizeof(*skb));
	memcpy(skb->data + offset, &ip, sizeof(ip));
	memcpy(skb->data + offset + sizeof(ip), ports, sizeof(ports));
	skb->len = offset + sizeof(ip) + sizeof(ports);
	skb->linear = linear;
	skb->offset = offset;
}

static void expect(struct sk_buff *skb, bool candidate)
{
	struct sk_buff before = *skb;

	assert(mtk_npu_tunnel_candidate(skb) == candidate);
	assert(!memcmp(skb, &before, sizeof(*skb)));
}

int main(void)
{
	struct sk_buff skb;
	unsigned int i, linear, len;
	int offset;

	for (offset = 0; offset <= 15; offset++) {
		for (linear = 0; linear < 64; linear++) {
			packet(&skb, IPPROTO_TCP, offset, linear, 1701, 4789);
			expect(&skb, false);
			packet(&skb, IPPROTO_UDP, offset, linear, 50000, 53);
			expect(&skb, false);
			packet(&skb, IPPROTO_GRE, offset, linear, 0, 0);
			expect(&skb, true);
			packet(&skb, IPPROTO_UDP, offset, linear, 52000, 4789);
			expect(&skb, true);
			packet(&skb, IPPROTO_UDP, offset, linear, 1701, 1701);
			expect(&skb, true);
			packet(&skb, IPPROTO_UDP, offset, linear, 52000, 1701);
			expect(&skb, false);
		}
	}
	packet(&skb, IPPROTO_UDP, 0, 0, 1701, 1701);
	for (len = 0; len < sizeof(struct iphdr) + 4; len++) {
		skb.len = len;
		expect(&skb, false);
	}
	packet(&skb, IPPROTO_GRE, 0, 0, 0, 0);
	skb.offset = -1;
	expect(&skb, false);
	skb.offset = 95;
	expect(&skb, false);
	for (i = 0; i < 4; i++) {
		struct iphdr ip;

		packet(&skb, IPPROTO_GRE, 0, 0, 0, 0);
		memcpy(&ip, skb.data, sizeof(ip));
		if (i == 0) ip.ihl = 4;
		if (i == 1) ip.ihl = 6;
		if (i == 2) ip.version = 6;
		if (i == 3) ip.frag_off = htons(0x2000);
		memcpy(skb.data, &ip, sizeof(ip));
		expect(&skb, false);
	}
	puts("PASS: actual read-only tunnel prefilter, linear/nonlinear headers, ports, fragments, malformed/truncated input");
	return 0;
}
