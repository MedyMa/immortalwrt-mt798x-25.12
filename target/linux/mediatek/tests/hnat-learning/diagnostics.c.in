#include <assert.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <limits.h>

typedef uint8_t u8;
typedef uint16_t u16;
typedef uint32_t u32;
typedef uint64_t u64;
#define __force
#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
#define BITS_PER_LONG (sizeof(unsigned long) * 8)
#define BIT_WORD(n) ((n) / BITS_PER_LONG)
#define BIT_MASK(n) (1UL << ((n) % BITS_PER_LONG))
#define DECLARE_BITMAP(n, b) unsigned long n[((b) + BITS_PER_LONG - 1) / BITS_PER_LONG]
#define READ_ONCE(x) (x)
#define WRITE_ONCE(x, v) ((x) = (v))
#define time_before(a, b) ((long)((a) - (b)) < 0)
#define msecs_to_jiffies(x) (x)
#define ktime_get() ((u64)jiffies)
#define ktime_to_ms(x) (x)
#define HNAT_DIAG_ENTRIES 32
#define HNAT_DIAG_MAX_AGE_MS 60000
#define HNAT_DIAG_HINT_BITS 256
#define HNAT_DIAG_PREFILL 23
#define HNAT_DIAG_BOUND 24
#define IP_CT_DIR_ORIGINAL 0
#define CTINFO2DIR(info) ((info) & 1)

struct nf_conntrack_zone { u16 id; u8 dir, flags; };
struct net { struct { u32 inum; } ns; };
struct nf_conntrack_tuple {
	struct { union { u32 ip; } u3; } src, dst;
};
struct nf_conn {
	u32 id;
	bool template;
	struct net net;
	struct nf_conntrack_zone zone;
	struct { struct nf_conntrack_tuple tuple; } tuplehash[2];
};
struct hnat_diag_key {
	struct nf_conntrack_tuple tuple;
	u32 ct_id, netns;
	u16 zone;
	u8 direction, zone_dir, zone_flags;
	bool tracked;
};
struct hnat_diag_row {
	struct hnat_diag_key key;
	u64 seen_ms, events, tunnel_generation, foe_generation;
	u32 ppe, slot, reason;
	int candidate_ppe, candidate_slot, tunnel, classifier, error;
	char function[48];
	u32 line, npu_reason;
	int npu_error;
	bool npu_observed;
	u8 paths;
	bool used, linked;
};
struct foe_entry { bool npu; };
static struct hnat_diag_row diag_rows[HNAT_DIAG_ENTRIES];
static bool flow_diagnostics = true, diag_has_rows;
static unsigned long diag_active_until, jiffies;
static DECLARE_BITMAP(diag_hint, HNAT_DIAG_HINT_BITS);
static unsigned int locks;
#define spin_lock_irqsave(lock, flags) do { (void)(lock); (flags) = 0; locks++; } while (0)
#define spin_unlock_irqrestore(lock, flags) do { (void)(lock); (void)(flags); } while (0)
static int diag_lock;
static void __set_bit(unsigned int n, unsigned long *bitmap)
{
	bitmap[BIT_WORD(n)] |= BIT_MASK(n);
}
static u32 hash_32(u32 value, unsigned int bits)
{
	return (value * UINT32_C(0x61c88647)) >> (32 - bits);
}
static const struct nf_conntrack_zone *nf_ct_zone(struct nf_conn *ct) { return &ct->zone; }
static u32 nf_ct_get_id(struct nf_conn *ct) { return ct->id; }
static struct net *nf_ct_net(struct nf_conn *ct) { return &ct->net; }
static bool nf_ct_is_template(struct nf_conn *ct) { return ct->template; }
static bool nf_ct_tuple_equal(const struct nf_conntrack_tuple *a, const struct nf_conntrack_tuple *b)
{
	return !memcmp(a, b, sizeof(*a));
}
static bool hnat_diag_npu_entry(const struct foe_entry *entry) { return entry->npu; }
#define strscpy(dst, src, size) snprintf(dst, size, "%s", src)

@FUNCTIONS@

static struct nf_conn connection(u32 id)
{
	struct nf_conn ct = { .id = id, .net.ns.inum = 1, .zone.id = 7 };

	ct.tuplehash[0].tuple.src.u3.ip = 0x01020304;
	ct.tuplehash[0].tuple.dst.u3.ip = id;
	return ct;
}

int main(void)
{
	struct foe_entry normal = { false }, npu = { true };
	struct nf_conn tunnel = connection(100), ordinary = connection(200);
	struct hnat_diag_key key = {}, other = {};
	struct hnat_diag_row *row;
	unsigned int i, before;
	u64 events;

	jiffies = 1000;
	hnat_diag_bind(&ordinary, 0, 0, 1, 1, &normal, false);
	assert(locks == 0 && !diag_has_rows);
	hnat_diag_bind(&tunnel, 0, 1, 3, 8, &npu, true);
	assert(locks == 1 && diag_rows_live());
	diag_ct_key(&key, &tunnel, 0);
	row = diag_row(&key, false);
	assert(row && row->foe_generation == 8 && row->reason == HNAT_DIAG_PREFILL);
	assert(diag_hint_matches(&key));
	while (true) {
		diag_ct_key(&other, &ordinary, 0);
		if (!diag_hint_matches(&other)) break;
		ordinary.id++;
	}
	before = locks;
	hnat_diag_bind(&ordinary, 0, 0, 2, 1, &normal, false);
	assert(locks == before);
	hnat_diag_bind(&tunnel, 0, 1, 3, 8, &normal, false);
	assert(locks == before + 1 && row->reason == HNAT_DIAG_BOUND);
	events = row->events;
	/* A hash collision may take the lock but must not alter another CT. */
	do {
		ordinary.id++;
		diag_ct_key(&other, &ordinary, 0);
	} while (diag_hint_index(&other) != diag_hint_index(&key));
	hnat_diag_bind(&ordinary, 0, 0, 2, 1, &normal, false);
	assert(row->events == events && !diag_row(&other, false));
	jiffies += HNAT_DIAG_MAX_AGE_MS + 1;
	before = locks;
	hnat_diag_bind(&tunnel, 0, 1, 3, 8, &normal, false);
	assert(locks == before && !diag_rows_live());
	flow_diagnostics = false;
	hnat_diag_bind(&tunnel, 0, 1, 3, 8, &npu, false);
	assert(locks == before);
	flow_diagnostics = true;
	for (i = 0; i < 200; i++) {
		struct nf_conn ct = connection(i + 500);
		unsigned int j;

		jiffies++;
		hnat_diag_bind(&ct, 0, i % 3, i, i + 1, &npu, false);
		for (j = 0; j < HNAT_DIAG_ENTRIES; j++)
			if (diag_rows[j].used) assert(diag_hint_matches(&diag_rows[j].key));
	}
	jiffies = ULONG_MAX - 500;
	diag_touch(&diag_rows[0]);
	assert(diag_rows_live());
	jiffies += 60001;
	assert(!diag_rows_live());
	puts("PASS: actual diagnostic collection, empty/expired/disabled fast paths, CT hash collisions, record replacement and clock wrap");
	return 0;
}
