From: MedyMa maintainers
Subject: [PATCH] wapp: copy the default interface including its terminator

Copy the complete literal into the interface buffer; avoid a truncating strncpy.

--- a/common/main.c
+++ b/common/main.c
@@ -180,8 +180,7 @@
 	}
 
 	if (strlen(iface) == 0) {
-		os_strncpy(iface, DEFAULT_IFNAME, sizeof(DEFAULT_IFNAME)-1);
-		iface[sizeof(DEFAULT_IFNAME)-1] = '\0';
+		os_memcpy(iface, DEFAULT_IFNAME, sizeof(DEFAULT_IFNAME));
 		notice(DEBUG_CAT_INIT, "Default interface=%s\n", iface);
 	} else {
 		notice(DEBUG_CAT_INIT, "Interface=%s\n", iface);
