From: MedyMa maintainers
Subject: [PATCH] wapp: integrate dynamic MAP BSSes with mtwifi-cfg

Use the source-owned adapter for PHY resolution, new BSS configuration and
learned credentials. Keep the SDK path when the adapter is not installed.

--- a/common/driver_nl80211.c
+++ b/common/driver_nl80211.c
@@ -7285,6 +7285,10 @@
 	}
 	notice(DEBUG_CAT_NL80211, "ifname %s, prim %s", ifname, ifname_prim);
 
+	/* The mtwifi-cfg adapter resolves the registered PHY and persists new BSSes. */
+	if (access("/usr/libexec/mtk-easymesh", X_OK) == 0)
+		return os_execute("/usr/libexec/mtk-easymesh", 2, "add-bss", ifname) == 0 ? 0 : -1;
+
 #ifdef EM_PLUS_SUPPORT
 	char ifname_pri[32]  = {0};
 	int res = 0;
@@ -7876,6 +7880,10 @@
 		err(DEBUG_CAT_NL80211, "wpactrl_cmd_config_update failed\n");
 		return ret;
 	}
+
+	if (access("/usr/libexec/mtk-easymesh", X_OK) == 0 &&
+	    os_execute("/usr/libexec/mtk-easymesh", 2, "save-ap", ifname) != 0)
+		return -1;
 
 	return 0;
 }
--- a/common/wdev.c
+++ b/common/wdev.c
@@ -2301,6 +2301,11 @@
 
 	if (wapp->map && wapp->map->TurnKeyEnable && wps_cred_len != 0) {
 		int ret = 0;
+		if (access("/usr/libexec/mtk-easymesh", X_OK) == 0) {
+			if (os_execute("/usr/libexec/mtk-easymesh", 2, "wps-profile", ifname) == 0)
+				map_wps_conf_done_send_map_renew(wapp);
+			return;
+		}
 		char config_name[16] = {0};
 		char value[16] = {0};
 		int index;
