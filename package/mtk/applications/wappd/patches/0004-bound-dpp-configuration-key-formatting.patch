From: MedyMa maintainers
Subject: [PATCH] wapp: bound DPP configuration key formatting

Format interface-plus-suffix keys into the actual destination size. This
avoids the source-length strncat bounds rejected by modern GCC.

--- a/dpp/dpp_wdev.c
+++ b/dpp/dpp_wdev.c
@@ -7914,8 +7914,7 @@
 
 	auth->akm = DPP_AKM_DPP;
 	NdisZeroMemory(ifparam, 50);
-	strncat(ifparam, wdev->ifname, strlen(wdev->ifname));
-	strncat(ifparam, "_connector", strlen("_connector"));
+	os_snprintf(ifparam, sizeof(ifparam), "%s_connector", wdev->ifname);
 	buf = kvc_get(dat_ctx, (const char *)ifparam);
 	if (!buf) {
 		err(DEBUG_CAT_DPP, "%s %d Buf is null from kvc_get\n", __func__, __LINE__);
@@ -7924,8 +7923,7 @@
 	auth->connector = os_strdup(buf);
 
