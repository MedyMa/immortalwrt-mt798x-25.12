msgstr "无线端口回流（Hairpin）"

msgid "It is primarily designed to address the issue of inability to communicate directly between clients within the same WiFi network."
msgstr "主要用于解决同一 WiFi 下，客户端之间无法直接通信的问题。"

msgid "Multi-Link Operation (MLO), enables simultaneous use of multiple radio links for improved performance and reliability."
msgstr "多链路操作（MLO）使得可以同时使用多个无线链路，从而提高性能和可靠性。"

msgid "MWDS feature, used to process those 4-addr of connected APClient or STA."
msgstr "MWDS功能，用于处理已连接的 AP 客户端或 STA 的4地址帧。"

msgid "VLAN ID"
msgstr "VLAN ID"

msgid "VLAN ID for bridge VLAN filtering. Set this to match your network VLAN configuration. Common values: 7 (guest), 70 (IoT), 73 (corporate), 74 (lab)."
msgstr "用于网桥 VLAN 过滤的 VLAN ID。请将其设置为与您的网络 VLAN 配置相匹配。常见值：7（访客）、70（物联网）、73（企业）、74（实验室）。"

msgid "VLAN ID must be between 1 and 4094"
msgstr "VLAN ID 必须介于1 和 4094 之间"

msgid "Another MLO operation is in progress"
msgstr "另一个 MLO 操作正在进行"

msgid "Select two or three access points"
msgstr "请选择两个或三个无线接口"

msgid "The selected access point is no longer available"
msgstr "所选无线接口已不可用"

msgid "MLO is only available for supported vendor EHT access points"
msgstr "MLO 仅支持兼容的厂商 EHT AP"

msgid "Select no more than one access point per radio"
msgstr "每个射频最多选择一个无线接口"

msgid "An access point already belongs to another MLO group"
msgstr "所选无线接口已属于其他 MLO 组"

