msgstr "请输入有效的无线名称"

msgid "No MLO group number is available"
msgstr "没有可用的 MLO 组"

msgid "No MLO group is available; close an existing group first."
msgstr "没有可用的 MLO 组；请先关闭现有组。"

msgid "This driver supports one MLO group; close it before creating another."
msgstr "当前驱动仅支持一个 MLO 组；如需新建，请先关闭现有组。"

msgid "Settings changed outside this page; review them before continuing"
msgstr "设置已在其他位置更改，请检查后再继续"

msgid "MLO recovery data is damaged; do not overwrite it"
msgstr "MLO 恢复数据已损坏，请勿覆盖"

msgid "Could not save MLO recovery data"
msgstr "无法保存 MLO 恢复数据"

msgid "Applying failed. Check the recovery status before retrying"
msgstr "应用失败，请检查恢复状态后再重试"

msgid "Recovery failed; use the recovery action again after checking the settings"
msgstr "恢复失败，请检查设置后再次尝试恢复"

msgid "Wireless reload failed; the saved configuration needs attention"
msgstr "无线重载失败，已保存的配置需要检查"

msgid "Wireless settings have not been confirmed; recovery remains available for retry."
msgstr "无线设置尚未确认应用，恢复记录会保留以便重试。"

msgid "Settings changed outside this page; recovery was stopped"
msgstr "检测到其他位置的设置变更，已停止恢复"

