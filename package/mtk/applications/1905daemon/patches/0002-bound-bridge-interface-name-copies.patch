From: MedyMa maintainers
Subject: [PATCH] 1905: bound bridge interface-name copies

Use destination sizes and explicit termination when handling LAN ports.

--- a/ethernet/common/bridge_parse.c
+++ b/ethernet/common/bridge_parse.c
@@ -186,7 +186,7 @@
 		}
 		if (os_strlen(token) >= IFNAMSIZ)
 			goto end;
-		os_strncpy(inf[lan_cnt].if_name, token, os_strlen(token));
+		os_strlcpy(inf[lan_cnt].if_name, token, sizeof(inf[lan_cnt].if_name));
 		inf[lan_cnt].if_name[IFNAMSIZ - 1] = '\0';
 		token = strtok(NULL, " ");
 		lan_cnt++;
@@ -289,7 +289,7 @@
 					warn(DEBUG_CAT_INIT, "br_lan name size error %s\n", token);
 					continue;
 				}
-				os_strncpy(br_lan, token, os_strlen(token));
+				os_strlcpy(br_lan, token, sizeof(br_lan));
 				br_lan[IFNAMSIZ - 1] = '\0';
 			}  else if (os_strcmp(token, "ext_phy_port") == 0) {
 				token = strtok(NULL, "");
@@ -845,7 +845,7 @@
 	for (i = 0; i < MAX_INF_NUM; i++) {
 		if (inf[i].valid && inf[i].real_index == index) {
 			os_memset(&ifr, 0, sizeof(ifr));
-			os_strncpy(ifr.ifr_name, inf[i].if_name, os_strlen(inf[i].if_name));
+			os_strlcpy(ifr.ifr_name, inf[i].if_name, sizeof(ifr.ifr_name));
 			ifr.ifr_name[IFNAMSIZ - 1] = '\0';
 			if (ioctl(sk_fd, SIOCGIFFLAGS, &ifr) < 0) {
 				warn(DEBUG_CAT_INIT, "ioctl error %d(%s) on %s\n", errno, strerror(errno), ifr.ifr_name);
