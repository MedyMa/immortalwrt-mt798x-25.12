From: MedyMa maintainers
Subject: [PATCH] mapd: expose the radio lookup required by the R3 core

The supplied MAP core archive calls find_radio_db_ruid with MAP R3 and
MLO enabled. The helper uses common topology fields and must not be
limited to the MAP R6 event path. Keep that event handler R6-only.

--- a/src/dot11_if/wapp_if.c
+++ b/src/dot11_if/wapp_if.c
@@ -2864,7 +2864,7 @@
 		os_free(timeout_ctx);
 }
 
-#ifdef MAP_R6
+#if defined(MAP_R6) || defined(SUPPORT_MULTI_AP)
 struct radio_info_db *find_radio_db_ruid(struct _1905_map_device *dev,
 		unsigned char *ruid)
 {
@@ -2879,7 +2879,9 @@
 	}
 	return NULL;
 }
-
+#endif
+
+#ifdef MAP_R6
 void wlanif_handle_bsta_mlo_config(void *eloop_ctx, void *timeout_ctx)
 {
 	struct mapd_global *global = (struct mapd_global *) eloop_ctx;
--- a/src/dot11_if/wapp_if.h
+++ b/src/dot11_if/wapp_if.h
@@ -295,7 +295,7 @@
 void handle_beacon_query_mutil_info(struct mapd_global *ctx, unsigned char *cli_mac);
 #endif
 void wlanif_handle_mld_traffic_stats(void *eloop_ctx, void *timeout_ctx);
-#ifdef MAP_R6
+#if defined(MAP_R6) || defined(SUPPORT_MULTI_AP)
 struct radio_info_db *find_radio_db_ruid(struct _1905_map_device *dev, unsigned char *ruid);
 #endif
 
