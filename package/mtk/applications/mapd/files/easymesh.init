#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# netifd owns radio, bridge, addressing and DHCP configuration.
START=85
STOP=15
USE_PROCD=1

start_service() {
	/usr/libexec/mtk-easymesh configure
	local result=$?
	if [ "$result" = 2 ]; then
		# netifd calls reload after completing radio setup.
		/sbin/wifi reload
		return $?
	fi
	[ "$result" = 0 ] || return 1
	[ "$(uci -q get mapd.mapd_cfg.enable)" = 1 ] || return 0
	/usr/libexec/mtk-easymesh prepare || return 1
	/etc/init.d/wapp stop
	local daemon
	for daemon in wapp p1905 mapd; do
		procd_open_instance "$daemon"
		procd_set_param command /usr/libexec/mtk-easymesh run "$daemon"
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param term_timeout 10
		procd_set_param file /var/run/easymesh/platform.json
		procd_close_instance
	done
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger mapd 1905d_cfg wireless
	procd_add_interface_trigger "interface.*" "$(uci -q get mapd.mapd_cfg.network || echo lan)" /etc/init.d/easymesh reload
}
