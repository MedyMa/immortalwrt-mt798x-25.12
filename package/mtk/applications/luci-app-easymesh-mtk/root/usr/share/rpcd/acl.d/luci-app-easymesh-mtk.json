{
	"luci-app-easymesh-mtk": {
		"description": "Grant access to the MediaTek EasyMesh (MAP Turnkey) control interface",
		"read": {
			"ubus": {
				"easymesh-mtk": [
					"get_status",
					"get_clients",
					"get_interfaces"
				]
			},
			"uci": [
				"mapd",
				"1905d_cfg",
				"wireless"
			]
		},
		"write": {
			"ubus": {
				"easymesh-mtk": [
					"get_uri",
					"set",
					"action",
					"restart",
					"enable",
					"disable"
				]
			},
			"uci": [
				"mapd",
				"1905d_cfg",
				"wireless"
			]
		}
	}
}
