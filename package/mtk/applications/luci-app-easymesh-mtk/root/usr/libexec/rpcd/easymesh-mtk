#!/usr/bin/lua
-- SPDX-License-Identifier: GPL-2.0-only
-- rpcd exec supplies business parameters as JSON on stdin.
local mesh = require "mtk.easymesh"
local uci = require "uci"
local fs = require "nixio.fs"
local json = mesh.json
local methods = {
	get_status = {}, get_clients = {}, get_interfaces = {}, get_uri = { ifname = "" },
	set = { key = "", value = "" }, action = { action = "", band = "", uri = "" },
	restart = {}, enable = {}, disable = {}
}

if arg[1] == "list" then io.write(json.encode(methods)); os.exit(0) end
local c = uci.cursor()
local function service(action)
	local ok, output = mesh.exec({ "/etc/init.d/easymesh", action }, 10)
	assert(ok, output ~= "" and output or "EasyMesh service operation failed")
end
local function enabled()
	return c:get("mapd", "mapd_cfg", "enable") == "1"
end
local function daemon(name)
	return mesh.exec({ "/usr/bin/pgrep", "-x", name }, 1) and "running" or "stopped"
end
local function status()
	local state = mesh.read_json(mesh.state_path) or {}
	local role = c:get("mapd", "mapd_cfg", "DeviceRole") or "2"
	local result = { ok = true, enable = enabled() and "1" or "0", role = role,
		map_ver = c:get("1905d_cfg", "map", "map_ver") or "R3", almac = state.almac or "", bridge = state.bridge or "",
		mapd = daemon("mapd"), p1905 = daemon("p1905_managerd"), wapp = daemon("wapp"),
		socket = fs.stat("/tmp/mapd_ctrl", "type") == "sock" and "up" or "down",
		svc_enabled = mesh.exec({ "/etc/init.d/easymesh", "enabled" }, 1) and "1" or "0",
		mapd_log = fs.readfile("/var/run/easymesh/error") or "", dpp_role = ({ ["0"] = "0", ["1"] = "2", ["2"] = "1" })[role] }
	result.running = enabled() and result.mapd == "running" and result.p1905 == "running" and result.wapp == "running" and result.socket == "up"
	if result.socket == "up" then
		local ok, output = mesh.exec({ "/usr/bin/mapd_cli", "/tmp/mapd_ctrl", "show_bh_link_metric" }, 2)
		result.bh_status = ok and output or ""
		ok, output = mesh.exec({ "/usr/bin/mapd_cli", "/tmp/mapd_ctrl", "dump_topology_v1" }, 2)
		result.topology = ok and output or ""
	end
	return result
end
local function active_aps(band)
	local result = {}
	for _, iface in ipairs(mesh.interfaces()) do
		if iface.active and iface.mode == "ap" and iface.map_mode == "1" and
			(not band or band == "" or band == "all" or band == iface.band) then result[#result + 1] = iface end
	end
	return result
end
local function command(argv)
	local ok, output = mesh.exec(argv, 4)
	assert(ok and not output:match("FAIL") and not output:match("[Ee]rror") and not output:match("[Cc]an't connect"),
		output ~= "" and output or "control command failed")
	return output
end
local function set_enabled(value)
	c:set("mapd", "mapd_cfg", "enable", value)
	c:delete("mapd", "mapd_cfg", "Enable")
	c:foreach("wireless", "wifi-device", function(radio)
		if radio.type == "mtwifi" then c:set("wireless", radio[".name"], "map_mode", value) end
	end)
	c:commit("mapd")
	c:commit("wireless")
	service(value == "1" and "enable" or "disable")
	service("stop")
	local ok, output = mesh.exec({ "/sbin/wifi", "reload" }, 8)
	assert(ok, output ~= "" and output or "wireless reload failed")
	return { ok = true, pending = true }
end
local booleans = { SteerEnable = true, ChPlanningEnable = true, NetworkOptimizationEnabled = true, AutoBHSwitching = true,
	DhcpCtl = true, NetworkOptPrefer5Gover2G = true, NetOptUserSetPriority = true, NtwrkOptMldBhPriority = true }
local integers = { NtwrkOptConnectWaitTime = true, NtwrkOptDisconnectWaitTime = true, NtwrkOptPostCACTriggerTime = true,
	BandSwitchTime = true, NetworkOptPrefer5Gover2GRetryCnt = true, ChPlanningIdleTime = true, ChPlanningIdleByteCount = true }
local function set_option(params)
	assert(type(params.key) == "string", "missing key")
	local key, value = params.key, mesh.scalar(params.value)
	if key == "Enable" or key == "enable" then
		assert(value == "0" or value == "1", "invalid enable value")
		return set_enabled(value)
	end
	local config, section = "mapd", "mapd_cfg"
	local number, valid = tonumber(value), false
	if key == "DeviceRole" then valid = value == "0" or value == "1" or value == "2"
	elseif booleans[key] then valid = value == "0" or value == "1"
	elseif integers[key] then valid = number and number >= 0 and number <= 2147483647 and number % 1 == 0
	elseif key == "APSteerRssiTh" then valid = number and number >= -100 and number <= -20 and number % 1 == 0
	elseif ({ BhPriority2G = true, BhPriority5GL = true, BhPriority5GH = true, BhPriority6G = true })[key] then
		valid = number and number >= 0 and number <= 3 and number % 1 == 0
	elseif ({ CUOverloadTh_2G = true, CUOverloadTh_5G_L = true, CUOverloadTh_5G_H = true, CUOverloadTh_6G = true })[key] then
		valid = number and number >= 1 and number <= 100 and number % 1 == 0
	elseif ({ ChPlanningUserPreferredChannel2G = true, ChPlanningUserPreferredChannel5G = true, ChPlanningUserPreferredChannel6G = true })[key] then
		local min = key:match("5G$") and 36 or 1
		local max = key:match("2G$") and 14 or key:match("5G$") and 177 or 233
		valid = value == "" or number and number >= min and number <= max and number % 1 == 0
	elseif key == "map_ver" then
		config, section = "1905d_cfg", "map"
		valid = value == "R1" or value == "R2" or value == "R3"
	elseif key == "presence_band_priority" then
		section = "dpp_cfg"
		valid = value == "2g" or value == "5g" or value == "6g"
	end
	assert(valid, "unsupported option or invalid value")
	assert(c:set(config, section, key, value), "cannot save configuration")
	if key == "DeviceRole" then c:set("mapd", "dpp_cfg", "allowed_role", ({ ["0"] = "0", ["1"] = "2", ["2"] = "1" })[value]) end
	assert(c:commit(config), "cannot commit configuration")
	return { ok = true, restart_required = true }
end
local function get_uri(params)
	local aps, name = active_aps(), params.ifname
	assert(#aps > 0, "no active MAP interface")
	assert(c:get("1905d_cfg", "map", "map_ver") == "R3", "DPP requires MAP R3")
	if name and name ~= "" then
		local found = false
		for _, iface in ipairs(aps) do if iface.ifname == name then found = true end end
		assert(found, "interface is not an active MAP AP")
	else name = aps[1].ifname end
	if c:get("mapd", "mapd_cfg", "DeviceRole") ~= "1" then
		command({ "/usr/bin/wappctrl", name, "dpp", "dpp_onboard_type", "type=1" })
		command({ "/usr/bin/wappctrl", name, "dpp", "dpp_start" })
	end
	local output = command({ "/usr/bin/mapd_cli", "/tmp/mapd_ctrl", "get_dpp_uri" })
	local uri = output:match("(DPP:[^\r\n]+)")
	assert(uri, "DPP URI is not available; check MAP R3 and the agent role")
	return { ok = true, uri = uri, ifname = name }
end
local function action(params)
	assert(enabled(), "EasyMesh is disabled")
	if params.action == "wps" then
		assert(params.band == nil or ({ [""] = true, all = true, ["2g"] = true, ["5g"] = true })[params.band], "invalid WPS band")
		local names, seen = {}, {}
		for _, iface in ipairs(active_aps(params.band)) do
			if iface.band ~= "6g" and not seen[iface.device] then
				if c:get("1905d_cfg", "map", "map_ver") == "R3" then
					command({ "/usr/bin/wappctrl", iface.ifname, "dpp", "dpp_onboard_type", "type=0" })
				end
				command({ "/usr/bin/wappctrl", iface.ifname, "wps_pbc" })
				names[#names + 1] = iface.ifname
				seen[iface.device] = true
			end
		end
		assert(#names > 0, "no active 2.4/5 GHz MAP interface")
		return { ok = true, ifname = table.concat(names, " "), accepted = true }
	elseif params.action == "dpp_enroll" then
		assert(c:get("mapd", "mapd_cfg", "DeviceRole") == "1", "add the agent URI on the controller")
		assert(c:get("1905d_cfg", "map", "map_ver") == "R3", "DPP requires MAP R3")
		local uri = mesh.scalar(params.uri)
		assert(uri:match("^DPP:") and #uri <= 2048 and uri:find(";K:"), "invalid DPP URI")
		local aps = active_aps()
		assert(#aps > 0, "no active MAP AP")
		command({ "/usr/bin/wappctrl", aps[1].ifname, "dpp", "dpp_qr_code", uri })
		return { ok = true, accepted = true }
	end
	error("unknown onboarding action")
end
local function clients()
	local result, leases = {}, {}
	for line in (fs.readfile("/tmp/dhcp.leases") or ""):gmatch("[^\r\n]+") do
		local mac, ip, name = line:match("^%S+%s+(%S+)%s+(%S+)%s+(%S+)")
		if mac then leases[mac:lower()] = { ip = ip, hostname = name ~= "*" and name or "" } end
	end
	for _, iface in ipairs(mesh.interfaces()) do
		if iface.active and iface.mode == "ap" then
			local ok, output = mesh.exec({ "/usr/sbin/iw", "dev", iface.ifname, "station", "dump" }, 2)
			assert(ok, "cannot read associated stations on " .. iface.ifname)
			if ok then
				local station
				for line in (output .. "\n"):gmatch("([^\n]*)\n") do
					local mac = line:match("^Station (%x%x:%x%x:%x%x:%x%x:%x%x:%x%x)")
					if mac then
						station = { mac = mac:lower(), iface = iface.ifname, band = iface.band == "2g" and "2.4G" or iface.band:upper(),
							signal = "", rx_rate = "", tx_rate = "", is_mlo = "Unknown", is_backhaul = "Unknown" }
						local lease = leases[station.mac] or {}
						station.hostname, station.ip = lease.hostname or "", lease.ip or ""
						result[#result + 1] = station
					elseif station then
						station.signal = line:match("^%s*signal:%s*(-?%d+)") or station.signal
						station.rx_rate = line:match("^%s*rx bitrate:%s*([%d.]+)") or station.rx_rate
						station.tx_rate = line:match("^%s*tx bitrate:%s*([%d.]+)") or station.tx_rate
						local mld = line:match("[Mm][Ll][Dd]") and line:match("(%x%x:%x%x:%x%x:%x%x:%x%x:%x%x)")
						if mld and mesh.mac(mld) and mld ~= "00:00:00:00:00:00" then station.is_mlo, station.mld_mac = "Yes", mld end
					end
				end
			end
		end
	end
	return { ok = true, clients = result, scope = "local" }
end
local ok, result = pcall(function()
	assert(arg[1] == "call" and methods[arg[2]], "unknown method")
	local params = {}
	if arg[3] ~= nil then
		-- Compatibility for local CLI users of the previous positional helper.
		if arg[2] == "set" then params.key, params.value = arg[3], arg[4]
		elseif arg[2] == "get_uri" then params.ifname = arg[3]
		elseif arg[2] == "action" then params.action = arg[3]; params[arg[3] == "dpp_enroll" and "uri" or "band"] = arg[4]
		end
	elseif next(methods[arg[2]]) then
		local input = io.read(16385) or ""
		assert(#input <= 16384, "request is too large")
		params = json.decode(input ~= "" and input or "{}")
		assert(type(params) == "table", "invalid request")
	end
	for key, value in pairs(params) do assert(methods[arg[2]][key] ~= nil and type(value) == "string", "invalid parameter") end
	if arg[2] == "get_status" then return status()
	elseif arg[2] == "get_clients" then return clients()
	elseif arg[2] == "get_interfaces" then return { ok = true, interfaces = mesh.interfaces() }
	elseif arg[2] == "get_uri" then return get_uri(params)
	elseif arg[2] == "set" then return set_option(params)
	elseif arg[2] == "action" then return action(params)
	elseif arg[2] == "enable" then return set_enabled("1")
	elseif arg[2] == "disable" then return set_enabled("0")
	elseif arg[2] == "restart" then assert(enabled(), "EasyMesh is disabled"); service("restart"); return { ok = true, pending = true }
	end
end)
if not ok then result = { ok = false, error = tostring(result):gsub("^.-:%d+: ", "") } end
-- lua-cjson 2.1 encodes an empty Lua table as {}, so emit arrays explicitly.
if result.clients or result.interfaces then
	local key = result.clients and "clients" or "interfaces"
	local entries = {}
	for _, entry in ipairs(result[key]) do entries[#entries + 1] = json.encode(entry) end
	result[key] = nil
	local output = json.encode(result)
	io.write(output:sub(1, -2), ',"', key, '":[', table.concat(entries, ','), ']}')
else io.write(json.encode(result)) end
io.write("\n")
