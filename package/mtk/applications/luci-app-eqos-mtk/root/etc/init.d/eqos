#!/bin/sh /etc/rc.common
# Copyright (C) 2006 OpenWrt.org

START=95
STOP=05
USE_PROCD=1

QDMA_RATE_MAX=1000000
TOTAL_RATE_MAX=1000

service_error() {
	printf '%s\n' "$*" > /var/run/eqos.error
	logger -t eqos "$*"
	echo "eqos: $*" >&2
}

is_uinteger() {
	[ "${#1}" -le 9 ] || return 1
	case "$1" in
		''|*[!0-9]*|0[0-9]*) return 1 ;;
	esac

	return 0
}

validate_device() {
	local cfg="$1"
	local enabled

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	local ip ip6 queue selector selector_count selector_key
	local download upload
	config_get ip "$cfg" ip
	config_get ip6 "$cfg" ip6
	config_get download "$cfg" download 0
	config_get upload "$cfg" upload 0
	config_get queue "$cfg" queue
	config_get selector "$cfg" selector
	[ -n "$queue" ] || config_get queue "$cfg" comment

	if ! is_uinteger "$queue" || [ "$queue" -lt 1 ] || [ "$queue" -gt 65535 ]; then
		service_error "$cfg queue slot must be between 1 and 65535"
		CONFIG_ERROR=1
		return 0
	fi

	case " $USED_QUEUES " in
		*" $queue "*)
			service_error "queue slot $queue is used by more than one rule"
			CONFIG_ERROR=1
			return 0
			;;
	esac
	USED_QUEUES="${USED_QUEUES}${queue} "

	if ! is_uinteger "$download" || ! is_uinteger "$upload"; then
		service_error "$cfg download and upload rates must be integers"
		CONFIG_ERROR=1
		return 0
	fi

	if [ "$download" -gt "$QDMA_RATE_MAX" ] || [ "$upload" -gt "$QDMA_RATE_MAX" ]; then
		service_error "$cfg download and upload rates must not exceed $QDMA_RATE_MAX kbit/s"
		CONFIG_ERROR=1
		return 0
	fi

	selector_count=0
	[ -z "$ip" ] || selector_count=$((selector_count + 1))
	[ -z "$ip6" ] || selector_count=$((selector_count + 1))

	if [ "$selector_count" -ne 1 ]; then
		service_error "$cfg must set exactly one match field: ip or ip6"
		CONFIG_ERROR=1
		return 0
	fi

	case "$selector" in
		''|ip|ip6) ;;
		*)
			service_error "$cfg selector must be ip or ip6"
			CONFIG_ERROR=1
			return 0
			;;
	esac

	case "$selector" in
		ip)
			if [ -z "$ip" ]; then
				service_error "$cfg selector does not match configured field"
				CONFIG_ERROR=1
				return 0
			fi
			;;
		ip6)
			if [ -z "$ip6" ]; then
				service_error "$cfg selector does not match configured field"
				CONFIG_ERROR=1
				return 0
			fi
			;;
	esac

	if [ -n "$ip" ]; then
		selector_key="ip:$ip"
	else
		selector_key="ip6:$ip6"
	fi

	case "$USED_SELECTORS" in
		*" $selector_key "*)
			service_error "selector $selector_key is used by more than one rule"
			CONFIG_ERROR=1
			return 0
			;;
	esac
	USED_SELECTORS="${USED_SELECTORS}${selector_key} "
	if [ "$download" -ne 0 ] || [ "$upload" -ne 0 ]; then
		ACTIVE_RULES=$((ACTIVE_RULES + 1))
	fi
}

parse_device() {
	local cfg="$1"
	local enabled

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	local ip ip6 address download upload queue total_download total_upload
	config_get ip "$cfg" ip
	config_get ip6 "$cfg" ip6
	config_get download "$cfg" download 0
	config_get upload "$cfg" upload 0
	config_get queue "$cfg" queue
	config_get total_download config download
	config_get total_upload config upload
	[ -n "$queue" ] || config_get queue "$cfg" comment

	address="$ip"
	[ -n "$address" ] || address="$ip6"
	if ! eqos add "$queue" "$download" "$upload" "$address" \
		"$total_download" "$total_upload"; then
		CONFIG_ERROR=1
	fi
}

start_service() {
	exec 9>/var/lock/mtk-hnat.lock
	flock -x 9 || return 1
	export MTK_HNAT_LOCK_HELD=1
	config_load eqos

	local enabled
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || { stop_service; return $?; }

	local download upload
	config_get download config download
	config_get upload config upload

	if ! is_uinteger "$download" || ! is_uinteger "$upload" ||
	   [ "$download" -lt 0 ] || [ "$upload" -lt 0 ] ||
	   [ "$download" -gt "$TOTAL_RATE_MAX" ] || [ "$upload" -gt "$TOTAL_RATE_MAX" ]; then
		service_error "total download and upload rates must be between 0 and $TOTAL_RATE_MAX Mbit/s"
		return 1
	fi

	CONFIG_ERROR=0
	ACTIVE_RULES=0
	USED_QUEUES=" "
	USED_SELECTORS=" "
	config_foreach validate_device device
	[ "$CONFIG_ERROR" -eq 0 ] || return 1

	# Enabling the app without limits must not change PPE or the LAN qdisc.
	if [ "$ACTIVE_RULES" -eq 0 ]; then
		if [ -f /var/run/eqos/mode ]; then eqos stop || return 1; fi
		rm -f /var/run/eqos.error
		return 0
	fi

	rm -f /var/run/eqos.error
	if ! eqos start "$download" "$upload"; then
		[ -s /var/run/eqos.error ] || service_error "failed to prepare EQoS"
		eqos stop >/dev/null 2>&1
		return 1
	fi

	CONFIG_ERROR=0
	config_foreach parse_device device
	if [ "$CONFIG_ERROR" -ne 0 ]; then
		[ -s /var/run/eqos.error ] || service_error "failed to apply device rules"
		eqos stop >/dev/null 2>&1
		return 1
	fi

	if ! eqos enable; then
		[ -s /var/run/eqos.error ] || service_error "failed to activate EQoS"
		eqos stop >/dev/null 2>&1
		return 1
	fi
	touch /var/run/eqos.active
	rm -f /var/run/eqos.error
}

stop_service() {
	if [ "${MTK_HNAT_LOCK_HELD:-0}" != 1 ]; then
		exec 9>/var/lock/mtk-hnat.lock
		flock -x 9 || return 1
		export MTK_HNAT_LOCK_HELD=1
	fi
	local result
	eqos stop
	result=$?
	[ "$result" -ne 0 ] || rm -f /var/run/eqos.error
	return "$result"
}

reload_service() {
	local enabled

	config_load eqos
	config_get_bool enabled config enabled 0
	if [ "$enabled" -eq 1 ]; then
		start_service
	else
		stop_service
	fi
}

service_triggers() {
	procd_add_reload_trigger eqos
}
