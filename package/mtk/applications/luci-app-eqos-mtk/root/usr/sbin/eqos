#!/bin/sh

DEV_DEFAULT="br-lan"
IFB_DEV="ifb-eqos"
HNAT_DIR="/sys/kernel/debug/hnat"
STATE_DIR="/var/run/eqos"
NFT="/usr/sbin/nft"

TABLE_FAMILY="inet"
TABLE_NAME="eqos"
CHAIN_NAME="forward"
HNAT_RESTART_DELAY=3

QDMA_QUEUE_COUNT=64
QDMA_RATE_MAX=1000000
TOTAL_RATE_MAX=1000
UP_SCH=2
DL_SCH=3
UP_QID_BASE=1
DL_QID_BASE=32
QUEUE_SLOTS=31
TC_SLOT_MAX=65535
PPD_QID=63
MANAGED_QID_LAST=62
DEFAULT_QUEUE_CFG="0 0 0 0 0 0 4"

die() {
	printf '%s\n' "$*" > /var/run/eqos.error
	logger -t eqos "$*"
	echo "eqos: $*" >&2
	exit 1
}

is_uinteger() {
	[ "${#1}" -le 9 ] || return 1
	case "$1" in
		''|*[!0-9]*|0[0-9]*) return 1 ;;
	esac

	return 0
}

valid_ipv4() {
	[ -n "$1" ] || return 1

	case "$1" in
		*[!0-9./]*) return 1 ;;
	esac

	return 0
}

valid_ipv6() {
	[ -n "$1" ] || return 1

	case "$1" in
		*[!0-9A-Fa-f:./]*) return 1 ;;
	esac

	return 0
}

need_nft() {
	[ -x "$NFT" ] || die "nftables is not available"
}

need_hnat() {
	[ -d "$HNAT_DIR" ] || insmod mtkhnat 2>/dev/null
	[ -d "$HNAT_DIR" ] || die "HNAT debugfs is not available"
}

write_hnat() {
	local node="$1"
	local value="$2"

	[ -w "$HNAT_DIR/$node" ] || die "$HNAT_DIR/$node is not writable"
	printf '%s' "$value" > "$HNAT_DIR/$node" ||
		die "failed to write $HNAT_DIR/$node"
}

need_qdma_layout() {
	need_hnat

	for node in qdma_sch$UP_SCH qdma_sch$DL_SCH \
		qdma_txq$UP_QID_BASE qdma_txq$DL_QID_BASE qdma_txq$MANAGED_QID_LAST; do
		[ -w "$HNAT_DIR/$node" ] || die "$HNAT_DIR/$node is not writable"
	done

	[ -e "$HNAT_DIR/qdma_txq0" ] ||
		die "qid0 is missing; expected $QDMA_QUEUE_COUNT-QDMA NETSYS layout"
	[ -e "$HNAT_DIR/qdma_txq$PPD_QID" ] ||
		die "qid$PPD_QID is missing; expected PPD-reserved queue"
}

stop_qos() {
	[ -f "$STATE_DIR/tc-owned" ] || return 0
	local dev="$1"
	local have_ifb=0

	[ ! -d "/sys/class/net/$IFB_DEV" ] || have_ifb=1

	if tc qdisc show dev "$dev" 2>/dev/null | grep -q "qdisc htb e100:"; then
		tc qdisc del dev "$dev" root 2>/dev/null
	fi
	[ "$have_ifb" -eq 1 ] || return 0

	tc filter del dev "$dev" parent ffff: protocol ip pref 62010 handle 800::1 u32 2>/dev/null
	tc filter del dev "$dev" parent ffff: protocol ipv6 pref 62011 handle 800::2 u32 2>/dev/null
	if tc qdisc show dev "$dev" 2>/dev/null | grep -q "qdisc ingress ffff:" &&
	   [ -z "$(tc filter show dev "$dev" parent ffff: 2>/dev/null)" ]; then
		tc qdisc del dev "$dev" ingress 2>/dev/null
	fi
	tc qdisc del dev "$IFB_DEV" root 2>/dev/null
	ip link del dev "$IFB_DEV" 2>/dev/null
	rm -f "$STATE_DIR/tc-owned"
}

start_qos() {
	local dev="$1"
	local dl="$2"
	local up="$3"
	local root_qdisc

	[ "$dl" -ne 0 ] || dl=10000
	[ "$up" -ne 0 ] || up=10000

	root_qdisc="$(tc qdisc show dev "$dev" 2>/dev/null | sed -n '/ root /p')"
	case "$root_qdisc" in
		''|qdisc\ noqueue\ 0:*|qdisc\ noop\ 0:*) ;;
		*)
			echo "eqos: $dev already has a root qdisc" >&2
			return 1
			;;
	esac

	if tc qdisc show dev "$dev" 2>/dev/null |
	   grep -Eq 'qdisc (ingress|clsact) '; then
		echo "eqos: $dev already has an ingress qdisc" >&2
		return 1
	fi

	ip link add "$IFB_DEV" type ifb || return 1
	touch "$STATE_DIR/tc-owned"

	if ! ip link set dev "$IFB_DEV" up ||
	   ! tc qdisc add dev "$dev" root handle e100: htb ||
	   ! tc class add dev "$dev" parent e100: classid e100:1 htb rate "${dl}mbit" ||
	   ! tc qdisc add dev "$IFB_DEV" root handle e100: htb ||
	   ! tc class add dev "$IFB_DEV" parent e100: classid e100:1 htb rate "${up}mbit" ||
	   ! tc qdisc add dev "$dev" ingress ||
	   ! tc filter add dev "$dev" parent ffff: protocol ip pref 62010 handle 800::1 u32 \
		match u32 0 0 action mirred egress redirect dev "$IFB_DEV" ||
	   ! tc filter add dev "$dev" parent ffff: protocol ipv6 pref 62011 handle 800::2 u32 \
		match u32 0 0 action mirred egress redirect dev "$IFB_DEV"; then
		stop_qos "$dev"
		return 1
	fi
}

nft_stop() {
	need_nft
	"$NFT" list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1 || return 0
	"$NFT" delete table "$TABLE_FAMILY" "$TABLE_NAME" 2>/dev/null
}

nft_start() {
	need_nft
	: > "$STATE_DIR/pending.nft"
	if "$NFT" list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1; then
		printf 'delete table %s %s\n' "$TABLE_FAMILY" "$TABLE_NAME" >> "$STATE_DIR/pending.nft"
	fi
	cat >> "$STATE_DIR/pending.nft" <<EOF
table $TABLE_FAMILY $TABLE_NAME {
	chain $CHAIN_NAME {
		type filter hook forward priority mangle; policy accept;
	}
}
EOF
}

nft_rule() {
	[ -f "$STATE_DIR/pending.nft" ] || return 1
	printf '%s ' "$@" >> "$STATE_DIR/pending.nft"
	printf '\n' >> "$STATE_DIR/pending.nft"
}

start_hnat_qos() {
	local dl="$1" up="$2"
	need_qdma_layout
	snapshot_qdma || return 1
	write_hnat qos_toggle 1
	write_hnat "qdma_sch$UP_SCH" "$((up > 0)) wrr $((up * 1000))"
	write_hnat "qdma_sch$DL_SCH" "$((dl > 0)) wrr $((dl * 1000))"
}

stop_hnat_qos() {
	[ -f "$STATE_DIR/mode" ] || return 0
	restore_qdma
}

enable_hnat() {
	[ -f "$STATE_DIR/mode" ] || die "EQoS has not acquired QDMA ownership"
	local hook_state

	need_hnat
	hook_state="$(cat "$HNAT_DIR/hook_toggle")"
	[ "$hook_state" = enabled ] ||
		die "enable MediaTek HNAT in network acceleration before applying EQoS"
	if [ -f "$STATE_DIR/pending.nft" ]; then
		"$NFT" -c -f "$STATE_DIR/pending.nft" || die "invalid nftables rules"
		"$NFT" -f "$STATE_DIR/pending.nft" || die "failed to apply nftables rules"
		rm -f "$STATE_DIR/pending.nft"
	fi
	# Existing bindings contain the old QID. Retire them before learning again.
	touch "$STATE_DIR/hook_reset"
	write_hnat "hook_toggle" "0"
	[ "$(cat "$HNAT_DIR/hook_toggle")" = disabled ] || die "failed to disable HNAT hooks"
	sleep "$HNAT_RESTART_DELAY"
	write_hnat "hook_toggle" "1"
	[ "$(cat "$HNAT_DIR/hook_toggle")" = enabled ] || die "failed to enable HNAT hooks"
	rm -f "$STATE_DIR/hook_reset"

}

queue_from_slot() {
	local slot="$1"
	local dir="$2"

	case "$dir" in
		up) echo $((UP_QID_BASE + slot - 1)) ;;
		dl) echo $((DL_QID_BASE + slot - 1)) ;;
	esac
}

tc_classid_from_slot() {
	printf '%x\n' "$1"
}

ensure_tc_qos() {
	local dev="$1"
	local dl="$2"
	local up="$3"

	[ -n "$dl" ] || dl="$(uci -q get eqos.config.download)"
	[ -n "$up" ] || up="$(uci -q get eqos.config.upload)"
	is_uinteger "$dl" || die "download rate must be an integer"
	is_uinteger "$up" || die "upload rate must be an integer"
	[ "$dl" -ge 0 ] || die "download rate must not be negative"
	[ "$up" -ge 0 ] || die "upload rate must not be negative"
	[ "$dl" -le "$TOTAL_RATE_MAX" ] && [ "$up" -le "$TOTAL_RATE_MAX" ] ||
		die "total rate must not exceed $TOTAL_RATE_MAX Mbit/s"

	if [ -f "$STATE_DIR/tc-owned" ] &&
	   tc qdisc show dev "$dev" 2>/dev/null | grep -q "qdisc htb e100:" &&
	   tc qdisc show dev "$IFB_DEV" 2>/dev/null | grep -q "qdisc htb e100:"; then
		return 0
	fi

	stop_qos "$dev"
	start_qos "$dev" 0 0
}

program_queue() {
	local qid="$1"
	local sch="$2"
	local rate="$3"

	[ "$rate" -eq 0 ] && return 0
	local resv
	resv=$(awk '{ print $7 }' "$STATE_DIR/txq$qid")
	[ -n "$resv" ] || return 1
	touch "$STATE_DIR/dirty_txq$qid"
	write_hnat "qdma_txq$qid" "$sch 0 0 1 $rate 4 $resv"
}

tc_filter_rule() {
	local dir="$1"
	local family="$2"
	local value="$3"
	local pref="$4"
	local classid="$5"
	local dev="$6"
	local tcdev key

	[ -n "$value" ] || return 0

	case "$dir" in
		up)
			tcdev="$IFB_DEV"
			key="src"
			;;
		dl)
			tcdev="$dev"
			key="dst"
			;;
		*)
			return 1
			;;
	esac

	case "$family" in
		ip)
			tc filter add dev "$tcdev" parent e100: protocol ip pref "$pref" u32 \
				match ip "$key" "$value" flowid "e100:$classid"
			;;
		ip6)
			tc filter add dev "$tcdev" parent e100: protocol ipv6 pref "$pref" u32 \
				match ip6 "$key" "$value" flowid "e100:$classid"
			;;
		*)
			return 1
			;;
	esac
}

program_tc_queue() {
	local dir="$1"
	local slot="$2"
	local rate="$3"
	local ip4="$4"
	local ip6="$5"
	local dev="$6"
	local classid tcdev

	[ "$rate" -eq 0 ] && return 0
	[ -n "$ip4$ip6" ] ||
		die "software tc queue requires an IPv4 or IPv6 selector"

	case "$dir" in
		up) tcdev="$IFB_DEV" ;;
		dl) tcdev="$dev" ;;
		*) return 1 ;;
	esac

	classid="$(tc_classid_from_slot "$slot")"
	tc class replace dev "$tcdev" parent e100:1 classid "e100:$classid" \
		htb rate "${rate}kbit" ceil "${rate}kbit" || return 1
	tc_filter_rule "$dir" ip "$ip4" "$slot" "$classid" "$dev" || return 1
	tc_filter_rule "$dir" ip6 "$ip6" "$slot" "$classid" "$dev" || return 1
}

nft_mark_rule() {
	local dir="$1"
	local family="$2"
	local value="$3"
	local qid="$4"
	local addr interface_key

	[ -n "$value" ] || return 0

	case "$dir" in
		up) addr="saddr"; interface_key=iifname ;;
		dl) addr="daddr"; interface_key=oifname ;;
		*)
			return 1
			;;
	esac

	case "$family" in
		ip)
			nft_rule add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				$interface_key "$DEV_DEFAULT" \
				ip "$addr" "$value" \
				meta mark '&' 0xffff == 0 \
				meta mark set meta mark '|' "$qid"
			;;
		ip6)
			nft_rule add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				$interface_key "$DEV_DEFAULT" \
				ip6 "$addr" "$value" \
				meta mark '&' 0xffff == 0 \
				meta mark set meta mark '|' "$qid"
			;;
		*)
			return 1
			;;
	esac
}

nft_exception_rule() {
	local dir="$1"
	local family="$2"
	local value="$3"
	local addr interface_key

	[ -n "$value" ] || return 0

	case "$dir" in
		up) addr="saddr"; interface_key=iifname ;;
		dl) addr="daddr"; interface_key=oifname ;;
		*)
			return 1
			;;
	esac

	case "$family" in
		ip)
			nft_rule add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				$interface_key "$DEV_DEFAULT" \
				ip "$addr" "$value" \
				meta mark set meta mark '|' 0x80
			;;
		ip6)
			nft_rule add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				$interface_key "$DEV_DEFAULT" \
				ip6 "$addr" "$value" \
				meta mark set meta mark '|' 0x80
			;;
		*)
			return 1
			;;
	esac
}

add_rule() {
	[ -f "$STATE_DIR/mode" ] && [ -f "$STATE_DIR/pending.nft" ] || die "start EQoS before adding rules"
	local slot="$1"
	local dl="$2"
	local up="$3"
	local ip4="$4"
	local ip6="$5"
	local total_dl="$6"
	local total_up="$7"
	local dev="$DEV_DEFAULT"
	local up_qid dl_qid selector_count

	is_uinteger "$slot" || die "queue slot must be an integer"
	is_uinteger "$dl" || die "download rate must be an integer"
	is_uinteger "$up" || die "upload rate must be an integer"

	[ "$slot" -ge 1 ] && [ "$slot" -le "$TC_SLOT_MAX" ] ||
		die "queue slot must be between 1 and $TC_SLOT_MAX"
	[ "$dl" -le "$QDMA_RATE_MAX" ] && [ "$up" -le "$QDMA_RATE_MAX" ] ||
		die "device rate must not exceed $QDMA_RATE_MAX kbit/s"
	[ -n "$ip4" ] && valid_ipv4 "$ip4" || [ -z "$ip4" ] ||
		die "invalid IPv4 selector"
	[ -n "$ip6" ] && valid_ipv6 "$ip6" || [ -z "$ip6" ] ||
		die "invalid IPv6 selector"

	selector_count=0
	[ -z "$ip4" ] || selector_count=$((selector_count + 1))
	[ -z "$ip6" ] || selector_count=$((selector_count + 1))
	[ "$selector_count" -eq 1 ] ||
		die "exactly one selector is required: IPv4 or IPv6"

	[ "$dl" -ne 0 ] || [ "$up" -ne 0 ] || return 0

	need_nft
	need_qdma_layout

	if [ "$slot" -gt "$QUEUE_SLOTS" ]; then
		ensure_tc_qos "$dev" "$total_dl" "$total_up" || return 1
		program_tc_queue up "$slot" "$up" "$ip4" "$ip6" "$dev" || return 1
		program_tc_queue dl "$slot" "$dl" "$ip4" "$ip6" "$dev" || return 1

		if [ "$up" -ne 0 ]; then
			nft_exception_rule up ip "$ip4" || return 1
			nft_exception_rule up ip6 "$ip6" || return 1
		fi

		if [ "$dl" -ne 0 ]; then
			nft_exception_rule dl ip "$ip4" || return 1
			nft_exception_rule dl ip6 "$ip6" || return 1
		fi

		return 0
	fi

	up_qid="$(queue_from_slot "$slot" up)"
	dl_qid="$(queue_from_slot "$slot" dl)"

	program_queue "$up_qid" "$UP_SCH" "$up" || return 1
	program_queue "$dl_qid" "$DL_SCH" "$dl" || return 1

	if [ "$up" -ne 0 ]; then
		nft_mark_rule up ip "$ip4" "$up_qid" || return 1
		nft_mark_rule up ip6 "$ip6" "$up_qid" || return 1
	fi

	if [ "$dl" -ne 0 ]; then
		nft_mark_rule dl ip "$ip4" "$dl_qid" || return 1
		nft_mark_rule dl ip6 "$ip6" "$dl_qid" || return 1
	fi

}

add_inferred_rule() {
	local slot="$1"
	local dl="$2"
	local up="$3"
	local selector="$4"
	local total_dl="$5"
	local total_up="$6"
	local ip4 ip6

	[ -n "$selector" ] || die "selector is required"

	if valid_ipv4 "$selector"; then
		ip4="$selector"
	elif valid_ipv6 "$selector"; then
		ip6="$selector"
	else
		die "selector must be an IPv4 or IPv6 address"
	fi

	add_rule "$slot" "$dl" "$up" "$ip4" "$ip6" "$total_dl" "$total_up"
}

start_all() {
	local dl="$1"
	local up="$2"
	local dev="$DEV_DEFAULT"

	is_uinteger "$dl" || die "download rate must be an integer"
	is_uinteger "$up" || die "upload rate must be an integer"
	[ "$dl" -ge 0 ] || die "download rate must not be negative"
	[ "$up" -ge 0 ] || die "upload rate must not be negative"
	[ "$dl" -le "$TOTAL_RATE_MAX" ] && [ "$up" -le "$TOTAL_RATE_MAX" ] ||
		die "total rate must not exceed $TOTAL_RATE_MAX Mbit/s"

	need_nft
	need_qdma_layout
	[ "$(cat "$HNAT_DIR/hook_toggle")" = enabled ] ||
		die "MediaTek HNAT hooks are disabled"
	[ ! -f "$STATE_DIR/mode" ] || stop_all || return 1

	start_hnat_qos "$dl" "$up" || die "failed to snapshot QDMA state"
	nft_start "$dev" || die "failed to configure nftables"
}

stop_all() {
	local dev="$DEV_DEFAULT" failed=0
	[ -f "$STATE_DIR/mode" ] || return 0
	stop_qos "$dev" || failed=1
	nft_stop || failed=1
	stop_hnat_qos || failed=1
	[ "$failed" -eq 0 ] || return 1
	# Restore a hook disabled by our interrupted rebind, never a user-disabled one.
	if [ -f "$STATE_DIR/hook_reset" ]; then
		write_hnat hook_toggle 1
	elif [ -f /var/run/eqos.active ] && [ "$(cat "$HNAT_DIR/hook_toggle")" = enabled ]; then
		enable_hnat || return 1
	fi
	rm -rf "$STATE_DIR"
	rm -f /var/run/eqos.active
}

# The lock is shared with TurboACC; child eqos calls reuse the inherited lock.
lock_hnat() {
	[ "${MTK_HNAT_LOCK_HELD:-0}" = 1 ] && return 0
	exec 9>/var/lock/mtk-hnat.lock || return 1
	flock -x 9 || return 1
	export MTK_HNAT_LOCK_HELD=1
}

snapshot_qdma() {
	local tmp mode i dscp
	if [ -d "$STATE_DIR" ]; then
		[ -f "$STATE_DIR/mode" ] || die "incomplete QDMA snapshot; refusing to change hardware"
		return 0
	fi
	mode=$(sed -n 's/^mode=//p' "$HNAT_DIR/qos_toggle")
	dscp=$(sed -n 's/^dscp_mapping=//p' "$HNAT_DIR/qos_toggle")
	[ "$dscp" != 1 ] || die "DSCP queue mapping is active; disable it before using per-device EQoS"
	case "$mode" in 0|2) ;; *) die "QDMA is owned by another QoS service or its status ABI is unavailable" ;; esac
	tmp=$(mktemp -d /var/run/eqos.XXXXXX) || return 1
	printf '%s\n' "$mode" > "$tmp/mode"
	for i in "$UP_SCH" "$DL_SCH"; do
		awk 'NR == 2 && $1 ~ /^[01]$/ && ($2 == "SP" || $2 == "WRR") && $3 ~ /^[0-9]+$/ { print $1, tolower($2), $3; ok=1 } END { if (!ok) exit 1 }' \
			"$HNAT_DIR/qdma_sch$i" > "$tmp/sch$i" || {
			rm -rf "$tmp"; die "cannot snapshot scheduler $i"
		}
	done
	i=$UP_QID_BASE
	while [ "$i" -le "$MANAGED_QID_LAST" ]; do
		awk '$1 == "scheduler:" { s=$2; seen=1 } $1 == "hw" && $2 == "resv:" { h=$3 } $1 == "sw" && $2 == "resv:" { w=$3 } $1 == "max" { x=$2; r=$3; wt=$4 } $1 == "min" { n=$2; nr=$3 } END { if (!seen || h == "" || h != w || x == "" || n == "") exit 1; print s,n,nr,x,r,wt,h }' \
			"$HNAT_DIR/qdma_txq$i" > "$tmp/txq$i" || {
			rm -rf "$tmp"; die "cannot safely snapshot queue $i"
		}
		i=$((i + 1))
	done
	mv "$tmp" "$STATE_DIR" || { rm -rf "$tmp"; return 1; }
}

restore_qdma() {
	local file node failed=0
	[ -f "$STATE_DIR/mode" ] || return 0
	for file in "$STATE_DIR"/dirty_txq*; do
		[ -f "$file" ] || continue
		node=${file##*/dirty_}
		write_hnat "qdma_$node" "$(cat "$STATE_DIR/$node")" || failed=1
	done
	for node in "sch$UP_SCH" "sch$DL_SCH"; do
		write_hnat "qdma_$node" "$(cat "$STATE_DIR/$node")" || failed=1
	done
	write_hnat qos_toggle "$(cat "$STATE_DIR/mode")" || failed=1
	[ "$failed" -eq 0 ]
}

usage() {
	cat <<EOF
Usage: $0 <command> [options]

Commands:
  start <download_mbit> <upload_mbit>
  add <slot> <download_kbit> <upload_kbit> <ipv4|ipv6> [total_down_mbit] [total_up_mbit]
  enable
  stop

Run enable once after all add commands.

Queue slots 1-31 use the common NETSYS V2/V3 64-QDMA layout. EQoS keeps
qid0 as the default unclassified queue, uses qid1-31 for upload and
qid32-62 for download, and keeps qid63 free for the PPD path. Slots 32
and above use tc software shaping with an IPv4 or IPv6 selector.
EOF
}

lock_hnat || die "cannot acquire HNAT lock"

case "$1" in
	start)
		shift
		start_all "$@"
		;;
	stop)
		shift
		stop_all "$@"
		;;
	add)
		shift
		add_inferred_rule "$@"
		;;
	enable)
		shift
		enable_hnat "$@"
		;;
	*)
		usage
		exit 1
		;;
esac
