#!/bin/sh
. /usr/share/libubox/jshn.sh
. /lib/functions.sh
case "$1" in
list)
	printf '%s\n' '{"getStatus":{},"apply":{}}'
	;;
call)
	if [ "$2" = apply ]; then
		if /etc/init.d/eqos reload >/dev/null 2>&1; then result=1; else result=0; fi
		status=$("$0" call getStatus) || result=0
		json_load "$status" || result=0
		json_get_var last_error error
		json_get_var enabled enabled
		json_get_var applied applied
		json_get_var owned owned
		json_get_var rules rules
		[ -z "$last_error" ] || result=0
		if [ "$enabled" != 1 ] && [ "$owned" = 1 ]; then result=0; fi
		if [ "$enabled" = 1 ] && [ "$applied" != 1 ] && [ "${rules:-0}" -gt 0 ]; then result=0; fi
		json_init
		json_add_boolean success "$result"
		json_dump
		exit 0
	fi
	[ "$2" = getStatus ] || exit 1
	config_load eqos
	config_get_bool enabled config enabled 0
	config_get download config download 0
	config_get upload config upload 0
	rules=0
	count_rule() {
		local enabled dl up
		config_get_bool enabled "$1" enabled 1
		config_get dl "$1" download 0
		config_get up "$1" upload 0
		[ "$enabled" -eq 1 ] || return 0
		case "$dl:$up" in *[!0-9:]*) return 0 ;; esac
		[ "${#dl}" -le 9 ] && [ "${#up}" -le 9 ] || return 0
		if [ "$dl" -gt 0 ] || [ "$up" -gt 0 ]; then rules=$((rules + 1)); fi
	}
	config_foreach count_rule device
	hook=$(cat /sys/kernel/debug/hnat/hook_toggle 2>/dev/null)
	mode=$(sed -n 's/^mode=//p' /sys/kernel/debug/hnat/qos_status 2>/dev/null)
	json_init
	json_add_int schema 1
	if [ -f /var/run/eqos/mode ]; then json_add_boolean owned 1; else json_add_boolean owned 0; fi
	json_add_int rules "$rules"
	total=0
	case "$download:$upload" in *[!0-9:]*) ;; *) if [ "${#download}" -le 9 ] && [ "${#upload}" -le 9 ]; then
		if [ "$download" -gt 0 ] || [ "$upload" -gt 0 ]; then total=1; fi
	fi ;; esac
	json_add_int total "$total"
	case "$enabled" in 1|true|yes|on) json_add_boolean enabled 1 ;; *) json_add_boolean enabled 0 ;; esac
	if [ -f /var/run/eqos.active ] && [ "$mode" = 1 ]; then json_add_boolean applied 1; else json_add_boolean applied 0; fi
	if [ "$hook" = enabled ]; then json_add_boolean hnat 1; else json_add_boolean hnat 0; fi
	if [ -r /var/run/eqos.error ]; then json_add_string error "$(head -c 512 /var/run/eqos.error)"; fi
	json_dump
	;;
*) exit 1 ;;
esac
