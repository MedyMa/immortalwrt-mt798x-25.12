+/* Stop rearming timers before freeing data or module text (Linux 6.2+). */
+static inline void map_timer_shutdown(struct timer_list *timer)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 2, 0)
+	timer_shutdown_sync(timer);
+#else
+	del_timer_sync(timer);
+#endif
+}
 
