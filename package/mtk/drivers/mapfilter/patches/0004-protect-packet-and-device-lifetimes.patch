+/* Release retained devices before unregister waits for their reference count. */
+static int map_netdev_event(struct notifier_block *nb, unsigned long event, void *ptr)
+{
+	struct net_device *netdev = netdev_notifier_info_to_dev(ptr);
+	struct map_net_device *dev;
+	struct hlist_node *n;
+	int i;
+
+	if (event != NETDEV_UNREGISTER || dev_net(netdev) != &init_net)
+		return NOTIFY_DONE;
+	spin_lock_bh(&dev_lock);
+	for (i = 0; i < HASH_TABLE_SIZE; i++) {
+		hlist_for_each_entry_safe(dev, n, &dev_hash[i], hlist) {
+			if (dev->dev != netdev && dev->dest_dev != netdev)
+				continue;
+			hlist_del_rcu(&dev->hlist);
+			call_rcu(&dev->rcu, free_map_net_device);
+		}
+	}
+	spin_unlock_bh(&dev_lock);
+	return NOTIFY_DONE;
+}
