+/* The vendor length excludes the packed command header; netlink may pad it. */
+static bool map_command_valid(const struct map_netlink_message *cmd, size_t available)
+{
+	size_t needed;
+	unsigned int i;
+	const struct local_itfs *itfs;
+	const struct sp_rules_config *rules;
+
+	if (available < sizeof(*cmd))
+		return false;
+	available -= sizeof(*cmd);
+	/* Legacy diagnostic messages leave len stale and carry no event. */
+	if (cmd->type == DUMP_DEBUG_INFO || cmd->type == SHOW_VERSION ||
+	    cmd->type == SERVICE_PRIORITIZATION_CLEAR_RULE)
+		return true;
+	if (cmd->len > available)
+		return false;
+	available = cmd->len;
+	switch (cmd->type) {
+	case UPDATE_MAP_NET_DEVICE:
+		if (available < sizeof(struct local_itfs))
+			return false;
+		itfs = (const void *)cmd->event;
+		needed = sizeof(*itfs) + itfs->num * sizeof(struct local_interface);
+		if (needed > available)
+			return false;
+		for (i = 0; i < itfs->num; i++)
+			if (!memchr(itfs->inf[i].name, 0, IFNAMSIZ) ||
+			    (itfs->inf[i].dev_type < AP || itfs->inf[i].dev_type > ETH))
+				return false;
+		return true;
+	case SET_PRIMARY_INTERFACE: needed = sizeof(struct primary_itf_setting); break;
+	case SET_UPLINK_PATH_ENTRY: needed = sizeof(struct up_link_path_setting); break;
+	case UPDATE_APCLI_LINK_STATUS: needed = sizeof(struct apcli_link_status); break;
+	case UPDATE_CHANNEL_UTILIZATION: needed = sizeof(struct radio_utilization); break;
+	case DYNAMIC_LOAD_BALANCE:
+	case SET_DROP_SPECIFIC_IP_PACKETS_STATUS:
+	case TRAFFIC_SEPARATION_ONOFF: needed = 1; break;
+	case SET_TRAFFIC_SEPARATION_DEFAULT_8021Q: needed = sizeof(struct ts_default_8021q); break;
+	case SET_TRAFFIC_SEPARATION_POLICY:
+		if (available < sizeof(struct ts_policy))
+			return false;
+		needed = sizeof(struct ts_policy) + cmd->event[0] * sizeof(struct ssid_2_vid_mapping);
+		break;
+	case SET_TRANSPARENT_VID:
+		if (available < sizeof(struct transparent_vids))
+			return false;
+		needed = sizeof(struct transparent_vids) + cmd->event[0] * sizeof(unsigned short);
+		break;
+	case UPDATE_CLIENT_VID:
