+/* Device indices may be cached; net_device pointers may only be used in RCU. */
+static struct net_device *map_dev_by_index(int ifindex)
+{
+	struct net_device *dev = dev_get_by_index_rcu(&init_net, ifindex);
+	if (dev && READ_ONCE(dev->reg_state) == NETREG_REGISTERED)
+		return dev;
+	return NULL;
+}
+
+static const char *map_device_name(int ifindex)
+{
+	struct net_device *dev = map_dev_by_index(ifindex);
+	return dev ? dev->name : "N/A";
+}
