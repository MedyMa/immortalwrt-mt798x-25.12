From: Codex <codex@openai.com>
Subject: [PATCH] mt_wifi7: guard optional cfg80211 feature access

The FtCfg member of struct wifi_dev is only declared with
DOT11R_FT_SUPPORT. Keep its SA Query check only when FT support is enabled.
Guard Neighbor Report and MLO BTM processing with DOT11K_RRM_SUPPORT so
RRM-disabled builds retain the legacy BTM path.

The cfg80211 SSID sync path also uses MAP and WAPP symbols only when both
optional interfaces are available. Preserve MAP+WAPP notifications while
avoiding references to omitted feature code in other configurations.

--- a/mt_wifi/os/linux/cfg80211/cfg80211_rx.c
+++ b/mt_wifi/os/linux/cfg80211/cfg80211_rx.c
@@ -418,6 +418,10 @@
 	if ((pEntry->SecConfig.PmfCfg.UsePMFConnect == TRUE)
 			&& (tr_entry->PortSecured == WPA_802_1X_PORT_SECURED)
-			&& (auth_info->auth_alg != AUTH_MODE_FT) && (!wdev->FtCfg.FtCapFlag.Dot11rFtEnable)) {
+			&& (auth_info->auth_alg != AUTH_MODE_FT)
+#ifdef DOT11R_FT_SUPPORT
+			&& (!wdev->FtCfg.FtCapFlag.Dot11rFtEnable)
+#endif /* DOT11R_FT_SUPPORT */
+			) {
 		HEADER_802_11 AuthHdr;
 		ULONG FrameLen = 0;
 		PUCHAR pOutBuffer = NULL;

--- a/mt_wifi/os/linux/cfg80211/cfg80211_tx.c
+++ b/mt_wifi/os/linux/cfg80211/cfg80211_tx.c
@@ -313,17 +313,21 @@
 NDIS_STATUS CFG80211_LEGACY_BtmReqHandler(RTMP_ADAPTER *pAd, VOID *pData, ULONG Data)
 {
 	struct BSS_TM_REQ *pPayload = NULL;
+#ifdef DOT11K_RRM_SUPPORT
 	BSS_ENTRY *pBssEntry = NULL;
 	BSS_TABLE *ScanTab = NULL;
+#endif /* DOT11K_RRM_SUPPORT */
 	BSS_STRUCT *pMbss = NULL;
 	struct wifi_dev *wdev = NULL;
 	struct ieee80211_mgmt *mgmt = NULL;
 	MAC_TABLE_ENTRY *pEntry = NULL;
 	UINT i = 0;
 	UINT url_len = 0;
+#ifdef DOT11K_RRM_SUPPORT
 	ULONG bss_index = 0;
+	BOOLEAN pref = 0;
+#endif /* DOT11K_RRM_SUPPORT */
 	UINT8 apidx = 0;
-	BOOLEAN pref = 0;
 #ifdef MBO_SUPPORT
 	ULONG MboIndex = 0;
 	ULONG MboLen = 0;
@@ -384,11 +388,13 @@
 		i += 2 + 10; /* Skip elemnt id, length, BSS Termination TSF and Duration*/
 	}
 
+#ifdef DOT11K_RRM_SUPPORT
 	if (pPayload->req_mode & BTM_CANDIDATE_OFFSET) {
 		MTWF_DBG(pAd, DBG_CAT_TX, CATTX_MGMT, DBG_LVL_NOTICE,
 			"Preferred Candidate List Included\n");
 		pref = TRUE;
 	}
+#endif /* DOT11K_RRM_SUPPORT */
 
 	if (pPayload->req_mode & BTM_URL_OFFSET) {
 		MTWF_DBG(pAd, DBG_CAT_TX, CATTX_MGMT, DBG_LVL_NOTICE,
@@ -409,14 +415,18 @@
 			MTWF_DBG(pAd, DBG_CAT_TX, CATTX_MGMT, DBG_LVL_ERROR,
 				"index 'i' exceeds payload length\n");
 			return NDIS_STATUS_FAILURE;
-		} else if (pref && (pPayload->variable[i] != IE_RRM_NEIGHBOR_REP)
+		}
+#ifdef DOT11K_RRM_SUPPORT
+		else if (pref && (pPayload->variable[i] != IE_RRM_NEIGHBOR_REP)
 				&& (pPayload->variable[i] != IE_VENDOR_SPECIFIC)) {
 			MTWF_DBG(pAd, DBG_CAT_TX, CATTX_MGMT, DBG_LVL_ERROR,
 				"Frame format error\n");
 			return NDIS_STATUS_FAILURE;
 		}
-	}
-
+#endif /* DOT11K_RRM_SUPPORT */
+	}
+
+#ifdef DOT11K_RRM_SUPPORT
 	while (pPayload->variable[i] == IE_RRM_NEIGHBOR_REP) {
 		struct NEIGHBOR_REPORT_INFO *pNei_payload = NULL;
 		RRM_BSSID_INFO BssidInfo;
@@ -505,6 +515,8 @@
 		i += Nei_len;
 	}
 
+#endif /* DOT11K_RRM_SUPPORT */
+
 #ifdef MBO_SUPPORT
 	MboIndex = sizeof(HEADER_802_11) + WNM_BTM_REQUEST_MADATORY_LEN + i;
 	if (MboIndex < Data) {
@@ -541,7 +553,7 @@
 	return NDIS_STATUS_SUCCESS;
 }
 
-#if defined(DOT11_EHT_BE)
+#if defined(DOT11_EHT_BE) && defined(DOT11K_RRM_SUPPORT)
 VOID mlo_neighbor_per_sta_profie_set_entry(RTMP_ADAPTER *pAd,
 	u8 *pData, UINT idx, struct wifi_dev *wdev,
 	struct per_sta_profile_nei_entry *neighbor_table)
@@ -1218,7 +1230,7 @@
 			if ((mgmt->u.action.category == CATEGORY_WNM)
 					&& (pPayload->action == BSS_TRANSITION_REQ)) {
 				NDIS_STATUS NStatus;
-#if defined(DOT11_EHT_BE)
+#if defined(DOT11_EHT_BE) && defined(DOT11K_RRM_SUPPORT)
 				MAC_TABLE_ENTRY * pEntry = NULL;
 				UINT8 apidx = get_apidx_by_addr(pAd, mgmt->sa);
 #endif
@@ -1226,7 +1238,7 @@
 				MTWF_DBG(pAd, DBG_CAT_TX, CATTX_WMM, DBG_LVL_NOTICE,
 					"Send WNM BTM Req Frame\n");
 
-#if defined(DOT11_EHT_BE)
+#if defined(DOT11_EHT_BE) && defined(DOT11K_RRM_SUPPORT)
 				pEntry = MacTableLookup(pAd, mgmt->da);
 
 				if (pEntry && pEntry->mlo.mlo_en) {

--- a/mt_wifi/os/linux/cfg80211/cfg80211_ap.c
+++ b/mt_wifi/os/linux/cfg80211/cfg80211_ap.c
@@ -118,8 +118,10 @@
 		os_move_mem(pMbss->Ssid, pCfg->ssid, pMbss->SsidLen);
 		MTWF_DBG(pAd, DBG_CAT_AP, CATAP_BCN, DBG_LVL_DEBUG,
 			"\nCFG : SSID: %s, %d\n", pMbss->Ssid, pMbss->SsidLen);
+#if defined(CONFIG_MAP_SUPPORT) && defined(WAPP_SUPPORT)
 		if (IS_MAP_BS_ENABLE(pAd))
 			wapp_send_ssid_change_rsp(pAd, wdev, pMbss->Ssid, pMbss->SsidLen);
+#endif /* CONFIG_MAP_SUPPORT && WAPP_SUPPORT */
 		if (pCfg->hidden_ssid > 0 && pCfg->hidden_ssid < 3) {
 			pMbss->bHideSsid = TRUE;
 			MTWF_DBG(pAd, DBG_CAT_AP, CATAP_BCN, DBG_LVL_DEBUG,
@@ -146,8 +148,10 @@
 				os_zero_mem(pMbss->Ssid, MAX_LEN_OF_SSID + 1);
 				os_move_mem(pMbss->Ssid, (void *)ssid_ie+2, ssid_len);
 				pMbss->SsidLen = ssid_len;
+#if defined(CONFIG_MAP_SUPPORT) && defined(WAPP_SUPPORT)
 				if (IS_MAP_BS_ENABLE(pAd))
 					wapp_send_ssid_change_rsp(pAd, wdev, pMbss->Ssid, pMbss->SsidLen);
+#endif /* CONFIG_MAP_SUPPORT && WAPP_SUPPORT */
 				/* update cfg80211 wdev ssid */
 				net_dev_p = wdev->if_dev;
 				cfg80211_wdev = net_dev_p->ieee80211_ptr;
