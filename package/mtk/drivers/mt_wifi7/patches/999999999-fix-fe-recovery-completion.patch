From: MedyMa <75345465+MedyMa@users.noreply.github.com>
Subject: [PATCH] wifi7: acknowledge completed FE recovery and balance clients

The vendor Ethernet reset waits for MTK_WIFI_L1SER_DONE but this WiFi7
baseline never emits it. Acknowledge only an FE-requested L1 recovery that
really returned to N9-normal. Serialize the notifier private pointer with
the ACK reader and do not unregister a failed registration.

Signed-off-by: MedyMa <75345465+MedyMa@users.noreply.github.com>

--- a/mt_wifi/hw_ctrl/hw_ctrl_basic.c
+++ b/mt_wifi/hw_ctrl/hw_ctrl_basic.c
@@ -338,8 +338,13 @@
 {
 	struct mtk_notifier_block *nb = (struct mtk_notifier_block *)this;
 	RTMP_ADAPTER *pAd = nb->priv;
-	struct physical_device *device = pAd->physical_dev;
-	P_ERR_RECOVERY_CTRL_T pErrRecoveryCtrl = &device->ErrRecoveryCtl;
+	struct physical_device *device;
+	P_ERR_RECOVERY_CTRL_T pErrRecoveryCtrl;
+
+	if (!pAd)
+		return NOTIFY_DONE;
+	device = pAd->physical_dev;
+	pErrRecoveryCtrl = &device->ErrRecoveryCtl;
 
 	if (!RTMP_TEST_FLAG(pAd, fRTMP_ADAPTER_START_UP))
 		return NOTIFY_DONE;
@@ -348,8 +353,11 @@
 	case MTK_FE_START_RESET:
 		MTWF_DBG(pAd, DBG_CAT_HW, CATHW_SER, DBG_LVL_ERROR,
 			"receive fe reset(hang) event, trigger ser by FE\n");
+		nb->reset_pending = TRUE;
 		atomic_set(&pErrRecoveryCtrl->notify_fe, 1);
-		ser_event_enq(device->chip_id, FE_WDMA_RESET, SER_FE_STOP, device->hw_id);
+		if (ser_event_enq(device->chip_id, FE_WDMA_RESET, SER_FE_STOP,
+				  device->hw_id) != NDIS_STATUS_SUCCESS)
+			nb->reset_pending = FALSE;
 		break;
 
 	case MTK_FE_RESET_DONE:
@@ -386,36 +394,48 @@
 	struct mtk_notifier_block *mtk_nb = &pErrRecoveryCtrl->mtk_nb;
 	struct _RTMP_ADAPTER *pAd = physical_device_get_first_mac_adapter(device);
 
+	if (mtk_nb->registered)
+		return NDIS_STATUS_SUCCESS;
+	if (!pAd || !pAd->net_dev)
+		return NDIS_STATUS_FAILURE;
 	atomic_set(&pErrRecoveryCtrl->notify_fe, 0);
-
+	mtk_nb->reset_pending = FALSE;
 	mtk_nb->priv = pAd;
 	mtk_nb->nb.notifier_call = mtk_fe_event;
 	err = register_netdevice_notifier(&mtk_nb->nb);
 
-	if (err)
+	if (err) {
+		mtk_nb->priv = NULL;
 		return err;
+	}
 
 	rtnl_lock();
+	mtk_nb->registered = TRUE;
 	call_netdevice_notifiers(MTK_WIFI_CHIP_ONLINE, pAd->net_dev);
 	rtnl_unlock();
 
 	return err;
 }
 
-void  mtk_fe_reset_notifier_exit(struct physical_device *device)
+void mtk_fe_reset_notifier_exit(struct physical_device *device)
 {
 	P_ERR_RECOVERY_CTRL_T pErrRecoveryCtrl = &device->ErrRecoveryCtl;
 	struct mtk_notifier_block *mtk_nb = &pErrRecoveryCtrl->mtk_nb;
-	struct _RTMP_ADAPTER *pAd = physical_device_get_first_mac_adapter(device);
-
+	struct _RTMP_ADAPTER *pAd;
+
+	if (!mtk_nb->registered)
+		return;
+	unregister_netdevice_notifier(&mtk_nb->nb);
 	rtnl_lock();
-	call_netdevice_notifiers(MTK_WIFI_CHIP_OFFLINE, pAd->net_dev);
+	pAd = mtk_nb->priv;
+	if (pAd && pAd->net_dev)
+		call_netdevice_notifiers(MTK_WIFI_CHIP_OFFLINE, pAd->net_dev);
+	mtk_nb->reset_pending = FALSE;
+	mtk_nb->registered = FALSE;
+	mtk_nb->priv = NULL;
 	rtnl_unlock();
-	unregister_netdevice_notifier(&mtk_nb->nb);
-
-	mtk_nb->priv = NULL;
-
-}
+}
+
 #endif
 
 #endif /* ERR_RECOVERY */
--- a/mt_wifi/hw_ctrl/ser_mngr/ser_mngr.c
+++ b/mt_wifi/hw_ctrl/ser_mngr/ser_mngr.c
@@ -306,16 +306,31 @@
 
 	if (ack_event > BIT(10)) {
 #ifdef MTK_FE_RESET_RECOVER
+		rtnl_lock();
 		pAd2 = ser_get_fe_pAd_by_mainpAd(main_pAd);
-		rtnl_lock();
+		if (!pAd2 || !pAd2->net_dev)
+			goto fe_unlock;
+		if (ack_event == MTK_WIFI_L1SER_DONE) {
+			struct mtk_notifier_block *nb =
+				&main_pAd->physical_dev->ErrRecoveryCtl.mtk_nb;
+
+			if (nb->reset_pending) {
+				nb->reset_pending = FALSE;
+				call_netdevice_notifiers(MTK_WIFI_L1SER_DONE, pAd2->net_dev);
+			}
+			goto fe_unlock;
+		}
 		if (ack_event == FE_WIFI_RESET_DONE)
 			call_netdevice_notifiers(MTK_WIFI_RESET_DONE, pAd2->net_dev);
 		if (ack_event == FE_WIFI_TARFFIC_DONE)
 			call_netdevice_notifiers(MTK_FE_STOP_TRAFFIC_DONE, pAd2->net_dev);
 		if (ack_event == FE_WIFI_TARFFIC_DONE_FAIL)
 			call_netdevice_notifiers(MTK_FE_STOP_TRAFFIC_DONE_FAIL, pAd2->net_dev);
-		if (ack_event == FE_WIFI_WDMA_FAIL_RESET)
+		if (ack_event == FE_WIFI_WDMA_FAIL_RESET) {
+			main_pAd->physical_dev->ErrRecoveryCtl.mtk_nb.reset_pending = FALSE;
 			call_netdevice_notifiers(MTK_FE_START_RESET_INIT, pAd2->net_dev);
+		}
+fe_unlock:
 		rtnl_unlock();
 #endif
 	} else {
@@ -838,6 +853,16 @@
 	if (_ser_handler)
 		_ser_handler(ser_cb);
 
+#ifdef MTK_FE_RESET_RECOVER
+	/* The FE waits for this host ACK after resuming the stopped L1 SER.
+	 * Only an actual N9-normal transition counts, never a timeout/re-entry.
+	 */
+	if (level == SER_LV_1_0 && state == SER_LV_1_0_STATE_WAIT_N9_NORMAL &&
+	    (event & SER_LV_1_0_EVT_N9_NORMAL_STATE) &&
+	    !(event & SER_LV_1_0_EVT_STOP_PDMA) &&
+	    ser_get_ser_state(ser_cb) == SER_LV_1_0_STATE_STOP_IDLE)
+		ser_ack_event(ser_cb, MTK_WIFI_L1SER_DONE);
+#endif
 	return NDIS_STATUS_SUCCESS;
 }
 
--- a/mt_wifi/include/hw_ctrl.h
+++ b/mt_wifi/include/hw_ctrl.h
@@ -896,10 +896,13 @@
 #define MTK_FE_START_TRAFFIC	0x2007
 #define MTK_FE_STOP_TRAFFIC_DONE_FAIL 0x2008
 #define MTK_FE_START_RESET_INIT 0x2009
+#define MTK_WIFI_L1SER_DONE 0x200a
 
 struct mtk_notifier_block {
 	struct notifier_block nb;
 	void *priv;
+	BOOLEAN registered;
+	BOOLEAN reset_pending;
 
 };
 #endif
