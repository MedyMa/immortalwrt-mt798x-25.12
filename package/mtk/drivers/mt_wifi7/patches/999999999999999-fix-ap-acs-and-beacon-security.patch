+/* The legacy security parser expects a group suite and both counted
+ * suite lists. Validate the whole element before changing BSS state.
+ */
+static bool cfg80211_ap_valid_security_ie(const u8 *ie, bool vendor, bool wpa1)
+{
+	const u8 *pos = ie + 2, *end = pos + ie[1];
+	unsigned int i, count;
+
+	if (vendor) {
+		if (end - pos < 4)
+			return false;
+		pos += 4;
+	}
+	if (end - pos < 6 || get_unaligned_le16(pos) != 1)
+		return false;
+	pos += 6;
+	for (i = 0; i < 2; i++) {
+		if (end - pos < 2)
+			return false;
+		count = get_unaligned_le16(pos);
+		pos += 2;
+		if (!count || count > (end - pos) / 4)
+			return false;
+		pos += count * 4;
+	}
+	if (pos == end)
+		return true;
+	if (end - pos < 2)
+		return false;
+	pos += 2; /* capabilities */
+	if (wpa1 || pos == end)
+		return pos == end;
+	if (end - pos < 2)
+		return false;
+	count = get_unaligned_le16(pos);
+	pos += 2;
+	if (count > (end - pos) / LEN_PMKID)
+		return false;
+	pos += count * LEN_PMKID;
+	return pos == end || end - pos == LEN_OUI_SUITE;
+}
