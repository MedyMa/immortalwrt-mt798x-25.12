+	if (nla_put_u32(skb, MTK_NL80211_VENDOR_ATTR_EVENT_ACS_COMPLETE_PRIMARY_FREQUENCY, freq) ||
+	    nla_put_u32(skb, MTK_NL80211_VENDOR_ATTR_EVENT_ACS_COMPLETE_SECONDARY_FREQUENCY, sec_freq) ||
+	    nla_put_u8(skb, MTK_NL80211_VENDOR_ATTR_EVENT_ACS_COMPLETE_HW_MODE, mode) ||
+	    nla_put_u8(skb, MTK_NL80211_VENDOR_ATTR_EVENT_ACS_COMPLETE_VHT_SEG0_CENTER_CHANNEL, seg0) ||
+	    nla_put_u8(skb, MTK_NL80211_VENDOR_ATTR_EVENT_ACS_COMPLETE_VHT_SEG1_CENTER_CHANNEL, seg1) ||
+	    nla_put_u16(skb, MTK_NL80211_VENDOR_ATTR_EVENT_ACS_COMPLETE_CHWIDTH, width)) {
+		kfree_skb(skb);
+		return -EMSGSIZE;
+	}
+	cfg80211_vendor_event(skb, GFP_KERNEL);
 	return 0;
 }
