+#ifdef BACKPORT_NOSTDINC
+static void CFG80211_ChannelNotifyWork(struct work_struct *work)
+{
+	CFG80211_CB *cb = container_of(to_delayed_work(work), CFG80211_CB,
+				      channel_notify_work);
+	struct wiphy *wiphy = cb->pCfg80211_Wdev->wiphy;
+	struct _RTMP_ADAPTER *ad;
+	struct wireless_dev *wdev;
+	struct cfg80211_chan_def chandef;
+	struct mtk_mac_dev *mac_dev;
+	struct mtk_mac_phy *mac_phy;
+	unsigned long flags;
+	unsigned int freq;
+	enum nl80211_band band;
+	bool matches;
+
+	MAC80211_PAD_GET_NO_RV(ad, wiphy);
+	rtnl_lock();
+	wiphy_lock(wiphy);
+
+	OS_SPIN_LOCK_IRQSAVE(&ad->VirtualIfLock, &flags);
+	chandef = cb->pending_channel;
+	freq = cb->pending_channel_freq;
+	OS_SPIN_UNLOCK_IRQRESTORE(&ad->VirtualIfLock, &flags);
+
+	chandef.chan = ieee80211_get_channel(wiphy, freq);
+	if (!chandef.chan || !cfg80211_chandef_valid(&chandef))
+		goto unlock;
+
+	/* A stop or retune may have overtaken the queued notification. */
+	mac_dev = hc_get_mac_dev(ad);
+	if (!mac_dev)
+		goto unlock;
+	mac_phy = &mac_dev->mac_phy;
+	band = chandef.chan->band;
+	OS_SEM_LOCK(&mac_phy->lock);
+	matches = mac_phy->state &&
+		  (mac_phy->reason == REASON_NORMAL_SCAN ||
+		   (freq == ieee80211_channel_to_frequency(mac_phy->chan, band) &&
+		    chandef.width == phy_bw_2_nl_bw(mac_phy->bw) &&
+		    chandef.center_freq1 == ieee80211_channel_to_frequency(mac_phy->cen_chan, band) &&
+		    (chandef.width != NL80211_CHAN_WIDTH_80P80 ||
+		     chandef.center_freq2 == ieee80211_channel_to_frequency(mac_phy->chan2, band))));
+	OS_SEM_UNLOCK(&mac_phy->lock);
+	if (!matches)
+		goto unlock;
+
+	list_for_each_entry(wdev, &wiphy->wdev_list, list) {
+		struct cfg80211_chan_def *active;
+
+		if (!wdev->netdev || !netif_running(wdev->netdev) ||
+		    (wdev->iftype != NL80211_IFTYPE_AP &&
+		     wdev->iftype != NL80211_IFTYPE_P2P_GO) ||
+		    (wdev->valid_links && !(wdev->valid_links & BIT(0))) ||
+		    !wdev->links[0].ap.beacon_interval)
+			continue;
+
+		active = &wdev->links[0].ap.chandef;
+		if (!active->chan || active->chan->band != band)
+			continue;
+
+		chandef.punctured = active->punctured;
+		if (chandef.punctured && !cfg80211_chandef_valid(&chandef))
+			chandef.punctured = 0;
+		if (!cfg80211_chandef_identical(active, &chandef))
+			cfg80211_ch_switch_notify(wdev->netdev, &chandef, 0);
+	}
+
+unlock:
+	wiphy_unlock(wiphy);
+	rtnl_unlock();
+}
+
+void CFG80211_QueueChannelNotify(struct wifi_dev *wdev, const struct freq_oper *oper)
+{
+	struct _RTMP_ADAPTER *ad = wdev->sys_handle;
+	struct cfg80211_chan_def chandef = {};
+	enum nl80211_band band;
+	unsigned long flags;
+	unsigned int freq;
+	UCHAR center = oper->cen_ch_1;
+	CFG80211_CB *cb;
+
+	/* Initial tuning is part of ndo_open. START_AP sets the first chandef. */
+	if (!wdev->if_dev || !(READ_ONCE(wdev->if_dev->flags) & IFF_UP))
+		return;
+
+	switch (oper->ch_band) {
+	case CMD_CH_BAND_24G:
+		band = NL80211_BAND_2GHZ;
+		break;
+	case CMD_CH_BAND_5G:
+		band = NL80211_BAND_5GHZ;
+		break;
+	case CMD_CH_BAND_6G:
+		band = NL80211_BAND_6GHZ;
+		break;
+	default:
+		return;
+	}
+
+#ifdef DOT11_EHT_BE
+	if (oper->bw == BW_320)
+		center = oper->eht_cen_ch;
+#endif
+	freq = ieee80211_channel_to_frequency(oper->prim_ch, band);
+	chandef.width = phy_bw_2_nl_bw(oper->bw);
+	chandef.center_freq1 = ieee80211_channel_to_frequency(center, band);
+	if (chandef.width == NL80211_CHAN_WIDTH_80P80)
+		chandef.center_freq2 = ieee80211_channel_to_frequency(oper->cen_ch_2, band);
+	if (!freq || !chandef.center_freq1)
+		return;
+
+	/* The producer can run in ndo_open, a cfg80211 callback or a driver task. */
+	OS_SPIN_LOCK_IRQSAVE(&ad->VirtualIfLock, &flags);
+	cb = ad->pCfg80211_CB;
+	if (cb && !cb->channel_notify_stopping) {
+		cb->pending_channel = chandef;
+		cb->pending_channel_freq = freq;
+		mt_queue_delayed_work(system_wq, &cb->channel_notify_work, 0);
+	}
+	OS_SPIN_UNLOCK_IRQRESTORE(&ad->VirtualIfLock, &flags);
+}
+#endif /* BACKPORT_NOSTDINC */
 
