From: Codex <codex@openai.com>
Subject: [PATCH] mt_wifi7: guard MAP profile parsing

The BSS role fields and MAP roles are only declared with CONFIG_MAP_SUPPORT.
Keep the bhbss/fhbss profile parsing under the same feature guard.

--- a/mt_wifi/profiles/cmm_profile.c
+++ b/mt_wifi/profiles/cmm_profile.c
@@ -8461,6 +8461,7 @@
 	}
 
 
+#ifdef CONFIG_MAP_SUPPORT
 	if (RTMPGetKeyParameter("bhbss", tmpbuf, 32, pBuffer, FALSE)) {
 		struct wifi_dev *wdev = NULL;
 
@@ -8493,6 +8494,7 @@
 			}
 		}
 	}
+#endif /* CONFIG_MAP_SUPPORT */
 	} while (0);
 
 	os_free_mem(tmpbuf);
