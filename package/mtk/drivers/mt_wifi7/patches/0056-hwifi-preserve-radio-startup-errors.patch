Subject: [PATCH] hwifi: preserve and report radio startup failures

Keep the native SDK initialization path and its original errno, including
probe deferral. Report which stage failed instead of converting every PHY
registration failure to EINVAL or leaving a failed start without context.

--- a/wlan_hwifi/interface/connac_if.c
+++ b/wlan_hwifi/interface/connac_if.c
@@ -787,8 +787,10 @@
 	}
 
 	ret = mtk_hdev_start(hw_dev);
-	if (ret)
+	if (ret) {
+		dev_err(hw_dev->dev, "hardware start failed: %d\n", ret);
 		goto end;
+	}
 
 inf_setting:
 
@@ -1497,20 +1499,25 @@
 	hw->txq_priv_size = sizeof(struct mtk_hw_txq);
 
 	ret = mtk_hdev_add_phy(dev, hw_phy);
-	if (ret)
+	if (ret) {
+		dev_err(dev->dev, "PHY attachment failed: %d\n", ret);
 		goto err;
+	}
 
 	hw->band_idx = hw_phy->band_idx;
 
 	ret = mtk_mac_hw_register(dev, hw);
-	if (ret)
+	if (ret) {
+		dev_err(dev->dev, "MAC registration for band %u failed: %d\n",
+			hw_phy->band_idx, ret);
 		goto err2;
+	}
 
 	return 0;
 err2:
 	mtk_hdev_remove_phy(dev, hw_phy);
 err:
-	return -EINVAL;
+	return ret;
 }
 
 static int
