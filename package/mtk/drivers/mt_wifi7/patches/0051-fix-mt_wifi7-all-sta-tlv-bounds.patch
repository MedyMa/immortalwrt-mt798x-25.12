+static BOOLEAN uni_event_all_sta_tlv_validate(
+	UINT8 *pData,
+	UINT32 Length,
+	struct UNI_EVENT_ALL_STA_INFO_COMMON_T **tlv_out,
+	UINT16 *tag_out,
+	UINT16 *sta_num_out,
+	UINT32 *content_len_out)
+{
+	struct UNI_EVENT_ALL_STA_INFO_T *event;
+	struct UNI_EVENT_ALL_STA_INFO_COMMON_T *tlv;
+	UINT32 tags_len;
+	UINT16 tlv_len;
+	UINT32 fixed_len = sizeof(*event);
+
+	if (!pData || Length < fixed_len + sizeof(*tlv))
+		return FALSE;
+
+	event = (struct UNI_EVENT_ALL_STA_INFO_T *)pData;
+	tlv = (struct UNI_EVENT_ALL_STA_INFO_COMMON_T *)&event->au1TlvBuffer[0];
+	tags_len = Length - fixed_len;
+	/* u2Length includes the common TLV header, as in UNI_CMD_ALL_STA_INFO_TLV_T. */
+	tlv_len = le2cpu16(tlv->u2Length);
+	if (tlv_len < sizeof(*tlv) || tlv_len > tags_len)
+		return FALSE;
+
+	*tlv_out = tlv;
+	*tag_out = le2cpu16(tlv->u2Tag);
+	*sta_num_out = le2cpu16(tlv->u2StaNum);
+	*content_len_out = tlv_len - sizeof(*tlv);
+	return TRUE;
+}
+
+static BOOLEAN uni_event_all_sta_count_valid(UINT16 tag, UINT16 sta_num, UINT32 content_len)
+{
+	UINT32 record_size = 0;
+	UINT32 max_sta_num = 0;
+
+	switch (tag) {
+	case UNI_EVENT_ALL_STA_TX_RATE:
+		record_size = sizeof(struct UNI_EVENT_ONE_STA_TX_RATE_T);
+		max_sta_num = UNI_EVENT_ALL_STA_TX_RATE_PER_EVENT;
+		break;
+	case UNI_EVENT_ALL_STA_TX_STAT:
+		record_size = sizeof(struct UNI_EVENT_ONE_STA_TX_STAT_T);
+		max_sta_num = UNI_EVENT_ALL_STA_TX_STAT_PER_EVENT;
+		break;
+	case UNI_EVENT_ALL_STA_TXRX_ADM_STAT:
+		record_size = sizeof(struct UNI_EVENT_ONE_STA_TXRX_ADM_STAT_T);
+		max_sta_num = UNI_EVENT_ALL_STA_TXRX_ADM_STAT_PER_EVENT;
+		break;
+	case UNI_EVENT_ALL_STA_TXRX_AIR_TIME:
+		record_size = sizeof(struct UNI_EVENT_ONE_STA_TXRX_AIR_TIME_T);
+		max_sta_num = UNI_EVENT_ALL_STA_TXRX_AIR_TIME_PER_EVENT;
+		break;
+	case UNI_EVENT_ALL_STA_DATA_TX_RETRY_COUNT:
+		record_size = sizeof(struct UNI_EVENT_ONE_STA_DATA_TX_RETRY_COUNT_T);
+		max_sta_num = UNI_EVENT_ALL_STA_DATA_TX_RETRY_COUNT_PER_EVENT;
+		break;
+	case UNI_EVENT_ALL_STA_GI_MODE:
+		record_size = sizeof(struct UNI_EVENT_ONE_STA_GI_MODE_T);
+		max_sta_num = UNI_EVENT_ALL_STA_GI_MODE_PER_EVENT;
+		break;
+	case UNI_EVENT_ALL_STA_TRX_MSDU_COUNT:
+		record_size = sizeof(struct UNI_EVENT_ONE_STA_TRX_MSDU_COUNT_T);
+		max_sta_num = UNI_EVENT_ALL_STA_TRX_MSDU_COUNT_PER_EVENT;
+		break;
+	case UNI_EVENT_ALL_STA_RX_MPDU_COUNT:
+		record_size = sizeof(struct UNI_EVENT_ONE_STA_RX_MPDU_COUNT_T);
+		max_sta_num = UNI_EVENT_ALL_STA_RX_MPDU_COUNT_PER_EVENT;
+		break;
+	case UNI_EVENT_ALL_STA_TX_STAT_MODE:
+		return content_len >= sizeof(struct UNI_EVENT_ALL_STA_TX_STAT_MODE_T);
+	default:
+		return TRUE;
+	}
+
+	/* Division avoids overflowing while checking the declared record count. */
+	return record_size && sta_num <= max_sta_num && sta_num <= content_len / record_size;
+}
