Subject: [PATCH] hwifi: reject unconfirmed RX descriptor snapshots

Adapt the 24.10 RRO snapshot validation to 25.12 while retaining the newer
CSRN extension. Reused contexts must not authorize stale PPE metadata.

--- a/wlan_hwifi/bus/mtk_pci_dma.c
+++ b/wlan_hwifi/bus/mtk_pci_dma.c
@@ -1339,6 +1339,19 @@
 	return 0;
 }
 
+static inline bool
+pci_dma_ind_reason_hw_path_ok(u32 ind_reason)
+{
+	switch (ind_reason) {
+	case IND_REASON_STEP_ONE:
+	case IND_REASON_WITHIN:
+	case IND_REASON_TIMEOUT_STEP_ONE:
+		return true;
+	default:
+		return false;
+	}
+}
+
 static int
 pci_dma_rxdmad_parser(struct pci_trans *trans, struct pci_rx_queue *rq,
 	struct pci_dma_desc *desc, struct mtk_bus_rx_info *rx_info)
@@ -1357,16 +1370,14 @@
 	rx_info->more = !GET_FIELD(RXDMAD_LS0, dw1);
 	rx_info->ip_frag = GET_FIELD(RXDMAD_F, dw3);
 
-	if (dw3 & RXDMAD_PPE_VLD_MASK) {
-		rx_info->ppe_entry = GET_FIELD(RXDMAD_PPE_ENTRY, dw3);
-		rx_info->csrn = GET_FIELD(RXDMAD_CSRN, dw3);
-
-		if (test_bit(RQ_FLAG_RX_CSRN_EXTEND, &rq->rq_flags))
-			rx_info->csrn |= (GET_FIELD(RXDMAD_CSRN_E, dw2) << CSRN_E_SHIFT);
-
-		if (GET_FIELD(RXDMAD_IND_REASON, dw2) != IND_REASON_CANNOT_DO_REORDER)
-			rx_info->hw_path = true;
-	}
+	/* Do not retain authority from a reused RX context. */
+	rx_info->hw_path = false;
+	rx_info->ppe_entry = 0;
+	rx_info->csrn = 0;
+	rx_info->pn_chk_fail = false;
+	rx_info->repeat_pkt = 0;
+	rx_info->old_pkt = 0;
+	rx_info->drop = RXDMAD_NON_DROP;
 
 	if (dw1 & RXDMAD_VER_MASK) {
 		if (GET_FIELD(RXDMAD_PN_CHK_FAIL, dw1) ||
@@ -1383,6 +1394,20 @@
 				RXDMAD_VER_ZREO_DROP : RXDMAD_NON_DROP;
 	}
 
+	if (dw3 & RXDMAD_PPE_VLD_MASK) {
+		u32 ind_reason = GET_FIELD(RXDMAD_IND_REASON, dw2);
+
+		rx_info->ppe_entry = GET_FIELD(RXDMAD_PPE_ENTRY, dw3);
+		rx_info->csrn = GET_FIELD(RXDMAD_CSRN, dw3);
+		if (test_bit(RQ_FLAG_RX_CSRN_EXTEND, &rq->rq_flags))
+			rx_info->csrn |= (GET_FIELD(RXDMAD_CSRN_E, dw2) << CSRN_E_SHIFT);
+		rx_info->hw_path = pci_dma_ind_reason_hw_path_ok(ind_reason) &&
+				   !rx_info->pn_chk_fail && !rx_info->drop;
+#ifdef CONFIG_HWIFI_DBG
+		if (trans->rro_cfg && ind_reason < IND_REASON_MAX)
+			trans->rro_cfg->rro_dbg.rxdmad_reason_cnt[ind_reason]++;
+#endif
+	}
 
 	mtk_dbg(MTK_BUS, "%s: rxdmad_version = %d\n", __func__,
 						GET_FIELD(RXDMAD_VER, dw1));
--- a/wlan_hwifi/bus/mtk_rro.c
+++ b/wlan_hwifi/bus/mtk_rro.c
@@ -872,6 +872,10 @@
 	seq_printf(s, "max_msdu_num: %u\n", rro_dbg->max_msdu_num);
 	seq_printf(s, "max_pg_num: %u\n", rro_dbg->max_pg_num);
 
+	for (i = 0; i < IND_REASON_MAX; i++)
+		seq_printf(s, "rxdmad_reason_%02d: %u\n", i,
+			   rro_dbg->rxdmad_reason_cnt[i]);
+
 	for (i = 0; i < MAX_MSDU_CNT_ARR_SIZE; i++) {
 		seq_printf(s, "msdu%02d_cnt = 0x%8x", i + 1, rro_dbg->msdu_cnt[i]);
 
--- a/wlan_hwifi/bus/mtk_rro.h
+++ b/wlan_hwifi/bus/mtk_rro.h
@@ -231,6 +231,7 @@
 	u32 msdu_cnt[MAX_MSDU_CNT_ARR_SIZE];
 	u32 sign_ok_cnt;
 	u32 sign_fail_cnt;
+	u32 rxdmad_reason_cnt[IND_REASON_MAX];
 };
 
 struct hw_rro_cfg {
