#!/bin/sh /etc/rc.common

START=08

tm_path=/tmp/.testmode
l1profile_path=/etc/wireless/l1profile.dat


find_emmc_factory_partition() {
        for device in /sys/class/block/mmcblk0p*; do
                if grep -qi 'factory' "$device/uevent"; then
                        # Extract the partition number
                        part=$(echo "$device" | grep -o 'mmcblk0p[0-9]*')
                        echo "$part"
                        return
                fi
        done
}

value_lsb_is_one() {
	case "$1" in
		0[xX]*) set -- "${1#??}" ;;
	esac
	case "$1" in
		""|???*|*[!0-9a-fA-F]*) return 2 ;;
		*[13579bBdDfF]) return 0 ;;
		*) return 1 ;;
	esac
}

check_testmode() {
	local factory_part idx option init_path access_mode test_mode e2p_flag ifname flag_status
	factory_part="$(find_emmc_factory_partition)"

	start_testmode() {
		local index="$1" main_key
		main_key="INDEX${index}_main_ifname"
		ifname="$(awk -F= -v key="$main_key" '$1 == key { print $2; exit }' "$l1profile_path")"
		ifname="${ifname%%;*}"
		[ -n "$ifname" ] || return 0
		touch "$tm_path" && chmod +x "$tm_path"
		printf 'mwctl %s set ATE=ATESTART\n' "$ifname" >> "$tm_path"
	}

	# Only the INDEX entry with an init_path owns these settings. In particular,
	# an INDEX entry without init_path must not probe the shared EEPROM again.
	for idx in 0 1 2; do
		option="INDEX${idx}_init_path"
		init_path="$(awk -F= -v key="$option" '$1 == key { print $2; exit }' "$l1profile_path")"
		[ -n "$init_path" ] && [ -f "$init_path" ] || continue

		access_mode="$(awk -F= '$1 == "E2pAccessMode" { print $2; exit }' "$init_path")"
		test_mode="$(awk -F= '$1 == "TestModeEn" { print $2; exit }' "$init_path")"

		case "$access_mode" in
			1)
				# EFUSE mode must not inspect factory bytes.
				value_lsb_is_one "$test_mode" && start_testmode "$idx"
				;;
			3|4)
				# EEPROM and BIN modes use the explicit profile test-mode flag.
				value_lsb_is_one "$test_mode" && start_testmode "$idx"
				;;
			2)
				if [ -n "$factory_part" ]; then
					e2p_flag="$(hexdump -v -n 1 -s 0x1af -e '1/1 "%x"' "/dev/$factory_part" 2>/dev/null)"
				else
					e2p_flag="$(mtk_factory_rw.sh -r 1 0x1af 2>/dev/null)"
				fi
				if value_lsb_is_one "$e2p_flag"; then
					sed -i 's/^TestModeEn=.*/TestModeEn=1/' "$init_path"
					start_testmode "$idx"
				else
					flag_status=$?
					[ "$flag_status" -eq 1 ] && sed -i 's/^TestModeEn=.*/TestModeEn=0/' "$init_path"
				fi
				;;
		esac
	done
}


boot() {
	rm -f "$tm_path"
	check_testmode
}
