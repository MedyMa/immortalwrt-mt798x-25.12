+static inline struct pci_trans *napi_to_pci_trans(struct napi_struct *napi)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+	return *(struct pci_trans **)netdev_priv(napi->dev);
+#else
+	return container_of(napi->dev, struct pci_trans, napi_dev);
+#endif
+}
+
+static inline struct net_device *pci_napi_dev(struct pci_trans *trans)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+	return trans->napi_dev;
+#else
+	return &trans->napi_dev;
+#endif
+}
