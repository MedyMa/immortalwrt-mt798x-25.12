Subject: hwifi: preserve IDR error signs and reject missing MLD index entries

--- a/wlan_hwifi/utility.c
+++ b/wlan_hwifi/utility.c
@@ -131,7 +131,7 @@
 	spin_unlock_bh(&idrm->lock);
 
 	if (IS_ERR(ptr)) {
-		ret = -PTR_ERR(ptr);
+		ret = PTR_ERR(ptr);
 		goto err;
 	}
 
--- a/wlan_hwifi/wsys.c
+++ b/wlan_hwifi/wsys.c
@@ -748,7 +748,7 @@
 	else
 		memcpy(entry, old_entry, sizeof(struct mtk_mld_sta_entry));
 
-	if (entry->sys_idx->idx != mld_sta_idx) {
+	if (!entry->sys_idx || entry->sys_idx->idx != mld_sta_idx) {
 		ret = -ENXIO;
 		goto err2;
 	}
