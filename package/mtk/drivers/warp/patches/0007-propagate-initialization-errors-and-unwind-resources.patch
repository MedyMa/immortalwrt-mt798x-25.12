+	wed_exit(pdev, wed);
+err_msg:
+#ifdef WED_RX_HW_RRO_2_0
+	warp_msg_deinit(warp->idx);
+#endif
+	warp_entry_release_pdev(warp);
+	return ret;
 }
 
 
