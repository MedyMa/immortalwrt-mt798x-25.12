+ccflags-y += $(MODULE_FLAGS) -Inet/nat -I$(src) -I$(src)/mcu -DCONFIG_WARP_VERSION=$(CONFIG_WARP_VERSION)
 
 ifeq ($(CONFIG_WARP_DBG_SUPPORT), y)
 ccflags-y += -DCONFIG_WARP_DBG_SUPPORT
