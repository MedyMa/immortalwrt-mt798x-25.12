+		platform_driver_unregister(pdriver);
+		ret = -ENODEV;
+	}
+	if (ret) {
+		warp_entry_proc_exit(warp_ctrl, warp);
+		kfree(name);
+		warp_entry_release(warp);
+		return ret;
+	}
 	warp_increase_ref();
-
-	return platform_driver_register(pdriver);
+	return 0;
 err:
 	return -1;
 }
