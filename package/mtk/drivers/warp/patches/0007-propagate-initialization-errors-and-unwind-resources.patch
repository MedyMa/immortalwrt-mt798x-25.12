 	if (!warp) {
 		warp_dbg(WARP_DBG_OFF,
@@ -1101,22 +1158,35 @@
 	/*assign wifi ops*/
 	wifi->ops = ops;
 	/*assign & create a pdriver*/
-	ret = snprintf(name, sizeof(name), "%s%d", WHNAT_PLATFORM_DEV_NAME,
