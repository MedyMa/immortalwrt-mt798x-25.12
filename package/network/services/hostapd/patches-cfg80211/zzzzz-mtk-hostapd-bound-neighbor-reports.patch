+		/* The IE length is one octet; never split a report across frames. */
+		if (len < 13 || len > 255)
+			continue;
+		if (buflen - (pos - buf) < len + 2)
+			break;
 		*pos++ = WLAN_EID_NEIGHBOR_REPORT;
-		*pos++ = wpabuf_len(nr->nr);
-		os_memcpy(pos, wpabuf_head(nr->nr), wpabuf_len(nr->nr));
-		pos += wpabuf_len(nr->nr);
