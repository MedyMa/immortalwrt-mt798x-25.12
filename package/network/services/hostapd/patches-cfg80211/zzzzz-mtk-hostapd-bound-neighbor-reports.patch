+static int neighbor_report_is_local(struct hostapd_data *hapd, const u8 *bssid)
+{
+	struct hapd_interfaces *interfaces = hapd->iface->interfaces;
+	unsigned int i, j;
+
+	if (!os_memcmp(bssid, hapd->own_addr, ETH_ALEN))
+		return 1;
+	for (i = 0; i < interfaces->count; i++) {
+		struct hostapd_iface *iface = interfaces->iface[i];
+		if (!iface)
+			continue;
+		for (j = 0; j < iface->num_bss; j++)
+			if (iface->bss[j] && !os_memcmp(bssid, iface->bss[j]->own_addr, ETH_ALEN))
+				return 1;
+	}
+	return 0;
+}
