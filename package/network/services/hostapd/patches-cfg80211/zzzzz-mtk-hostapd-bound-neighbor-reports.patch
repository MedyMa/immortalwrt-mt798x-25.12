+	u8 *pos = (u8 *) nei_buf, *end = pos + buflen, *next;
+
+	while (pos < end) {
+		next = neighbor_report_next(pos, end);
+		if (!next)
+			return 0;
+		if (os_memcmp(pos + 2, own_addr, ETH_ALEN) &&
