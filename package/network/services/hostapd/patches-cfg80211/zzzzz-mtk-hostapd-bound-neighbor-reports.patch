+/* A Neighbor Report has a 13-byte fixed body and bounded subelement TLVs. */
+static u8 * neighbor_report_next(u8 *pos, u8 *end)
+{
+	if (end - pos < 2 || pos[0] != WLAN_EID_NEIGHBOR_REPORT ||
+	    pos[1] < 13 || pos[1] > end - pos - 2)
+		return NULL;
+	return pos + 2 + pos[1];
+}
+
+static void neighbor_report_set_pref(u8 *nr, u8 *end, u8 pref)
+{
+	u8 *pos = nr + 15;
+
+	while (end - pos >= 2) {
+		if (pos[1] > end - pos - 2)
+			return;
+		if (pos[0] == WNM_NEIGHBOR_BSS_TRANSITION_CANDIDATE && pos[1] == 1)
+			pos[2] = pref;
+		pos += 2 + pos[1];
+	}
+}
