+/* Scan results and association events must populate the same security state. */
+int wpas_cache_ap_security(struct wpa_supplicant *wpa_s,
+			   const struct wpa_ssid *ssid, const u8 *ies, size_t len)
+{
+	const u8 *wpa = NULL, *rsn = NULL, *rsnx = NULL;
+	const u8 *o1 = NULL, *o2 = NULL, *ox = NULL;
+
+	if (ies) {
+		wpa = get_vendor_ie(ies, len, WPA_IE_VENDOR_TYPE);
+		rsn = get_ie(ies, len, WLAN_EID_RSN);
+		rsnx = get_ie(ies, len, WLAN_EID_RSNX);
+		if (wpas_rsn_overriding(wpa_s, ssid)) {
+			if (!rsn) {
+				o1 = get_vendor_ie(ies, len, RSNE_OVERRIDE_IE_VENDOR_TYPE);
+				o2 = get_vendor_ie(ies, len, RSNE_OVERRIDE_2_IE_VENDOR_TYPE);
+			}
+			if (!rsnx)
+				ox = get_vendor_ie(ies, len, RSNXE_OVERRIDE_IE_VENDOR_TYPE);
+		}
+	}
+	if (wpa_sm_set_ap_wpa_ie(wpa_s->wpa, wpa, wpa ? 2 + wpa[1] : 0) ||
+	    wpa_sm_set_ap_rsn_ie(wpa_s->wpa, rsn, rsn ? 2 + rsn[1] : 0) ||
+	    wpa_sm_set_ap_rsnxe(wpa_s->wpa, rsnx, rsnx ? 2 + rsnx[1] : 0) ||
+	    wpa_sm_set_ap_rsne_override(wpa_s->wpa, o1, o1 ? 2 + o1[1] : 0) ||
+	    wpa_sm_set_ap_rsne_override_2(wpa_s->wpa, o2, o2 ? 2 + o2[1] : 0) ||
+	    wpa_sm_set_ap_rsnxe_override(wpa_s->wpa, ox, ox ? 2 + ox[1] : 0))
+		return -1;
+	return !!(wpa || rsn || o1 || o2);
+}
