-}
-
+	bool second;
+
+	wpa_sm_set_param(wpa_s->wpa, WPA_PARAM_RSN_OVERRIDE, RSN_OVERRIDE_NOT_USED);
+	if (!bss)
+		return 0;
+	ie = wpa_bss_get_rsne(wpa_s, ssid, bss);
+	if (!ie || ie[0] != WLAN_EID_VENDOR_SPECIFIC)
+		return 0;
+	if (len < 7)
+		return -1;
+
+	second = WPA_GET_BE32(ie + 2) == RSNE_OVERRIDE_2_IE_VENDOR_TYPE;
+	buf[0] = WLAN_EID_VENDOR_SPECIFIC;
+	buf[1] = 5;
+	WPA_PUT_BE32(buf + 2, RSN_SELECTION_IE_VENDOR_TYPE);
+	buf[6] = second ? RSN_SELECTION_RSNE_OVERRIDE_2 : RSN_SELECTION_RSNE_OVERRIDE;
+	wpa_sm_set_param(wpa_s->wpa, WPA_PARAM_RSN_OVERRIDE, second ?
+			 RSN_OVERRIDE_RSNE_OVERRIDE_2 : RSN_OVERRIDE_RSNE_OVERRIDE);
+	return 7;
+}
