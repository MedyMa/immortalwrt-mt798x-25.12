Subject: [PATCH] mtk-hostapd-12map-012-sae-akm24-hostapd-support (adapted to shared ucode stack)

--- a/hostapd/Makefile
+++ b/hostapd/Makefile
@@ -41,6 +41,7 @@
 #CFLAGS += -DCONFIG_MTK_MAP
 
 CFLAGS += -DCONFIG_MTK_MAP
