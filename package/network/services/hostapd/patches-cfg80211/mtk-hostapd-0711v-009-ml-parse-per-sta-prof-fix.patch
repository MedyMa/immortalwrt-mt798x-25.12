Subject: [PATCH] mtk-hostapd-0711v-009-ml-parse-per-sta-prof-fix (adapted to shared ucode stack)

--- a/src/ap/ap_config.h
+++ b/src/ap/ap_config.h
@@ -940,7 +940,6 @@
 #ifdef CONFIG_IEEE80211AX
 	u8 dot11vmbssid;
 #endif /* CONFIG_IEEE80211AX */
-	struct wpa_ml_ie_parse ml_ie_btm;
 };
 
 /**
--- a/src/ap/ctrl_iface_ap.c
+++ b/src/ap/ctrl_iface_ap.c
@@ -1230,7 +1230,7 @@
 
 	nei_len = ieee802_11_parse_candidate_list(cmd, nei_rep,
 						  sizeof(nei_rep));
-	nei_len = add_stapro_neighbor_rep(hapd, nei_rep, nei_len);
+	nei_len = add_stapro_neighbor_rep(hapd, nei_rep, nei_len, sta->wpa_sm);
 	wpa_hexdump(MSG_DEBUG, "nei_rep with per sta", nei_rep, nei_len);
 	if (nei_len < 0)
 		return -1;
--- a/src/ap/neighbor_db.c
+++ b/src/ap/neighbor_db.c
@@ -14,7 +14,7 @@
 #include "hostapd.h"
 #include "ieee802_11.h"
 #include "neighbor_db.h"
-
+#include "wpa_auth_i.h"
 
 struct hostapd_neighbor_entry *
 hostapd_neighbor_get(struct hostapd_data *hapd, const u8 *bssid,
@@ -387,16 +387,17 @@
 }
 
 int add_stapro_neighbor_rep(struct hostapd_data *hapd, u8 *nei_rep,
-		size_t nei_len)
+		size_t nei_len, struct wpa_state_machine *sm)
 {
 	int len = 0, shift_len = 0, temp_len = 0, sta_pro_len = 0, i = 0, j = 0, ap_nei = 0;
 	u8 *pos = nei_rep;
 	u8 *start_pro, *next_nei_rep;
 	size_t ml_link_num = hapd->ml_group->ml_link_num;
-	struct wpa_ml_ie_parse ml = hapd->conf->ml_ie_btm;
-
-	if (!hapd)
+	struct wpa_ml_ie_parse ml;
+
+	if (!hapd || !sm)
 		return nei_len;
+	memcpy(&ml, sm->sta_ml_ie, sizeof(struct wpa_ml_ie_parse));
 	ml_link_num = (int)(nei_len / 29);   //gives total neighbours present in nei_rep
 	if (ml_link_num <= 1)
 		return nei_len;
--- a/src/ap/neighbor_db.h
+++ b/src/ap/neighbor_db.h
@@ -23,7 +23,7 @@
 int hostapd_neighbor_remove(struct hostapd_data *hapd, const u8 *bssid,
 			    const struct wpa_ssid_value *ssid);
 void hostapd_free_neighbor_db(struct hostapd_data *hapd);
-int add_stapro_neighbor_rep(struct hostapd_data *hapd, u8 *nei_rep, size_t nei_len);
+int add_stapro_neighbor_rep(struct hostapd_data *hapd, u8 *nei_rep, size_t nei_len, struct wpa_state_machine *sm);
 int hostapd_neighbor_count(struct hostapd_data *hapd);
 int hostapd_neighbor_insert_buffer(struct hostapd_data *hapd, char *buf, size_t buflen);
 
