From 8ec79378a3191427566084e76e8ecbd624ae9689 Mon Sep 17 00:00:00 2001
From: Michael Pfeifroth <michael.pfeifroth@westermo.com>
Date: Thu, 25 Jun 2026 13:28:32 +0200
Subject: [PATCH 1/2] nl80211: bounds-check array_buf callbacks against buffer
 capacity

The nl80211 get_survey, get_assoclist and get_freqlist callbacks append
entries to a caller-provided IWINFO_BUFSIZE (24 KiB) stack buffer
without verifying that the buffer can still hold another entry. With
struct iwinfo_assoclist_entry at ~176 bytes the buffer overflows once
more than ~139 stations are associated, corrupting the caller's stack
and crashing libiwinfo consumers (luci, ubus, the iwinfo CLI).

Add an explicit max_count to struct nl80211_array_buf, set it from
IWINFO_BUFSIZE / sizeof(entry) in the three call sites and skip appends
once the limit is reached. The result is truncated instead of corrupted
output on very busy APs or unusually large wiphy dumps.

Signed-off-by: Michael Pfeifroth <michael.pfeifroth@westermo.com>

--- a/include/iwinfo.h
+++ b/include/iwinfo.h
@@ -21,6 +21,7 @@
 
 
 #define IWINFO_BUFSIZE	24 * 1024
+#define IWINFO_ASSOCLIST_BUFSIZE	96 * 1024
 #define IWINFO_ESSID_MAX_SIZE	32
 
 enum iwinfo_80211 {
--- a/iwinfo_cli.c
+++ b/iwinfo_cli.c
@@ -823,7 +823,7 @@
 static void print_assoclist(const struct iwinfo_ops *iw, const char *ifname)
 {
 	int i, len;
-	char buf[IWINFO_BUFSIZE];
+	char buf[IWINFO_ASSOCLIST_BUFSIZE];
 	int j;
 	char mld_mac[18];
 	struct iwinfo_assoclist_entry *e;
--- a/iwinfo_lua.c
+++ b/iwinfo_lua.c
@@ -346,7 +346,7 @@
 static int iwinfo_L_assoclist(lua_State *L, int (*func)(const char *, char *, int *))
 {
 	int i, len;
-	char rv[IWINFO_BUFSIZE];
+	char rv[IWINFO_ASSOCLIST_BUFSIZE];
 	char macstr[18];
 	const char *ifname = luaL_checkstring(L, 1);
 	struct iwinfo_assoclist_entry *e;
--- a/iwinfo_nl80211.c
+++ b/iwinfo_nl80211.c
@@ -2284,6 +2284,9 @@
 				attr[NL80211_ATTR_SURVEY_INFO],
 				survey_policy);
 	if (rc)
+		return NL_SKIP;
+
+	if (arr->count >= arr->max_count)
 		return NL_SKIP;
 
 	/* advance to end of array */
@@ -2411,6 +2414,9 @@
 		[NL80211_RATE_INFO_SHORT_GI]     = { .type = NLA_FLAG   },
 	};
 
+	if (arr->count >= arr->max_count)
+		return NL_SKIP;
+
 	/* advance to end of array */
 	e += arr->count;
 	memset(e, 0, sizeof(*e));
@@ -2533,7 +2539,11 @@
 
 static int nl80211_get_survey(const char *ifname, char *buf, int *len)
 {
-	struct nl80211_array_buf arr = { .buf = buf, .count = 0 };
+	struct nl80211_array_buf arr = {
+		.buf = buf,
+		.count = 0,
+		.max_count = IWINFO_BUFSIZE / sizeof(struct iwinfo_survey_entry),
+	};
 	int rc;
 
 	rc = nl80211_request(ifname, NL80211_CMD_GET_SURVEY,
@@ -2551,7 +2561,11 @@
 	DIR *d;
 	int i, noise = 0;
 	struct dirent *de;
-	struct nl80211_array_buf arr = { .buf = buf, .count = 0 };
+	struct nl80211_array_buf arr = {
+		.buf = buf,
+		.count = 0,
+		.max_count = IWINFO_ASSOCLIST_BUFSIZE / sizeof(struct iwinfo_assoclist_entry),
+	};
 	struct iwinfo_assoclist_entry *e;
 
 	if ((d = opendir("/sys/class/net")) != NULL)
@@ -3275,6 +3289,9 @@
 					if (!freqs[NL80211_FREQUENCY_ATTR_FREQ] ||
 					    freqs[NL80211_FREQUENCY_ATTR_DISABLED])
 						continue;
+
+					if (arr->count >= arr->max_count)
+						return NL_SKIP;
 
 					e->band = nl80211_get_band(band->nla_type);
 					e->mhz = nla_get_u32(freqs[NL80211_FREQUENCY_ATTR_FREQ]);
@@ -3320,7 +3337,11 @@
 static int nl80211_get_freqlist(const char *ifname, char *buf, int *len)
 {
 	struct nl80211_msg_conveyor *cv;
-	struct nl80211_array_buf arr = { .buf = buf, .count = 0 };
+	struct nl80211_array_buf arr = {
+		.buf = buf,
+		.count = 0,
+		.max_count = IWINFO_BUFSIZE / sizeof(struct iwinfo_freqlist_entry),
+	};
 	uint32_t features = nl80211_get_protocol_features(ifname);
 	int flags;
 
--- a/iwinfo_nl80211.h
+++ b/iwinfo_nl80211.h
@@ -67,6 +67,7 @@
 struct nl80211_array_buf {
 	void *buf;
 	int count;
+	int max_count;
 };
 
 #endif
