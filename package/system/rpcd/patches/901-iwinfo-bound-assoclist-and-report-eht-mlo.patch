From: MedyMa <75345465+MedyMa@users.noreply.github.com>
Subject: [PATCH] rpcd: bound association storage and report EHT/MLO safely

Match the backend association capacity with zeroed heap storage, validate
returned lengths, and close the backend on every exit. Report EHT DCM and
only populated MLO slots, without claiming slot indices as Link IDs or
unknown per-link MCS/NSS/GI. Legacy WEXT entries have no MLO metadata.

--- a/iwinfo.c
+++ b/iwinfo.c
@@ -494,10 +494,11 @@
 		blobmsg_add_u32(&buf, "he_gi", r->he_gi);
 		blobmsg_add_u32(&buf, "he_dcm", r->he_dcm);
 	}
-	else if (r->is_eht) {
+	else if (r->is_eht && r->nss) {
 		blobmsg_add_u32(&buf, "mcs", r->mcs);
 		blobmsg_add_u32(&buf, "nss", r->nss);
 		blobmsg_add_u32(&buf, "eht_gi", r->eht_gi);
+		blobmsg_add_u32(&buf, "eht_dcm", r->eht_dcm);
 	}
 }
 
@@ -506,9 +507,9 @@
                      struct ubus_request_data *req, const char *method,
                      struct blob_attr *msg)
 {
-	int i, rv, len;
+	int i, rv, len = 0;
 	char mac[18];
-	char res[IWINFO_BUFSIZE];
+	char *res;
 	struct iwinfo_assoclist_entry *a;
 	struct ether_addr *macaddr = NULL;
 	void *c = NULL, *d, *e;
@@ -522,6 +523,12 @@
 	if (rv)
 		return rv;
 
+	res = calloc(1, IWINFO_ASSOCLIST_BUFSIZE);
+	if (!res) {
+		rpc_iwinfo_close();
+		return UBUS_STATUS_UNKNOWN_ERROR;
+	}
+
 	if (tb[RPC_A_MACADDR])
 		macaddr = ether_aton(blobmsg_data(tb[RPC_A_MACADDR]));
 
@@ -530,7 +537,15 @@
 	if (!macaddr)
 		c = blobmsg_open_array(&buf, "results");
 
-	if (!iw->assoclist(ifname, res, &len) && (len > 0))
+	rv = iw->assoclist(ifname, res, &len);
+	if (!rv && (len < 0 || len > IWINFO_ASSOCLIST_BUFSIZE ||
+	            len % sizeof(*a))) {
+		free(res);
+		rpc_iwinfo_close();
+		return UBUS_STATUS_UNKNOWN_ERROR;
+	}
+
+	if (!rv && len > 0)
 	{
 		for (i = 0; i < len; i += sizeof(struct iwinfo_assoclist_entry))
 		{
@@ -581,6 +596,43 @@
 			rpc_iwinfo_add_rateinfo(&a->tx_rate);
 			blobmsg_close_table(&buf, e);
 
+			if (a->mlo_enable == 1 && a->mlo_num_links > 0 &&
+			    a->mlo_num_links <= 3) {
+				char mld_mac[18];
+				void *mlo;
+				int j;
+
+				blobmsg_add_u8(&buf, "mlo_enable", 1);
+				snprintf(mld_mac, sizeof(mld_mac),
+				         "%02X:%02X:%02X:%02X:%02X:%02X",
+				         a->mld_mac[0], a->mld_mac[1], a->mld_mac[2],
+				         a->mld_mac[3], a->mld_mac[4], a->mld_mac[5]);
+				blobmsg_add_string(&buf, "mld_mac", mld_mac);
+				if (a->mlo_link_id < 3)
+					blobmsg_add_u8(&buf, "mlo_link_index", a->mlo_link_id);
+				blobmsg_add_u8(&buf, "mlo_num_links", a->mlo_num_links);
+
+				mlo = blobmsg_open_array(&buf, "mlo_links");
+				for (j = 0; j < 3; j++) {
+					void *link, *rate;
+
+					if (!a->mlo_rx_rate[j].is_eht &&
+					    !a->mlo_tx_rate[j].is_eht)
+						continue;
+
+					link = blobmsg_open_table(&buf, NULL);
+					blobmsg_add_u8(&buf, "link_index", j);
+					rate = blobmsg_open_table(&buf, "rx");
+					rpc_iwinfo_add_rateinfo(&a->mlo_rx_rate[j]);
+					blobmsg_close_table(&buf, rate);
+					rate = blobmsg_open_table(&buf, "tx");
+					rpc_iwinfo_add_rateinfo(&a->mlo_tx_rate[j]);
+					blobmsg_close_table(&buf, rate);
+					blobmsg_close_table(&buf, link);
+				}
+				blobmsg_close_array(&buf, mlo);
+			}
+
 			found = true;
 			if (!macaddr)
 				blobmsg_close_table(&buf, d);
@@ -589,14 +641,15 @@
 		}
 	}
 
+	free(res);
+	rpc_iwinfo_close();
+
 	if (!macaddr)
 		blobmsg_close_array(&buf, c);
 	else if (!found)
 		return UBUS_STATUS_NOT_FOUND;
 
 	ubus_send_reply(ctx, req, buf.head);
-
-	rpc_iwinfo_close();
 
 	return UBUS_STATUS_OK;
 }
